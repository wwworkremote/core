#!/bin/bash -x

sudo systemctl stop sidekiq.service 2> /dev/null
sudo systemctl disable sidekiq.service 2> /dev/null

sudo cp -f /home/deploy/projects/wwworkremote/core/current/config/deploy/services/sidekiq.service /etc/systemd/system/sidekiq.service

cd /etc/systemd/system
sudo systemctl enable sidekiq.service
sudo systemctl daemon-reload
sudo systemctl start sidekiq.service
sudo systemctl status sidekiq.service
