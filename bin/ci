#!/usr/bin/env bash
# frozen_string_literal: true
set -euo pipefail

# bin/ci: Local CI runner via act (GitHub Actions)

if ! command -v act >/dev/null 2>&1; then
  echo "Error: 'act' is not installed."
  echo "Install it via homebrew: brew install act"
  exit 1
fi

# Ensure DOCKER_HOST is set for act
if [[ -z "${DOCKER_HOST:-}" ]]; then
  # Try to get host from current docker context
  CURRENT_HOST=$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)
  if [[ -n "$CURRENT_HOST" ]]; then
    export DOCKER_HOST="$CURRENT_HOST"
  else
    # colima-status is the source of truth for the real socket path --
    # colima ignores XDG paths and ~/.colima is canonical (Z-195/Z-181,
    # 2026-07-04), so a hardcoded ~/.config/colima guess silently misses it.
    if command -v colima-status >/dev/null 2>&1; then
      COLIMA_SOCKET=$(colima-status socket 2>/dev/null || true)
    fi
    ORBSTACK_SOCKET="$HOME/.orbstack/run/docker.sock"

    if [[ -n "${COLIMA_SOCKET:-}" && -S "$COLIMA_SOCKET" ]]; then
      export DOCKER_HOST="unix://$COLIMA_SOCKET"
    elif [[ -S "$ORBSTACK_SOCKET" ]]; then
      export DOCKER_HOST="unix://$ORBSTACK_SOCKET"
    fi
  fi
fi

if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker is not running or accessible (DOCKER_HOST=${DOCKER_HOST:-default})."
  exit 1
fi

# Extract the path from DOCKER_HOST (removing unix:// prefix)
DOCKER_SOCKET_PATH="${DOCKER_HOST#unix://}"

echo "--- Running Local CI via act ---"
echo "Sequence: Lint -> Security -> Test -> Boot"

# If we are in a terminal, use pretty output
ACT_OPTS=()
if [ -t 1 ]; then
  ACT_OPTS+=("--log-prefix=false")
fi

# We use --container-architecture to match standard CI environments
# and ensure we don't spin up redundant containers if possible.
act --container-architecture linux/amd64 \
    --container-daemon-socket "/var/run/docker.sock" \
    "${ACT_OPTS[@]}" \
    "$@"

