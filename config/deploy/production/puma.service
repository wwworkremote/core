[Unit]
Description=Puma for WWWorkRemote Core (Production)
After=network.target

[Service]
Type=notify
WatchdogSec=10

WorkingDirectory=/home/deploy/projects/wwworkremote/core/current

# Environment=PUMA_DEBUG=1

ExecStart=/bin/bash -c 'PATH=/home/deploy/.asdf/shims:$PATH exec /home/deploy/projects/wwworkremote/core/current/sbin/puma -C /home/deploy/projects/wwworkremote/core/current/config/environments/production/puma.rb'

ExecReload=/bin/kill -TSTP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

User=deploy
Group=deploy
UMask=0002

Environment=MALLOC_ARENA_MAX=2

RestartSec=1
Restart=on-failure

StandardOutput=journal
StandardError=journal

SyslogIdentifier=puma

[Install]
WantedBy=multi-user.target
