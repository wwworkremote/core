#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

JobPosting
  .where.not(tags: nil)
  .find_each(order: :asc, batch_size: 100) do |jp|
    jp.tags.each do |name|
      clean_name = name.downcase.gsub(/[[:space:]]/i, ' ').strip
      begin
        Tag.find_or_create_by(name: clean_name)
      rescue StandardError => e
        Sentry.capture_exception(e)
        nil
      end
    end
  end
