#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

TERMS = Rails.application.config_for(:search)[:terms].freeze
# TERMS = %w[ruby].freeze 

[
  Runners::AuthenticJobs,
  Runners::HackerNews,
  Runners::Indeed,
  Runners::Monster,
  Runners::Nexxt,
  Runners::RemoteOK,
  Runners::RemotePython,
  Runners::Remotive,
  Runners::StackOverflow,
  Runners::WeWorkRemotely
].each do |runner|
  # TERMS.each { |term| runner.async(term: term) }
  TERMS.each { |term| runner.run(term: term) }
rescue StandardError => e
  Sentry.capture_exception(e)
  puts [e.class, e.message, e.backtrace.take(10)].inspect
end
