#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

Rails.logger = Rails.logger.child(entrypoint: __FILE__)

JobPosting
  .where.not(target_url: nil)
  .pluck(:target_url)
  .map { |url| URI.parse(url).host rescue nil }
  .compact_blank
  .each { |name| Domain.find_or_create_by(name: name) rescue nil }
