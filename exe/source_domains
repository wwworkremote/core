Source
  .where(created_at: 4.hours.ago..)
  .where("payload->>'url' is not null")
  .select("id, payload->>'url' as url")
  .find_each(order: :asc, batch_size: 100) { |source|
    next if source.url.blank?

    extractor = DomainExtractor.new(source.url).call

    next if extractor.empty?

    root_name = extractor.root_domain
    root_domain = Domain.find_or_create_by(name: root_name)
    root_domain.update_attribute(:root_domain_id, root_domain.id)

    extractor.domains.each do |name|
      domain = Domain.find_or_create_by(name: name)
      domain.update_attribute(:root_domain_id, root_domain.id)
    end
  }
