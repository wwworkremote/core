# frozen_string_literal: true

notification = Notifications::RequestFaraday.last
payload = notification.payload.deep_symbolize_keys


def extract(payload)
  case payload
    in response_body: { rss: { channel: { item: [*items] } } }
    items.map do |item|
      case item
        in {
          guid: { __content__: String => guid },
          pubDate: String => pub_date,
          link: String => link,
          title: String => title,
          description: String => description
        }

        { 
          external_id: guid, 
          published_at: DateTime.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), 
          target_url: link, 
          title: title, 
          body: description.strip 
        }
      else
      end
    end
  end
end

feed = extract(payload)

