require 'set'

docs = JobPosting
       .pluck(:body)
       .take(1_000)
       .filter_map { |jp| jp.present? && jp }

# .filter_map { |jp| jp.present? && Normalize.new(jp).call }

module App
  def self.dump_words(docs)
    words = Set.new
    docs.each do |d|
      d.result.split(/[[:space:]]+/).each do |w|
        words << w.strip.tr(',', '').tr(';', '').tr('"', '')
      end
    end
    words.compact_blank.sort.each { |w| puts w }
  end
end

docs.each do |d|
  ap CLD.detect_language(d)
end
