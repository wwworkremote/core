#!/usr/bin/env /Users/mike/projects/outlier_jobs/rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

puts "#{__FILE__}: #{Process.pid}"

transaction = Sentry.start_transaction(name: 'Messages to Tags', op: 'messages.tags')

begin
  Sentry.capture_message(__FILE__)

  Message.where('created_at >= ?', 1.year.ago).find_each(batch_size: 100) do |message|
    next if message.tags.blank?

    message.tags.map do |name|
      tag = Tag.find_or_create_by(name: name)
      tag.tag_aliases.create(name: name)
    rescue ActiveRecord::RecordNotUnique, PG::UniqueViolation => e
      Rails.logger.debug { [e.message, name].inspect }
    end
  end
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
