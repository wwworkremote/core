#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

begin
  Rails.logger.info { "START exe/tags pid:#{Process.pid}" }

  JobPosting.where('created_at >= ?', 3.hours.ago).find_each(batch_size: 100) do |job_posting|
    next if job_posting.tags.blank?

    job_posting.tags.map do |name|
      tag = Tag.find_or_create_by(name: name)
      tag.tag_aliases.create(name: name)
    rescue ActiveRecord::RecordNotUnique, PG::UniqueViolation => e
      Rails.logger.debug { [e.message, name].inspect }
    end
  end
rescue StandardError => e
  Rails.logger.error { "ERROR exe/tags pid:#{Process.pid} -- #{e.class}: #{e.message}" }
ensure
  Rails.logger.info { "END exe/tags pid:#{Process.pid}" }
end
