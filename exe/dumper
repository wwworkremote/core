require 'set'

File.open('/Users/mike/projects/outlier_jobs/core/lib/corpus.json', 'w') do |f|
  job_postings = JobPosting.where(created_at: (Time.now.beginning_of_month..Time.now.end_of_month)).order(id: :desc).limit(10000).pluck(:title, :body)

  corpus = { names: [], descriptions: [] }
  job_postings.each_with_object(corpus) { |jp, c| 
    c[:names] << jp.first.to_s.strip.gsub(/\s\+/, ' ')
    c[:descriptions] << jp.last.to_s.strip.gsub(/\s\+/, ' ')
  }
  f.print corpus.to_json

  # # uniqued and sorted
