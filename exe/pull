#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'shellwords'

term = Shellwords.escape(ARGV.first || 'programming')

# Rails.logger = Rails.logger.child( term: term, entrypoint: __FILE__)

[
  Runners::HackerNews::Async,
  Runners::Indeed::Async,
  Runners::Monster::Async,
  Runners::Nexxt::Async,
  Runners::RemoteOK::Async,
  Runners::RemotePython::Async,
  Runners::StackOverflow::Async,
  Runners::WeWorkRemotely::Async
].each do |runner|
  runner.perform_async(term)
rescue StandardError
end
