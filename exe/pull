#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'shellwords'

term = Shellwords.escape(ARGV.first || 'programming')

TERMS = %w[apache as400 bash clojure cobol csharp docker dotnet flask golang java javascript json jvm kafka kotlin kubernetes linux macos nginx node nodejs ops postgresql python rails react redis resque rspec ruby rust sidekiq spark sql swift typescript zsh].freeze

[
  Runners::HackerNews::Async,
  Runners::Indeed::Async,
  Runners::Monster::Async,
  Runners::Nexxt::Async,
  Runners::RemoteOK::Async,
  Runners::RemotePython::Async,
  Runners::StackOverflow::Async,
  Runners::WeWorkRemotely::Async
].each do |runner|
  runner.perform_async(term)

  TERMS.each do |t|
    runner.perform_async(t)
  end
rescue StandardError => e
  Sentry.capture_exception(e)
end
