#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

begin
  require 'shellwords'

  term = Shellwords.escape(ARGV.first || 'programming')

  Rails.logger.info { "START exe/nexxt #{term} pid:#{Process.pid}" }

  Pullers::Nexxt.jobs(term: term)
rescue StandardError => e
  Rails.logger.error { "ERROR exe/nexxt #{term} pid:#{Process.pid} -- #{e.class}: #{e.message}" }
ensure
  Rails.logger.info { "END exe/nexxt #{term} pid:#{Process.pid}" }
end
