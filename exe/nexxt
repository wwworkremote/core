#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

begin
  Rails.logger.info { "START exe/nexxt pid:#{Process.pid}" }
  Nexxt.jobs
rescue StandardError => e
  Rails.logger.error { "ERROR exe/nexxt pid:#{Process.pid} -- #{e.class}: #{e.message}" }
ensure
  Rails.logger.info { "END exe/nexxt pid:#{Process.pid}" }
end
