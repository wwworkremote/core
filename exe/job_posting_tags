# Rails.logger = Rails.logger.child(entrypoint: __FILE__)

JobPosting
  .where.not(tags: nil)
  .find_each(order: :asc, batch_size: 100) do |jp|
    jp.tags.each do |name|
      Tag.create(name: name) rescue nil
    end
  end
