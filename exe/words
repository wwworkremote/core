#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'sanitize'
require 'rubypants'

module Words
  def self.normalize(text)
    ActionController::Base \
      .helpers
      .strip_tags(Sanitize.fragment(RubyPants.new(text.downcase.strip, stupefy: true).to_html))
      .gsub(/&lt;/, '<')
      .gsub(/&gt;/, '>')
      .gsub(/&amp;/, '&')
      .gsub(/[[:space:]]+/, ' ')
      .strip
      .downcase
  end

  def self.filtrate(text)
    str = normalize(text)

    list = str.split(/[[:space:]]+/).map(&:strip).map do |word|
      word.gsub(/\W+$/, '')
    end

    list.map!(&:strip)
    list.sort!
    list.reject!(&:blank?)
    list.reject! { |word| word =~ /^\d+$/i }
    list.reject! { |word| word.length <= 2 }

    # Stopwords::Snowball::Filter.new('en').filter(list)
    Stopwords::Snowball::WordSieve.new.filter(lang: :en, words: list)
  end

  def self.dump(list)
    list \
      .each_with_object(Hash.new(0)) { |e, h| h[e] += 1; }
      .deep_sort
  end
end

require 'csv'
JobPosting.pluck(:body).filter(&:present?).each { |jp| puts [Words.normalize(jp)].to_csv }
