module Words
  # STOPWORDS = File.open('/Users/mike/GitHub/Stopwords/src/common/stopwords_10000_most_frequent_filtered.txt').readlines(chomp: true).map(&:downcase).sort.uniq.freeze
  def self.dehtml(input)
    ActionController::Base \
      .helpers
      .strip_tags(Sanitize.fragment(RubyPants.new(input.downcase.strip, stupefy: true).to_html))
      .tr('’', "'")
      .gsub(/[^[:word:]\s]/i, ' ')
      .gsub(/[[:space:]]+/, ' ')
      .strip
  end

  def self.filtrate(input)
    str = dehtml(input)

    list = str.split(/[[:space:]]+/).map(&:strip).map do |word|
      word.gsub(/\W+$/, '')
    end

    list.map!(&:strip)
    list.sort!
    list.reject!(&:blank?)
    list.reject! { |word| word =~ /^\d+$/i }
    list.reject! { |word| word.length <= 2 }

    Stopwords::Snowball::Filter.new('en').filter(list)
  end

  def self.dump(list)
    list.each_with_object(Hash.new(0)) { |e, h| h[e] += 1; }.deep_sort
  end
end

text = Message.find(244_888).body
list = Words.filtrate(text)
words = Words.dump(list)
ap words

