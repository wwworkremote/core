#!/usr/bin/env /Users/mike/projects/outlier_jobs/rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

term = ARGV.first

puts "#{__FILE__} #{term}: #{Process.pid}"
transaction = Sentry.start_transaction(op: :"#{__FILE__} #{term}")

begin
  Sentry.capture_message("#{__FILE__} #{term}".strip)
  Monster.jobs(term: term)
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
