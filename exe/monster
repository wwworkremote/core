#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'shellwords'

term = Shellwords.escape(ARGV.first || 'programming')

Rails.logger.info { "exe/monster '#{term}' pid:#{Process.pid}" }

transaction = Sentry.start_transaction(name: 'Ingest Jobs', op: __FILE__.tr('/', '.'))

begin
  Sentry.capture_message("#{__FILE__} #{term}".strip)
  Monster.jobs(term: term)
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
