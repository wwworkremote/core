#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

Rails.logger.info { "exe/moment pid:#{Process.pid}" }

transaction = Sentry.start_transaction(name: 'Moment', op: __FILE__.tr('/', '.')) # , data: { cmd: __FILE__, term: ARGV.first })

begin
  Sentry.capture_message(__FILE__)
  Moment.snapshot!
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
