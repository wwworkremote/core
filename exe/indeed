#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'shellwords'

term = Shellwords.escape(ARGV.first || 'programming')

TERMS = Rails.application.config_for(:search)[:terms].freeze

Runners::Indeed::Async.perform_async(term)

TERMS.each do |t|
  Runners::Indeed::Async.perform_async(t)
end
