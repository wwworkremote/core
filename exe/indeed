puts "#{__FILE__}: #{Process.pid}"

transaction = Sentry.start_transaction(name: 'Ingest Jobs', op: __FILE__.tr('/', '.')) # , data: { cmd: __FILE__, term: ARGV.first })

begin
  Sentry.capture_message(__FILE__)
  Indeed.jobs
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
