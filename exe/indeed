puts "#{__FILE__}: #{Process.pid}"
transaction = Sentry.start_transaction(op: :"#{__FILE__}")

begin
  Sentry.capture_message(__FILE__)
  Indeed.jobs
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
