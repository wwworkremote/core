#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

begin
  require 'shellwords'

  term = Shellwords.escape(ARGV.first || 'programming')

  Rails.logger.info { "START exe/indeed #{term} pid:#{Process.pid}" }

  Pullers::Indeed.jobs(term: term)
rescue StandardError => e
  # Rails.logger.error { "ERROR exe/indeed #{term} pid:#{Process.pid} -- #{e.class}: #{e.message}" }
  # Rails.logger.error { "DEBUG exe/indeed #{term} pid:#{Process.pid} -- #{e.backtrace.join("\n")}" }

  Rails.logger.error { [self.class, __method__, e.class, e.message, e.backtrace.take(10)].inspect }
ensure
  Rails.logger.info { "END exe/indeed #{term} pid:#{Process.pid}" }
end
