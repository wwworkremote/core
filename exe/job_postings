#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'tty-progressbar'
require 'tty-spinner'
require 'pastel'

begin
  Rails.logger.info { "START exe/job_postings pid:#{Process.pid}" }
  spinner = TTY::Spinner.new('[:spinner] Counting sources ...', format: :classic).tap(&:auto_spin)
  total = Source.where(status: 0).count
  spinner.stop("#{total} sources found")
  bar = TTY::ProgressBar.new('sources => messages [:bar]', total: total)
  Source.where(status: 0).find_each(order: :asc, batch_size: 100) do |notification|
    bar.advance
    payload = notification.payload
    response_body = payload['response_body']

    next if response_body.blank? || response_body.is_a?(Array)

    response_body = begin
      response_body.deep_symbolize_keys
    rescue NoMethodError => e
      Rails.logger.error { "ERROR:NO_METHOD exe/job_postings pid:#{Process.pid} -- #{e.class}: #{e.message}" }

      next
    end

    case response_body
    in response_body: String | Array
      nil
    in by: String => by, id: Integer => id, score: Integer, text: String => text, time: Integer => time, title: String => title, type: String => type if type == 'job'
      notification.job_postings.create(body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, title: title.strip)
    in by: String => by, id: Integer => id, score: Integer, time: Integer => time, title: String => title, type: String => type, url: String => url if type == 'job'
      notification.job_postings.create(external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip)
    in by: String => by, id: Integer => id, score: Integer, text: String => text, time: Integer => time, title: String => title, type: String => type, url: String => url if type == 'job'
      notification.job_postings.create(body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip)
    in rss: { channel: { item: Hash => item } }
      case item
      in link: String, title: String => title if title.include?('No job postings found')
        nil
      in { guid: { __content__: String => guid }, link: String => link, title: String => title, pubDate: String => pub_date, description: String => description }
        notification.job_postings.create(body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link.strip, title: title.strip)
      in { guid: String => guid, link: String => link, title: String => title, pubDate: String => pub_date, description: String => description }
        notification.job_postings.create(body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link.strip, title: title.strip)
      else
        Rails.logger.warn { [:PAYLOAD_ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)].inspect }
      end
    in rss: { channel: { item: [*items] } }
      items.each do |item|
        case item
        in link: String, title: String => title if title.include?('No job postings found')
          nil
        in company: String => company, description: String => description, guid: String => guid, image: String, link: String => link, location: String => location, pubDate: String => pub_date, tags: String => tags, title: String => title
          notification.job_postings.create(body: description.strip, company: company, external_id: guid.to_s.strip, location: location.strip, published_at: DateTime.parse(pub_date).to_time, tags: tags.split(',').map(&:strip), target_url: link.strip, title: title.strip)
        in company: String => company, description: String => description, guid: String => guid, image: String, link: String => link, location:, pubDate: String => pub_date, tags: String => tags, title: String => title
          notification.job_postings.create(body: description.strip, company: company, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, tags: tags.split(',').map(&:strip), target_url: link.strip, title: title.strip)
        in description: String => description, guid: { __content__: String => guid }, link: String => link, pubDate: String => pub_date, title: String => title
          notification.job_postings.create(body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link.strip, title: title.strip)
        in description: String => description, guid: String => guid, link: String => link, pubDate: String => pub_date, title: String => title
          notification.job_postings.create(body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link.strip, title: title.strip)
        else
          Rails.logger.warn { [:ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)] }
        end
      end
    else
      Rails.logger.warn { [:PAYLOAD_MISMATCH, payload.class, payload.keys, payload['response_body'].transform_values(&:class), payload['response_body']].inspect }
    end
  end
rescue NoMethodError => e
  Sentry.capture_exception(e)
  Rails.logger.error { "ERROR:NO_METHOD exe/job_postings pid:#{Process.pid} -- #{e.class}: #{e.message}" }
rescue NoMatchingPatternError => e
  Sentry.capture_exception(e)
  Rails.logger.warn { "ERROR:NO_MATCHING_PATTERN exe/job_postings pid:#{Process.pid} -- #{e.class}: #{e.message}" }
rescue StandardError => e
  Rails.logger.error { "ERROR:STANDARD exe/job_postings pid:#{Process.pid} -- #{e.class}: #{e.message}" }
ensure
  Rails.logger.info { "END exe/job_postings pid:#{Process.pid}" }
end
