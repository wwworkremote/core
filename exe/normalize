#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

docs = JobPosting
       .pluck(:body)
       .take(100)
       .filter_map { |jp| jp.present? && Normalize.new(jp).call }

require 'sorted_set'
characters = SortedSet.new

docs.each do |d|
  puts d

  extras = d.to_s.gsub(/\w+/, '').chars

  extras.compact_blank.sort.each do |c|
    warn [c, c.ord.to_s, c.ord.to_s(16)].inspect
  end

  extras.each do |c|
    characters << c.strip
  end
end

characters.compact_blank.each do |c|
  warn [c, c.ord.to_s, c.ord.to_s(16)].inspect
end
