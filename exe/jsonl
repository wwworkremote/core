#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

require 'iconv'
require 'json'
require 'pathname'
require 'sorted_set'

class Foobar
  attr_reader :data

  def initialize
    @data = SortedSet.new
  end

  def insert_one(params = {})
    data.add(params)
  end
end

COLLECTION = Foobar.new

module App
  def self.normalize(line)
    line = line.to_s
    Iconv.conv('ASCII//IGNORE', 'UTF8', line)
    line.gsub(/[[:space:]]+/, ' ').strip
  end

  def self.jsonl_items(response_body)
    return [] if response_body.is_a?(String)
    return [] if response_body.is_a?(Array)

    rss = response_body.dig(:rss, :channel, :item)
    return [] unless rss.is_a?(Array)

    return SortedSet.new(rss).to_a if rss

    [response_body]
  end
end

# DB = Sequel.postgres('wwworkremote_development', host: 'localhost', max_connections: 10)
DB = Sequel.connect('postgres://wwworkremote:window.snow@node108/wwworkremote_production')

STEP = 50

# payloads = DB[:sources].order(:id).select(:payload)
# get minmax to setup range

lbound = 0
ubound = 2000

(lbound..ubound).each_slice(STEP).map(&:minmax).map { |rng| puts rng.inspect; Range.new(*rng) }.reverse.each do |range|
  puts
  puts "---- range=#{range} ----"
  puts
  range.each do |offset|
    puts
    offset = offset * STEP
    puts "-------- offset=#{offset} ---------"
    puts

    payloads = DB[:sources]
      .order(:id)
      .select(:payload)
      .limit(STEP)
      .offset(offset)
      .map { |row| row[:payload] }

    next if payloads.empty?
    print 'D'

    payloads.each do |line|
      puts
      print '['
      JSON.parse(App.normalize(line), symbolize_names: true).compact_blank.tap do |json|
        next unless json[:status] == 200
        print '#'
        next if json[:"job-count"].present? && json[:"job-count"]&.zero?
        print '#'
        next if json[:response_body].blank?
        print '#'
        next unless json[:response_body].is_a?(Hash)
        print '#'

        response_body = json[:response_body]
        print '*'

        begin
          response_body.each do |k, _|
            response_body[k].deep_symbolize_keys! if response_body[k].is_a?(Hash)
            response_body[k].compact_blank! if response_body[k].is_a?(Hash)
            response_body.delete(k) if response_body[k].is_a?(Hash) && response_body[k].empty?
            response_body[k].deep_sort! if response_body[k].is_a?(Hash)
          end
        rescue StandardError => e
          ap e
        end

        App.jsonl_items(response_body).compact_blank.each do |raw_job_posting|
          next if raw_job_posting.blank?
          print ':'

          COLLECTION.insert_one(
            raw_job_posting.merge(_wwwr: { sig: Digest::SHA2.hexdigest(raw_job_posting.to_json) })
          ) rescue nil
        end
        print ';'
      end
      print ','
    end
    puts ']'
  end
  puts
end
