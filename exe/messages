#!/usr/bin/env /Users/mike/projects/outlier_jobs/rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

puts "App PID: #{Process.pid}"

query = begin
  Notifications::RequestFaraday.where('created_at >= ?', 30.days.ago)
rescue SignalException => e
  puts "Received Signal during query #{e}"
  exit
end

feed = query.find_each.flat_map do |notification|
  payload = notification.payload
  response_body = payload['response_body']

  next if response_body.blank? || response_body.is_a?(Array)

  response_body = response_body.deep_symbolize_keys

  case response_body
  in response_body: String | Array
    nil

  in by: String => by,
      id: Integer => id,
      score: Integer,
      text: String => text,
      time: Integer => time,
      title: String => title,
      type: String => type if type == 'job'

    { notification_id: notification.id, body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, title: title.strip }

  in by: String => by,
      id: Integer => id,
      score: Integer,
      time: Integer => time,
      title: String => title,
      type: String => type,
      url: String => url if type == 'job'

    { notification_id: notification.id, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip }

  in by: String => by,
      id: Integer => id,
      score: Integer,
      text: String => text,
      time: Integer => time,
      title: String => title,
      type: String => type,
      url: String => url if type == 'job'

    { notification_id: notification.id, body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip }

  in rss: { channel: { item: Hash => item } }
    case item
    in link: String, title: String => title if title.include?('No job postings found')
      nil

    in { guid: { __content__: String => guid }, link: String => link, title: String => title, pubDate: String => pub_date, description: String => description }
      { notification_id: notification.id, body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link, title: title.strip }
    else
      ap [:PAYLOAD_ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)]
    end

  in rss: { channel: { item: [*items] } }
    begin
      items.flat_map do |item|
        case item

        in link: String, title: String => title if title.include?('No job postings found')

          nil

        in company: String => company,
            description: String => description,
            guid: String => guid,
            image: String,
            link: String => link,
            location: String => location,
            pubDate: String => pub_date,
            tags: String => tags,
            title: String => title

          { notification_id: notification.id, body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link, title: title.strip, location: location, company: company, tags: tags.split(',').map(&:strip) }

        in company: String => company,
            description: String => description,
            guid: String => guid,
            image: String,
            link: String => link,
            location:,
            pubDate: String => pub_date,
            tags: String => tags,
            title: String => title

          { notification_id: notification.id, body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link, title: title.strip, company: company, tags: tags.split(',').map(&:strip) }

        in description: String => description,
            guid: { __content__: String => guid },
            link: String => link,
            pubDate: String => pub_date,
            title: String => title

          { notification_id: notification.id, body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link, title: title.strip }

        in description: String => description,
            guid: String => guid,
            link: String => link,
            pubDate: String => pub_date,
            title: String => title

          { notification_id: notification.id, body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link, title: title }
        else
          ap [:ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)]
        end
      end
    rescue SignalException => e
      puts "Received Signal during items #{e}"
      exit
    end
  else
    ap [:PAYLOAD_MISMATCH, payload.class, payload.keys, payload['response_body'].transform_values(&:class)]
  end
rescue SignalException => e
  puts "Received Signal during payload #{e}"
  exit
end

puts feed.count(&:present?)
