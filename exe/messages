#!/usr/bin/env /Users/mike/projects/outlier_jobs/rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

puts "#{__FILE__}: #{Process.pid}"

transaction = Sentry.start_transaction(name: 'Sources to Messages', op: 'sources.messages')

begin
  Sentry.capture_message(__FILE__)

  Source.where(status: 0).where('create_at >= ?', 1.day.ago).find_each(order: :asc, batch_size: 100) do |notification|
    payload = notification.payload
    response_body = payload['response_body']

    next if response_body.blank? || response_body.is_a?(Array)

    response_body = response_body.deep_symbolize_keys

    case response_body
    in response_body: String | Array
      nil

    in by: String => by, id: Integer => id, score: Integer, text: String => text, time: Integer => time, title: String => title, type: String => type if type == 'job'

      notification.messages.create(data: {
        body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, title: title.strip
      }.deep_sort)

    in by: String => by, id: Integer => id, score: Integer, time: Integer => time, title: String => title, type: String => type, url: String => url if type == 'job'

      notification.messages.create(data: {
        external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip
      }.deep_sort)

    in by: String => by, id: Integer => id, score: Integer, text: String => text, time: Integer => time, title: String => title, type: String => type, url: String => url if type == 'job'

      notification.messages.create(data: {
        body: text.strip, external_author_id: by, external_id: id.to_s.strip, published_at: Time.at(time, in: 'UTC').utc, target_url: url, title: title.strip
      }.deep_sort)

    in rss: { channel: { item: Hash => item } }

      case item
      in link: String, title: String => title if title.include?('No job postings found')

        nil

      in { guid: { __content__: String => guid }, link: String => link, title: String => title, pubDate: String => pub_date, description: String => description }

        notification.messages.create(data: {
          body: description.strip, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, target_url: link.strip, title: title.strip
        }.deep_sort)

      else
        Rails.logger.warn { [:PAYLOAD_ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)].inspect }
      end

    in rss: { channel: { item: [*items] } }
      # transaction.with_child_span(name: :"exe/messages.items", description: 'Process items from nested array') do |span|
      Sentry.get_current_scope.get_span do |span|
        items.each do |item|
          case item
          in link: String, title: String => title if title.include?('No job postings found')

            nil

          in company: String => company, description: String => description, guid: String => guid, image: String, link: String => link, location: String => location, pubDate: String => pub_date, tags: String => tags, title: String => title

            notification.messages.create(data: {
              body: description.strip, company: company, external_id: guid.to_s.strip, location: location.strip, published_at: DateTime.parse(pub_date).to_time, tags: tags.split(',').map(&:strip), target_url: link.strip, title: title.strip
            }.deep_sort)

          in company: String => company, description: String => description, guid: String => guid, image: String, link: String => link, location:, pubDate: String => pub_date, tags: String => tags, title: String => title

            notification.messages.create(data: {
              body: description.strip, company: company, external_id: guid.to_s.strip, published_at: DateTime.parse(pub_date).to_time, tags: tags.split(',').map(&:strip), target_url: link.strip, title: title.strip
            }.deep_sort)

          in description: String => description, guid: { __content__: String => guid }, link: String => link, pubDate: String => pub_date, title: String => title

            notification.messages.create(data: {
              body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link.strip, title: title.strip
            }.deep_sort)

          in description: String => description, guid: String => guid, link: String => link, pubDate: String => pub_date, title: String => title

            notification.messages.create(data: {
              body: description.strip, external_id: guid.to_s.strip, published_at: Time.strptime(pub_date, '%a, %d %b %Y %H:%M:%S %Z'), target_url: link.strip, title: title.strip
            }.deep_sort)

          else
            Rails.logger.warn { [:ITEM_MISMATCH, item.class, item.keys, item.transform_values(&:class)] }
          end
        end
      rescue StandardError => e
        Sentry.capture_exception(e)
      ensure
        span.finish
      end

    else
      Rails.logger.warn { [:PAYLOAD_MISMATCH, payload.class, payload.keys, payload['response_body'].transform_values(&:class)].inspect }
    end
  end
rescue StandardError => e
  Sentry.capture_exception(e)
ensure
  transaction.finish
end
