#!/usr/bin/env rails runner
# vim:ft=ruby ts=2 sw=2 sts=2 et fenc=utf-8
# frozen_string_literal: true

begin
  Rails.logger.info { "START exe/hackernews pid:#{Process.pid}" }
  Pullers::HackerNews.jobs

  ActiveRecord::Base.connection.execute(<<~SQL.squish)
    update sources
    set status = 1
    where
      status = 0
      and payload->>'url' = 'https://hacker-news.firebaseio.com/v0/jobstories.json'
  SQL
rescue StandardError => e
  # Rails.logger.error { "ERROR exe/hackernews pid:#{Process.pid} -- #{e.class}: #{e.message}" }
  # Rails.logger.error { "DEBUG exe/hackernews #{term} pid:#{Process.pid} -- #{e.backtrace.join("\n")}" }

  Rails.logger.error { [self.class, __method__, e.class, e.message, e.backtrace.take(10)].inspect }
ensure
  Rails.logger.info { "END exe/hackernews pid:#{Process.pid}" }
end
