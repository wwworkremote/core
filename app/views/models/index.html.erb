<% content_for :title, "Models" %>

<div class="row mb-5 align-items-center">
  <div class="col">
    <h1 class="display-4 fw-bold sparkle-ai">Neural Models</h1>
    <p class="text-muted lead">The registry of supported LLM architecture.</p>
  </div>
  <div class="col-auto">
    <div class="btn-group shadow-lg">
      <%= link_to "LlmChats", llm_chats_path, class: "btn btn-outline-primary px-4" %>
      <%= button_to "Refresh Registry", refresh_models_path, method: :post, class: "btn btn-primary px-4" %>
    </div>
  </div>
</div>

<div id="models" class="card glass border-0 shadow-lg overflow-hidden">
  <div class="card-body p-0">
    <% if @models.any? %>
      <div class="table-responsive">
        <table class="table table-hover border-0 mb-0">
          <thead class="bg-white bg-opacity-5">
            <tr>
              <th class="px-4 py-3 text-muted small text-uppercase">Provider</th>
              <th class="px-4 py-3 text-muted small text-uppercase">Architecture</th>
              <th class="px-4 py-3 text-muted small text-uppercase">Context Window</th>
              <th class="px-4 py-3 text-muted small text-uppercase">Tokenization $/1M</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="border-top-0">
            <% @models.each do |model_info| %>
              <%= render "models/model",
                model: model_info %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <p class="lead text-muted mb-0">No neural models detected in the registry.</p>
      </div>
    <% end %>
  </div>
</div>
