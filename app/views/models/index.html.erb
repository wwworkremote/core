<% content_for :title, "Models" %>

<div class="row mb-4 align-items-center">
  <div class="col">
    <h1 class="display-4">Models</h1>
  </div>
  <div class="col-auto">
    <div class="btn-group">
      <%= link_to "LlmChats", llm_chats_path, class: "btn btn-outline-secondary" %>
      <%= button_to "Refresh Models", refresh_models_path, method: :post, class: "btn btn-primary" %>
    </div>
  </div>
</div>

<div id="models" class="table-responsive">
  <% if @models.any? %>
    <table class="table table-hover border">
      <thead class="table-light">
        <tr>
          <th>Provider</th>
          <th>Model</th>
          <th>Context Window</th>
          <th>$/1M tokens (In/Out)</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @models.each do |model_info| %>
          <%= render "models/model",
            model: model_info %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center my-5 py-5 border rounded bg-light">
      <p class="lead mb-0">No chat models found.</p>
    </div>
  <% end %>
</div>
