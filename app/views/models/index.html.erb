<% content_for :title, "AI Models" %>

<div class="flex justify-between items-center mb-12">
  <div>
    <h1 class="text-4xl font-black tracking-tight">AI Models</h1>
    <p class="text-sm font-bold opacity-60 mt-1">Every AI model available to this app</p>
  </div>

  <div class="flex gap-2">
    <%= link_to llm_chats_path, class: "btn btn-ghost btn-sm rounded-xl gap-2 font-bold" do %>
      <%= heroicon "chat-bubble-left-right", variant: :solid, options: { class: "w-3 h-3" } %>
      AI Chats
    <% end %>
    <%= button_to refresh_models_path, method: :post, class: "btn btn-primary btn-sm rounded-xl gap-2 font-bold shadow-lg shadow-primary/20" do %>
      <%= heroicon "arrow-path", variant: :solid, options: { class: "w-3 h-3" } %>
      Refresh
    <% end %>
  </div>
</div>

<div id="models" class="card bg-base-200 border border-white/5 shadow-2xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-zebra table-md w-full border-collapse">
      <thead>
        <tr class="bg-base-300/50 border-b border-white/5">
          <th class="px-6 py-4 text-xs font-bold opacity-60">Provider</th>
          <th class="px-6 py-4 text-xs font-bold opacity-60">Model</th>
          <th class="px-6 py-4 text-xs font-bold opacity-60">Context Window</th>
          <th class="px-6 py-4 text-xs font-bold opacity-60">Price per 1M Tokens</th>
          <th class="px-6 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% if @models.any? %>
          <% @models.each do |model_info| %>
            <%= render "models/model", model: model_info %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="py-24 text-center">
              <%= heroicon "cpu-chip", variant: :solid, options: { class: "w-12 h-12 text-base-300 mx-auto mb-4 opacity-40" } %>
              <p class="text-sm font-bold opacity-60">No models found.</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
