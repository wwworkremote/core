<% model_id = model.respond_to?(:model_id) ? model.model_id : model.id %>
<% row_id = [model.provider, model_id].join("_").parameterize(separator: "_") %>
<tr id="model_<%= row_id %>" class="border-bottom border-white border-opacity-5">
  <td class="align-middle px-4 py-3"><span class="text-white opacity-75"><%= model.provider_class&.name || model.provider %></span></td>
  <td class="align-middle px-4 py-3 text-primary fw-bold"><strong><%= model.respond_to?(:display_name) ? model.display_name : model.name %></strong></td>
  <td class="align-middle px-4 py-3"><span class="text-white"><%= number_with_delimiter(model.context_window) if model.context_window %></span></td>
  <td class="align-middle px-4 py-3">
    <% input = model.input_price_per_million %>
    <% output = model.output_price_per_million %>
    <% if input && output %>
      <span class="text-white opacity-50">$<%= "%.2f" % input %></span> <span class="mx-1">/</span> <span class="text-white opacity-50">$<%= "%.2f" % output %></span>
    <% end %>
  </td>
  <td class="text-end align-middle px-4 py-3">
    <%= link_to "Initiate", new_llm_chat_path(model: model_id), class: "btn btn-sm btn-primary rounded-pill px-3" %>
  </td>
</tr>
