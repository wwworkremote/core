<% content_for :title, "Model: #{@model.name}" %>

<div class="container-fluid">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <h1 class="display-5">Model Details</h1>
    </div>
    <div class="col-auto">
      <%= link_to "Back to all models", models_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="row mb-3">
            <div class="col-sm-3 text-muted">Provider</div>
            <div class="col-sm-9"><strong><%= @model.provider_class&.name || @model.provider %></strong></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3 text-muted">Model Name</div>
            <div class="col-sm-9"><strong><%= @model.name %></strong></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3 text-muted">Model ID</div>
            <div class="col-sm-9"><code><%= @model.model_id %></code></div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3 text-muted">Context Window</div>
            <div class="col-sm-9"><%= number_with_delimiter(@model.context_window) if @model.context_window %> tokens</div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-3 text-muted">Max Output</div>
            <div class="col-sm-9"><%= number_with_delimiter(@model.max_output_tokens) if @model.max_output_tokens %> tokens</div>
          </div>

          <% if @model.capabilities.any? %>
            <div class="row">
              <div class="col-sm-3 text-muted">Capabilities</div>
              <div class="col-sm-9">
                <% @model.capabilities.each do |capability| %>
                  <span class="badge bg-light text-dark border me-1"><%= capability %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="card-footer bg-light p-3">
          <%= link_to "Start chat with this model", new_llm_chat_path(model: @model.model_id), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
