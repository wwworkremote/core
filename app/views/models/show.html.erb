<% content_for :title, @model.name %>

<div class="max-w-4xl mx-auto space-y-8">
  <header class="flex justify-between items-center bg-base-200 p-6 rounded-2xl border border-white/5 shadow-xl">
    <div>
      <h1 class="text-2xl font-black tracking-tight"><%= @model.name %></h1>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-xs font-bold opacity-70"><%= @model.model_id %></span>
      </div>
    </div>

    <div class="flex gap-2">
      <%= link_to models_path, class: "btn btn-ghost btn-sm rounded-xl gap-2 font-bold" do %>
        <%= heroicon "chevron-left", variant: :solid, options: { class: "w-3 h-3" } %>
        Back
      <% end %>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2 space-y-6">
      <div class="card bg-base-200 border border-white/5 shadow-xl">
        <div class="card-body p-8">
          <h3 class="text-xs font-bold text-primary mb-8">Details</h3>

          <div class="space-y-6">
            <div class="flex justify-between items-center border-b border-white/5 pb-4">
              <span class="text-xs font-bold opacity-60">Provider</span>
              <span class="text-sm font-bold"><%= @model.provider_class&.name || @model.provider %></span>
            </div>

            <div class="flex justify-between items-center border-b border-white/5 pb-4">
              <span class="text-xs font-bold opacity-60">Name</span>
              <span class="text-sm font-bold text-primary"><%= @model.name %></span>
            </div>

            <div class="flex justify-between items-center border-b border-white/5 pb-4">
              <span class="text-xs font-bold opacity-60">Context Window</span>
              <div class="flex items-center gap-2">
                <span class="text-sm font-mono text-white"><%= number_with_delimiter(@model.context_window) if @model.context_window %></span>
                <span class="text-xs font-bold opacity-40">tokens</span>
              </div>
            </div>

            <div class="flex justify-between items-center border-b border-white/5 pb-4">
              <span class="text-xs font-bold opacity-60">Max Output</span>
              <div class="flex items-center gap-2">
                <span class="text-sm font-mono text-white"><%= number_with_delimiter(@model.max_output_tokens) if @model.max_output_tokens %></span>
                <span class="text-xs font-bold opacity-40">tokens</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @model.capabilities.any? %>
        <div class="card bg-base-200 border border-white/5 shadow-xl">
          <div class="card-body p-8">
            <h3 class="text-xs font-bold text-secondary mb-6">Capabilities</h3>
            <div class="flex flex-wrap gap-2">
              <% @model.capabilities.each do |capability| %>
                <div class="badge badge-outline border-white/10 text-xs font-bold py-3 px-4 rounded-lg">
                  <%= capability %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="card bg-primary text-primary-content shadow-2xl shadow-primary/20">
        <div class="card-body p-8 text-center">
          <%= heroicon "bolt", variant: :solid, options: { class: "w-12 h-12 mx-auto mb-4 opacity-60" } %>
          <h3 class="text-lg font-black leading-tight mb-2">Start a Chat</h3>
          <p class="text-xs font-bold opacity-80 mb-8 leading-relaxed">Start a new chat using this model.</p>
          <%= link_to new_llm_chat_path(model: @model.model_id), class: "btn btn-black btn-block rounded-xl font-bold shadow-2xl" do %>
            Start Chat
          <% end %>
        </div>
      </div>

      <div class="card bg-base-300 border border-white/5 shadow-xl">
        <div class="card-body p-6">
          <div class="flex items-center gap-3 mb-4">
             <div class="bg-base-200 p-2 rounded-lg border border-white/5">
               <%= heroicon "shield-check", variant: :solid, options: { class: "w-4 h-4 text-success opacity-60" } %>
             </div>
             <span class="text-xs font-bold opacity-70 text-success">Available</span>
          </div>
          <p class="text-xs font-bold opacity-50 leading-relaxed">
            This model is currently available for chat.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
