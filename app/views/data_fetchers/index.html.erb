<%= render "admin/shared/nav" %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">Pipeline Orchestration</h1>
    <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Data Ingestion & Fetcher Registry</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <% DataAcquisitionManager::FETCHERS.group_by { |_, c| c[:type] }.each do |type, fetchers| %>
    <div class="card-neural p-6">
      <div class="flex justify-between items-center mb-6 border-b border-white/5 pb-4">
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-primary"><%= type %> Pipelines</h3>
        <%= button_to "Run All #{type}", run_all_by_type_data_fetchers_path, params: { type: type }, class: "btn-admin bg-primary/20 hover:bg-primary/40 text-primary border-none" %>
      </div>

      <div class="space-y-3">
        <% fetchers.each do |slug, config| %>
          <% status = DataAcquisitionManager.status(slug) %>
          <div class="bg-base-300 p-4 rounded-lg flex items-center justify-between group">
            <div>
              <div class="font-bold text-white text-xs"><%= config[:name] %></div>
              <div class="text-[9px] text-slate-500 font-mono">Last: <%= status[:last_fetched_at]&.strftime("%b %d, %H:%M") || "NEVER" %></div>
            </div>
          <div class="bg-base-300 p-4 rounded-lg flex items-center justify-between group">
            <div>
              <div class="font-bold text-white text-xs"><%= config[:name] %></div>
              <div class="text-[9px] text-slate-500 font-mono">Last: <%= status[:last_fetched_at]&.strftime("%b %d, %H:%M") || "NEVER" %></div>
            </div>
            <div class="flex items-center gap-2">
              <% if status[:can_fetch] %>
                <%= button_to "Run", run_data_fetchers_path, params: { slug: slug }, class: "btn-admin bg-white/5 hover:bg-white/10" %>
              <% else %>
                <button class="btn-admin bg-base-200 text-slate-600 cursor-not-allowed" disabled>
                  <%= (status[:time_until_reset] / 60).round %>m
                </button>
              <% end %>
              <%= button_to "Force", run_data_fetchers_path, params: { slug: slug, force: true }, class: "btn-admin bg-rose-900/20 text-rose-500 hover:bg-rose-900/40 border-none" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
