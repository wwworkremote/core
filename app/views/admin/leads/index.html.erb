<%= render "admin/shared/nav" %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1">Leads</h1>
    <p class="text-slate-500 font-bold text-sm">Jobs captured by the browser extension, before/after promotion to a Job Posting.</p>
  </div>
</div>

<div class="card-neural mb-6">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead class="bg-white/5 border-b border-white/10 text-xs font-bold text-slate-500">
        <tr>
          <th class="px-6 py-4">Title / Company</th>
          <th class="px-6 py-4">Board</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Found At</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5 font-mono text-xs">
        <% @leads.each do |lead| %>
          <tr class="group hover:bg-white/[0.03] transition-colors">
            <td class="px-6 py-4">
              <div class="text-white font-bold mb-0.5"><%= lead.title.presence || "(untitled)" %></div>
              <div class="text-slate-500 text-xs truncate max-w-xs"><%= lead.company_name %></div>
            </td>
            <td class="px-6 py-4 text-slate-400"><%= lead.provider&.humanize %></td>
            <td class="px-6 py-4"><%= render "admin/leads/status_badge", lead: lead %></td>
            <td class="px-6 py-4 text-slate-400">
              <%= lead.found_at&.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2 text-xs">
                <%= link_to admin_lead_path(lead), class: "px-3 py-1 rounded font-bold border border-white/10 hover:bg-white/10 hover:text-white transition-all text-slate-400" do %>
                  Details
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-8">
  <%= paginate @leads %>
</div>
