<%= render "admin/shared/nav" %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1">Extraction Rules</h1>
    <p class="text-slate-500 font-bold text-sm">Field selectors taught via the extension's element picker, per job board.</p>
  </div>
</div>

<div class="card-neural mb-6">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead class="bg-white/5 border-b border-white/10 text-xs font-bold text-slate-500">
        <tr>
          <th class="px-6 py-4">Provider</th>
          <th class="px-6 py-4">Field</th>
          <th class="px-6 py-4">Selector</th>
          <th class="px-6 py-4">Updated At</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5 font-mono text-xs">
        <% @extraction_rules.each do |rule| %>
          <tr class="group hover:bg-white/[0.03] transition-colors">
            <td class="px-6 py-4 text-white font-bold"><%= rule.provider %></td>
            <td class="px-6 py-4 text-slate-400"><%= rule.field_name %></td>
            <td class="px-6 py-4 text-slate-400 truncate max-w-xs"><%= rule.selector %></td>
            <td class="px-6 py-4 text-slate-400">
              <%= rule.updated_at&.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2 text-xs">
                <%= link_to admin_extraction_rule_path(rule), class: "px-3 py-1 rounded font-bold border border-white/10 hover:bg-white/10 hover:text-white transition-all text-slate-400" do %>
                  Details
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-8">
  <%= paginate @extraction_rules %>
</div>
