<%= render "admin/shared/nav" %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">Email Ingestion Logs</h1>
    <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Processing Pipeline Registry</p>
  </div>
</div>

<div class="card-neural mb-6">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead class="bg-white/5 border-b border-white/10 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
        <tr>
          <th class="px-6 py-4">Source / File</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Processed At</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5 font-mono text-[11px]">
        <% @records.each do |record| %>
          <tr class="group hover:bg-white/[0.03] transition-colors">
            <td class="px-6 py-4">
              <div class="text-white font-bold mb-0.5"><%= record.source %></div>
              <div class="text-slate-500 text-[9px] truncate max-w-xs"><%= record.file_path %></div>
            </td>
            <td class="px-6 py-4">
              <% if record.status == 'processed' %>
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] font-black">PROCESSED</span>
              <% elsif record.status == 'failed' %>
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[9px] font-black">FAILED</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[9px] font-black"><%= record.status.upcase %></span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-slate-400">
              <%= record.processed_at&.strftime("%Y-%m-%d %H:%M") || "N/A" %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2 text-[10px]">
                <%= link_to admin_email_import_record_path(record), class: "px-3 py-1 rounded font-black border border-white/10 hover:bg-white/10 hover:text-white transition-all text-slate-400" do %>
                  DETAILS
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-8">
  <%= paginate @records %>
</div>
