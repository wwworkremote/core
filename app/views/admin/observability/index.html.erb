<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">Observability_Center</h1>
    <p class="text-base-content/40 font-bold uppercase tracking-widest text-[10px]">Golden Signals & Behavioral Intelligence Registry</p>
  </div>
</div>

<!-- Golden Signals: System Health -->
<section class="mb-16">
  <div class="flex items-center gap-4 mb-8 opacity-20">
    <h2 class="text-[10px] font-black uppercase tracking-[0.4em]">Grid_Performance_Telemetry</h2>
    <div class="h-px flex-1 bg-white/20"></div>
  </div>

  <div class="stats stats-vertical lg:stats-horizontal w-full bg-base-200 shadow-2xl border border-white/5 mb-8">
    <div class="stat">
      <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">LATENCY_AVG</div>
      <div class="stat-value text-primary text-3xl font-black"><%= @latency_avg %>s</div>
      <div class="stat-desc font-bold text-[9px] uppercase tracking-tighter opacity-30 mt-1">Sync_To_Enrich</div>
    </div>
    
    <div class="stat">
      <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">TRAFFIC_DAILY</div>
      <div class="stat-value text-secondary text-3xl font-black"><%= @traffic_daily %></div>
      <div class="stat-desc font-bold text-[9px] uppercase tracking-tighter opacity-30 mt-1">Signals_Ingested</div>
    </div>
    
    <div class="stat">
      <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">ERROR_RATE</div>
      <div class="stat-value text-error text-3xl font-black"><%= @error_rate %>%</div>
      <div class="stat-desc font-bold text-[9px] uppercase tracking-tighter opacity-30 mt-1 text-error/50">Failed_Executions</div>
    </div>

    <div class="stat border-none!">
      <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">SATURATION</div>
      <div class="stat-value text-accent text-3xl font-black"><%= @saturation %>%</div>
      <div class="stat-desc font-bold text-[9px] uppercase tracking-tighter opacity-30 mt-1">Worker_Utilization</div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="card bg-base-200 border border-white/5 shadow-xl">
      <div class="card-body p-8">
        <h3 class="card-title text-[10px] font-black uppercase tracking-widest opacity-40 mb-6 flex justify-between items-center">
          <span>Signal_Flow_Velocity</span>
          <span class="text-[8px] badge badge-outline border-white/10 opacity-30">7D_WINDOW</span>
        </h3>
        <%= line_chart charts_data_pipeline_health_path,
            height: "220px",
            colors: ["#9580FF"],
            library: { 
              scales: { 
                y: { grid: { color: "rgba(255,255,255,0.03)" }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } },
                x: { grid: { display: false }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } }
              },
              plugins: { legend: { display: false } }
            } %>
      </div>
    </div>

    <div class="card bg-base-200 border border-white/5 shadow-xl">
      <div class="card-body p-8">
        <h3 class="card-title text-[10px] font-black uppercase tracking-widest opacity-40 mb-6">Pipeline_Funnel_Conversion</h3>
        <%= bar_chart charts_data_pipeline_funnel_path,
            height: "220px",
            colors: ["#80FFEA"],
            library: { 
              scales: { 
                x: { grid: { color: "rgba(255,255,255,0.03)" }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } },
                y: { grid: { display: false }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } }
              },
              plugins: { legend: { display: false } }
            } %>
      </div>
    </div>
  </div>
</section>

<!-- Behavioral Intelligence -->
<section>
  <div class="flex items-center gap-4 mb-8 opacity-20">
    <h2 class="text-[10px] font-black uppercase tracking-[0.4em]">User_Behavioral_Analytics</h2>
    <div class="h-px flex-1 bg-white/20"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="card bg-base-200 border border-white/5 shadow-xl col-span-2">
      <div class="card-body p-8">
        <h3 class="card-title text-[10px] font-black uppercase tracking-widest opacity-40 mb-6 flex justify-between items-center">
          <span>Interaction_Volume_Scan</span>
          <span class="text-[8px] badge badge-primary font-black px-2">LIVE_SESSIONS: <%= @total_visits %></span>
        </h3>
        <%= area_chart charts_data_behavior_visits_path,
            height: "250px",
            colors: ["#8AFF80"],
            library: { 
              scales: { 
                y: { grid: { color: "rgba(255,255,255,0.03)" }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } },
                x: { grid: { display: false }, ticks: { color: "#6272a4", font: { size: 9, weight: 'bold' } } }
              },
              plugins: { legend: { display: false } }
            } %>
      </div>
    </div>

    <div class="space-y-8">
      <div class="card bg-base-200 border border-white/5 shadow-xl">
        <div class="card-body p-6">
          <h3 class="text-[9px] font-black uppercase tracking-widest text-slate-500 mb-6 pb-2 border-b border-white/5 flex items-center gap-2">
            <%= heroicon "globe-alt", options: { class: "w-3 h-3" } %> Top_Entry_Origins
          </h3>
          <ul class="space-y-4">
            <% @top_referrers.each do |ref, count| %>
              <li class="flex items-center justify-between group">
                <span class="text-[10px] font-bold text-slate-400 group-hover:text-primary transition-colors truncate max-w-[150px]">
                  <%= ref.present? ? ref.gsub(%r{https?://}, '') : 'Direct_Node' %>
                </span>
                <span class="text-[10px] font-black text-slate-600 font-mono"><%= count %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="card bg-base-200 border border-white/5 shadow-xl">
        <div class="card-body p-6">
          <h3 class="text-[9px] font-black uppercase tracking-widest text-slate-500 mb-6 pb-2 border-b border-white/5 flex items-center gap-2">
            <%= heroicon "magnifying-glass", options: { class: "w-3 h-3" } %> Neural_Search_Vectors
          </h3>
          <ul class="space-y-4">
            <% @top_job_searches.each do |query, count| %>
              <li class="flex items-center justify-between group">
                <span class="text-[10px] font-bold text-slate-400 group-hover:text-secondary transition-colors italic">"<%= query %>"</span>
                <span class="text-[10px] font-black text-slate-600 font-mono"><%= count %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
