<%= render "admin/shared/nav" %>

<div class="max-w-4xl mx-auto py-10 px-6">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to "Skills", admin_skills_path, class: "hover:text-primary transition-all" %>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
      <span class="text-white"><%= skill.new_record? ? "New Skill" : "Edit Skill" %></span>
    </div>
  </div>

  <div class="mb-12">
    <h1 class="text-4xl font-black text-white tracking-tight leading-none mb-3">
      <%= skill.new_record? ? "New Skill" : "Edit Skill" %>
    </h1>
    <p class="text-slate-500 font-bold text-sm">Define this skill for AI matching.</p>
  </div>

  <div class="card-neural p-8">
    <%= form_with(model: [:admin, skill], class: "space-y-8") do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="form-control">
          <%= f.label :name, "Name", class: "label text-xs font-bold text-slate-500" %>
          <%= f.text_field :name, placeholder: "e.g., Ruby on Rails", class: "input input-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
        </div>

        <div class="form-control">
          <%= f.label :category, "Category", class: "label text-xs font-bold text-slate-500" %>
          <%= f.text_field :category, placeholder: "e.g., Framework", class: "input input-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
        </div>
      </div>

      <div class="form-control">
        <%= f.label :description, "Description", class: "label text-xs font-bold text-slate-500" %>
        <%= f.text_area :description, rows: 6, class: "textarea textarea-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white text-sm leading-relaxed", placeholder: "Explain what this skill covers…" %>
        <label class="label">
          <span class="label-text-alt text-xs text-slate-500">Used to generate the AI embedding for matching.</span>
        </label>
      </div>

      <div class="pt-6 border-t border-white/5 flex justify-end gap-4">
        <%= link_to "Cancel", admin_skills_path, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold" %>
        <%= f.submit (skill.new_record? ? "Create Skill" : "Update Skill"), class: "btn btn-primary rounded-xl px-10 font-bold" %>
      </div>
    <% end %>
  </div>
</div>
