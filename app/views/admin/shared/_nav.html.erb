<% active_controller = ->(name) { controller_name == name } %>
<% nav_link_class = ->(name) { active_controller.call(name) ? "text-blue-400" : "text-slate-500 hover:text-white transition-colors" } %>
<% nav_link_current = ->(name) { active_controller.call(name) ? "page" : nil } %>

<nav aria-label="Admin" class="mb-10 space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/5 pb-4">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2">
      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Core</span>
        <%= link_to "Dashboard", admin_root_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('dashboard')}", "aria-current": nav_link_current.call('dashboard') %>
        <%= link_to "Observability", admin_observability_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('observability')}", "aria-current": nav_link_current.call('observability') %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Inventory</span>
        <%= link_to "Postings", admin_job_postings_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('job_postings')}", "aria-current": nav_link_current.call('job_postings') %>
        <%= link_to "Docs", admin_documents_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('documents')}", "aria-current": nav_link_current.call('documents') %>
        <%= link_to "Domains", admin_domains_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('domains')}", "aria-current": nav_link_current.call('domains') %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Engine</span>
        <%= link_to "Sources", admin_sources_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('sources')}", "aria-current": nav_link_current.call('sources') %>
        <%= link_to "Leads", admin_leads_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('leads')}", "aria-current": nav_link_current.call('leads') %>
        <%= link_to "Rules", admin_extraction_rules_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('extraction_rules')}", "aria-current": nav_link_current.call('extraction_rules') %>
        <%= link_to "Workflow", admin_extension_workflow_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('extension_workflow')}", "aria-current": nav_link_current.call('extension_workflow') %>
        <%= link_to "Jobs", admin_jobs_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('jobs')}", "aria-current": nav_link_current.call('jobs') %>
        <%= link_to "Registry", admin_models_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('models')}", "aria-current": nav_link_current.call('models') %>
        <%= link_to "Prompts", admin_pipeline_prompts_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('pipeline_prompts')}", "aria-current": nav_link_current.call('pipeline_prompts') %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Intel</span>
        <%= link_to "Visits", admin_visits_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('visits')}", "aria-current": nav_link_current.call('visits') %>
        <%= link_to "Events", admin_events_path, class: "text-xs font-bold uppercase tracking-widest #{nav_link_class.call('events')}", "aria-current": nav_link_current.call('events') %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="dropdown dropdown-hover">
        <div tabindex="0" role="button" aria-haspopup="menu" class="text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-white transition-colors flex items-center gap-1">
          Mounts <%= heroicon "chevron-down", variant: :outline, options: { class: "w-2 h-2" } %>
        </div>
        <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-0 border border-white/5">
          <li><%= link_to 'PgHero', '/mounts/pghero' %></li>
          <li><%= link_to 'Mission Control', '/mounts/jobs' %></li>
          <li><%= link_to 'Ahoy Analytics', '/mounts/analytics' %></li>
        </ul>
      </div>
    </div>

    <div>
      <%= link_to root_path, class: "group flex items-center gap-2 px-3 py-1 rounded bg-white/5 border border-white/10 hover:bg-white/10 transition-all" do %>
        <%= heroicon "arrow-left", variant: :outline, options: { class: "w-4 h-4 text-slate-500 group-hover:text-white transition-colors" } %>
        <span class="text-[9px] font-black uppercase tracking-widest text-slate-500 group-hover:text-white">Exit Admin</span>
      <% end %>
    </div>
  </div>
</nav>
