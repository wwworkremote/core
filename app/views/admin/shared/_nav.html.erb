<div class="mb-10 space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/5 pb-4">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2">
      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Core</span>
        <%= link_to "Dashboard", admin_root_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'dashboard' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Observability", admin_observability_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'observability' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Inventory</span>
        <%= link_to "Postings", admin_job_postings_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'job_postings' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Docs", admin_documents_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'documents' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Domains", admin_domains_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'domains' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Engine</span>
        <%= link_to "Sources", admin_sources_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'sources' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Leads", admin_leads_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'leads' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Jobs", admin_jobs_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'jobs' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Registry", admin_models_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'models' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Prompts", admin_pipeline_prompts_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'pipeline_prompts' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="flex items-center gap-4">
        <span class="text-[9px] font-black uppercase tracking-[0.3em] text-slate-600">Intel</span>
        <%= link_to "Visits", admin_visits_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'visits' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
        <%= link_to "Events", admin_events_path, class: "text-xs font-bold uppercase tracking-widest #{controller_name == 'events' ? 'text-blue-400' : 'text-slate-500 hover:text-white transition-colors'}" %>
      </div>

      <div class="w-px h-3 bg-white/10 hidden md:block"></div>

      <div class="dropdown dropdown-hover">
        <div tabindex="0" role="button" class="text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-white transition-colors flex items-center gap-1">
          Mounts <i class="bi bi-chevron-down text-[8px]"></i>
        </div>
        <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-0 border border-white/5">
          <li><%= link_to 'PgHero', '/mounts/pghero' %></li>
          <li><%= link_to 'Mission Control', '/mounts/jobs' %></li>
          <li><%= link_to 'Ahoy Analytics', '/mounts/analytics' %></li>
        </ul>
      </div>
    </div>

    <div>
      <%= link_to root_path, class: "group flex items-center gap-2 px-3 py-1 rounded bg-white/5 border border-white/10 hover:bg-white/10 transition-all" do %>
        <i class="bi bi-arrow-left text-slate-500 group-hover:text-white transition-colors"></i>
        <span class="text-[9px] font-black uppercase tracking-widest text-slate-500 group-hover:text-white">Exit Admin</span>
      <% end %>
    </div>
  </div>
</div>
