<%= render "admin/shared/nav" %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-4xl font-black tracking-tight sparkle-ai mb-3">System Administration</h1>
    <p class="text-slate-400 text-lg">Direct control over the core database records.</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
  <div class="card-neural p-8 text-center">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-blue-300 to-blue-600 mb-2">
      <%= number_with_delimiter(@job_postings_count) %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Total Job Postings</div>
    <div class="mt-4">
      <%= link_to "Manage Postings", admin_job_postings_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-emerald-300 to-emerald-600 mb-2">
      <%= number_with_delimiter(@documents_count) %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Source Documents</div>
    <div class="mt-4">
      <%= link_to "Review Documents", admin_documents_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center border border-primary/20 shadow-[0_0_30px_rgba(149,128,255,0.05)]">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-primary to-blue-500 mb-2">
      <i class="bi bi-graph-up-arrow"></i>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Pipeline Health</div>
    <div class="mt-4">
      <%= link_to "Intelligence", admin_analytics_path, class: "btn-neural w-full block text-center !bg-primary/10 !text-primary !border-primary/20" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-amber-300 to-amber-600 mb-2">
      <%= number_with_delimiter(SolidQueue::Job.count) %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Pipeline Queue</div>
    <div class="mt-4">
      <%= link_to "Monitor Jobs", admin_jobs_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-rose-300 to-rose-600 mb-2">
      <%= @models_count %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">LLM Models</div>
    <div class="mt-4">
      <%= link_to "Model Registry", admin_models_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-slate-300 to-slate-600 mb-2">
      <%= @sources_count %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Active Sources</div>
    <div class="mt-4">
      <%= link_to "Ingestion Sources", admin_sources_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center border-t border-white/5 pt-8">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-cyan-300 to-cyan-600 mb-2">
      <%= @visits_count %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">User Visits</div>
    <div class="mt-4">
      <%= link_to "Session Intelligence", admin_visits_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>

  <div class="card-neural p-8 text-center border-t border-white/5 pt-8">
    <div class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-b from-indigo-300 to-indigo-600 mb-2">
      <%= @events_count %>
    </div>
    <div class="text-xs font-bold text-slate-500 uppercase tracking-widest">Granular Events</div>
    <div class="mt-4">
      <%= link_to "Activity Registry", admin_events_path, class: "btn-neural w-full block text-center" %>
    </div>
  </div>
</div>

<div class="card-neural p-8">
  <h2 class="text-xl font-bold text-white mb-4">Administration Guide</h2>
  <div class="prose-invert">
    <p>Welcome to the native Rails administration dashboard. This system replaces external dependencies to provide full control over styling, routing, and data presentation.</p>
    <ul>
      <li><strong>No Magic:</strong> Everything you see here is a standard Rails Controller and View.</li>
      <li><strong>Consistent Styling:</strong> It seamlessly inherits the Dracula Pro "Command Center" theme.</li>
      <li><strong>Performant:</strong> Data is queried efficiently using standard Active Record syntax.</li>
    </ul>
  </div>
</div>
