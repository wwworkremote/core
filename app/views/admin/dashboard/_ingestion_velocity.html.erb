<div class="card-neural p-8 h-full">
  <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/5">
    <h3 class="text-xs font-bold text-base-content/50">Ingestion Rate</h3>
    <div class="text-xs font-bold text-slate-500">Jobs / Hour</div>
  </div>
  <div class="h-48">
    <%= area_chart charts_data_job_postings_path,
        height: "100%",
        colors: ["#7E9CD8"],
        library: {
          plugins: { legend: { display: false } },
          scales: {
            y: { grid: { color: "rgba(255,255,255,0.05)" }, border: { display: false }, ticks: { color: "#C8C093", font: { size: 10 } } },
            x: { grid: { display: false }, border: { display: false }, ticks: { color: "#C8C093", font: { size: 10 } } }
          }
        } %>
  </div>
</div>
