<div id="<%= dom_id(job_posting) %>" class="flex flex-col gap-2 p-3 bg-white/5 rounded-lg border border-white/5 animate-in fade-in slide-in-from-right duration-500">
  <div class="flex items-center justify-between">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="px-1.5 py-0.5 rounded bg-blue-900/30 text-blue-400 text-[8px] font-black uppercase tracking-tighter">INGESTED</span>
        <span class="text-[9px] font-bold text-slate-500 uppercase">
          <%= job_posting.source&.origin&.name || job_posting.source&.name || "EXTERNAL" %>
        </span>
      </div>
      <div class="text-xs font-bold text-white truncate"><%= job_posting.title %></div>
      <div class="text-[10px] text-slate-400 truncate"><%= job_posting.company_name %></div>
    </div>
    <div class="text-[8px] font-mono text-slate-600 whitespace-nowrap ml-4">
      <%= Time.current.strftime("%H:%M:%S") %>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 pt-1 border-t border-white/[0.03]">
    <% if job_posting.data['is_remote'] %>
      <span class="px-1.5 py-0.5 rounded bg-emerald-900/20 text-emerald-500 text-[8px] font-black uppercase tracking-tighter border border-emerald-900/30">
        ACTUALLY REMOTE
      </span>
    <% end %>

    <% if job_posting.data['salary_min'] || job_posting.data['salary_max'] %>
      <span class="px-1.5 py-0.5 rounded bg-amber-900/20 text-amber-500 text-[8px] font-black uppercase tracking-tighter border border-amber-900/30">
        PAY: <%= number_to_currency(job_posting.data['salary_min'], precision: 0) %> - <%= number_to_currency(job_posting.data['salary_max'], precision: 0) %>
      </span>
    <% end %>

    <% if job_posting.data['remote_nuance'].present? %>
       <span class="text-[8px] text-slate-500 font-bold uppercase truncate max-w-[150px]"><%= job_posting.data['remote_nuance'] %></span>
    <% end %>
  </div>
</div>
