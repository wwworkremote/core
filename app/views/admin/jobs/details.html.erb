<%= turbo_frame_tag "job_details_#{@job.id}" do %>
<div class="p-6 bg-slate-900 text-slate-300 font-mono text-xs">
  <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10">
    <div>
      <div class="text-xs font-bold text-slate-500 mb-1">Job Class</div>
      <div class="text-lg font-black text-white"><%= @job.class_name %></div>
    </div>
    <div class="flex gap-4">
      <div class="text-right">
        <div class="text-xs font-bold text-slate-500 mb-1">Queue</div>
        <div class="px-2 py-1 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 inline-block font-bold"><%= @job.queue_name %></div>
      </div>
      <%= button_to discard_admin_job_path(@job), method: :post, class: "btn btn-outline border-rose-500 text-rose-500 hover:bg-rose-500 hover:text-white btn-sm rounded-lg text-xs font-bold", data: { turbo_confirm: "Discard this job? This will stop it from being retried, though the current worker process may continue until it finishes its current task." } do %>
        <%= heroicon "x-circle", variant: :solid, options: { class: "w-4 h-4" } %> Discard
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-8 mb-8">
    <div>
      <div class="text-xs font-bold text-slate-500 mb-2">Details</div>
      <div class="space-y-2">
        <div class="flex justify-between">
          <span class="opacity-70">Active Job ID:</span>
          <span class="text-slate-400"><%= @job.active_job_id %></span>
        </div>
        <div class="flex justify-between">
          <span class="opacity-70">Created At:</span>
          <span class="text-slate-400"><%= @job.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
        </div>
        <div class="flex justify-between">
          <span class="opacity-70">Priority:</span>
          <span class="text-slate-400"><%= @job.priority %></span>
        </div>
      </div>
    </div>
    <div>
      <div class="text-xs font-bold text-slate-500 mb-2">Worker</div>
      <% if claimed = SolidQueue::ClaimedExecution.find_by(job_id: @job.id) %>
        <div class="p-3 bg-white/5 rounded border border-white/5 text-xs">
          <div class="flex justify-between mb-1">
            <span class="opacity-70">PID:</span>
            <span class="text-emerald-400 font-bold"><%= claimed.process&.pid || "Unknown" %></span>
          </div>
          <div class="flex justify-between mb-1">
            <span class="opacity-70">Hostname:</span>
            <span class="text-slate-300 truncate ml-4"><%= claimed.process&.hostname %></span>
          </div>
          <div class="flex justify-between">
            <span class="opacity-70">Started:</span>
            <span class="text-slate-400"><%= time_ago_in_words(claimed.created_at) %> ago</span>
          </div>
        </div>
      <% else %>
        <div class="p-3 bg-white/5 rounded border border-white/5 text-xs text-slate-500 italic">
          Not currently claimed
        </div>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <div>
      <div class="text-xs font-bold text-slate-500 mb-2">Arguments</div>
      <div class="p-4 bg-black/40 rounded-xl border border-white/5 max-h-[300px] overflow-y-auto">
        <pre class="text-blue-300"><code><%= JSON.pretty_generate(JSON.parse(@job.arguments)) rescue @job.arguments %></code></pre>
      </div>
    </div>
  </div>
</div>
<% end %>
