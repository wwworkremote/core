<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">
      <%= @status == 'purged' ? "RECYCLE_BIN" : "JOB_POSTINGS_REGISTRY" %>
    </h1>
    <p class="text-base-content/40 font-bold uppercase tracking-widest text-[10px]">Administrative CRUD Control Layer</p>
  </div>
  <div class="flex items-center gap-2">
    <% if @status == 'purged' %>
      <%= link_to "VIEW_ACTIVE_REGISTRY", admin_job_postings_path, class: "btn btn-ghost btn-sm rounded-lg font-black tracking-widest text-[10px] border border-white/5" %>
    <% else %>
      <%= link_to "VIEW_RECYCLE_BIN", admin_job_postings_path(status: 'purged'), class: "btn btn-ghost btn-sm rounded-lg font-black tracking-widest text-[10px] border border-error/20 text-error/60" %>
    <% end %>
  </div>
</div>

<%= form_with url: bulk_action_admin_job_postings_path, method: :post, id: "bulk-form" do |f| %>
  <div class="bg-base-200 border border-white/5 rounded-2xl shadow-2xl overflow-hidden mb-6">
    <!-- Batch Control Bar -->
    <div class="bg-base-300/80 px-6 py-4 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <input type="checkbox" class="checkbox checkbox-xs checkbox-primary" onclick="toggleAll(this)">
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Selection_Control</span>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[9px] font-black uppercase tracking-widest text-slate-600 mr-2">Batch_Command:</span>
        <% if @status == 'purged' %>
          <button type="submit" name="bulk_operation" value="restore" class="btn btn-xs btn-success rounded font-black tracking-widest text-[9px]">RESTORE_SELECTED</button>
          <button type="submit" name="bulk_operation" value="delete" class="btn btn-xs btn-error rounded font-black tracking-widest text-[9px]" data-turbo-confirm="Permanently delete selected records?">PURGE_PERMANENTLY</button>
        <% else %>
          <button type="submit" name="bulk_operation" value="purge" class="btn btn-xs btn-warning rounded font-black tracking-widest text-[9px]">MOVE_TO_TRASH</button>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-sm w-full font-mono text-[10px]">
        <thead class="bg-base-300/30 border-b border-white/5">
          <tr class="text-base-content/20 uppercase tracking-[0.2em] font-black">
            <th class="w-10"></th>
            <th class="px-6 py-4 font-black">Title_Company</th>
            <th class="px-6 py-4 font-black text-center">Neural_Status</th>
            <th class="px-6 py-4 font-black text-center">Vectors</th>
            <th class="px-6 py-4 font-black text-right">Execution</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% @job_postings.each do |job| %>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-6 py-4">
                <input type="checkbox" name="job_ids[]" value="<%= job.id %>" class="checkbox checkbox-xs border-white/20">
              </td>
              <td class="px-6 py-5">
                <div class="text-white font-black text-sm uppercase tracking-tight mb-0.5 truncate max-w-md"><%= job.title %></div>
                <div class="text-primary font-black uppercase tracking-widest text-[9px]"><%= job.company_name %></div>
              </td>
              <td class="px-6 py-5 text-center align-middle">
                <% category = job.data&.[]('ai_category') %>
                <% if category.present? %>
                  <div class="badge badge-primary bg-primary/10 text-primary border-primary/20 font-black text-[9px] uppercase tracking-tighter">
                    <%= category.upcase %>
                  </div>
                <% elsif job.status == 'purged' %>
                  <span class="opacity-40 text-error font-black uppercase">VECTORS_WIPED</span>
                <% else %>
                  <span class="opacity-20 italic">PENDING_SYNTHESIS</span>
                <% end %>
              </td>
              <td class="px-6 py-5 text-center align-middle">
                <% if job.embedding.present? %>
                  <span class="text-accent shadow-[0_0_8px_#8be9fd]"><%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %></span>
                <% else %>
                  <span class="opacity-10"><%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %></span>
                <% end %>
              </td>
              <td class="px-6 py-5 text-right align-middle">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to admin_job_posting_path(job), class: "btn btn-ghost btn-xs border border-white/10 rounded font-black tracking-widest text-base-content/40 hover:text-white" do %>
                    READ
                  <% end %>

                  <% if job.status == 'purged' %>
                    <%= button_to restore_admin_job_posting_path(job), method: :post, class: "btn btn-ghost btn-xs border border-success/20 text-success/60 hover:bg-success hover:text-white rounded font-black tracking-widest" do %>
                      RESTORE
                    <% end %>
                  <% else %>
                    <%= button_to purge_admin_job_posting_path(job), method: :post, class: "btn btn-ghost btn-xs border border-warning/20 text-warning/60 hover:bg-warning hover:text-white rounded font-black tracking-widest" do %>
                      TRASH
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="flex flex-col md:flex-row items-center justify-between gap-6 opacity-60">
  <%= paginate @job_postings %>

  <%= link_to admin_root_path, class: "flex items-center gap-3 text-[10px] font-black uppercase tracking-widest text-base-content/50 hover:text-primary transition-all" do %>
    <%= heroicon "chevron-left", options: { class: "w-3 h-3" } %> ESCAPE_TO_ADMIN_PORTAL
  <% end %>
</div>

<script>
  function toggleAll(source) {
    checkboxes = document.getElementsByName('job_ids[]');
    for(var i=0, n=checkboxes.length;i<n;i++) {
      checkboxes[i].checked = source.checked;
    }
  }
</script>
