<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1">
      <%= @status == 'purged' ? "Deleted Postings" : "Job Postings" %>
    </h1>
    <p class="text-base-content/60 font-bold text-sm">Manage job postings.</p>
  </div>
  <div class="flex items-center gap-2">
    <% if @status == 'purged' %>
      <%= link_to "View Active Postings", admin_job_postings_path, class: "btn btn-ghost btn-sm rounded-lg font-bold border border-white/5" %>
    <% else %>
      <%= link_to "View Deleted", admin_job_postings_path(status: 'purged'), class: "btn btn-ghost btn-sm rounded-lg font-bold border border-error/20 text-error/70" %>
    <% end %>
  </div>
</div>

<%= form_with url: bulk_action_admin_job_postings_path, method: :post, id: "bulk-form" do |f| %>
  <div class="bg-base-200 border border-white/5 rounded-2xl shadow-2xl overflow-hidden mb-6">
    <!-- Batch Control Bar -->
    <div class="bg-base-300/80 px-6 py-4 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <input type="checkbox" class="checkbox checkbox-xs checkbox-primary" onclick="toggleAll(this)">
        <span class="text-xs font-bold text-slate-500">Select all</span>
      </div>

      <div class="flex items-center gap-2">
        <% if @status == 'purged' %>
          <button type="submit" name="bulk_operation" value="restore" class="btn btn-xs btn-success rounded font-bold">Restore Selected</button>
          <button type="submit" name="bulk_operation" value="delete" class="btn btn-xs btn-error rounded font-bold" data-turbo-confirm="Permanently delete selected records?">Delete Permanently</button>
        <% else %>
          <button type="submit" name="bulk_operation" value="purge" class="btn btn-xs btn-warning rounded font-bold">Delete Selected</button>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-sm w-full font-mono text-xs">
        <thead class="bg-base-300/30 border-b border-white/5">
          <tr class="text-base-content/40 font-bold">
            <th class="w-10"></th>
            <th class="px-6 py-4 font-bold">Title / Company</th>
            <th class="px-6 py-4 font-bold text-center">AI Category</th>
            <th class="px-6 py-4 font-bold text-center">Indexed</th>
            <th class="px-6 py-4 font-bold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% @job_postings.each do |job| %>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="px-6 py-4">
                <input type="checkbox" name="job_ids[]" value="<%= job.id %>" class="checkbox checkbox-xs border-white/20">
              </td>
              <td class="px-6 py-5">
                <div class="text-white font-bold text-sm mb-0.5 truncate max-w-md">
                  <%= job.title %>
                  <% if job.leads.any? %>
                    <%= link_to admin_lead_path(job.leads.first), title: "Captured via the extension -- click to view the Lead",
                                class: "badge badge-outline border-accent/40 text-accent text-[10px] font-bold align-middle ml-1" do %>
                      <%= job.leads.first.provider&.humanize || "extension" %>
                    <% end %>
                  <% end %>
                </div>
                <div class="text-primary font-bold text-xs"><%= job.company_name %></div>
              </td>
              <td class="px-6 py-5 text-center align-middle">
                <% category = job.data&.[]('ai_category') %>
                <% if category.present? %>
                  <div class="badge badge-primary bg-primary/10 text-primary border-primary/20 font-bold text-xs">
                    <%= category %>
                  </div>
                <% elsif job.status == 'purged' %>
                  <span class="opacity-60 text-error font-bold">Cleared</span>
                <% else %>
                  <span class="opacity-40 italic">Pending</span>
                <% end %>
              </td>
              <td class="px-6 py-5 text-center align-middle">
                <% if job.embedding.present? %>
                  <span class="text-accent"><%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %></span>
                <% else %>
                  <span class="opacity-20"><%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %></span>
                <% end %>
              </td>
              <td class="px-6 py-5 text-right align-middle">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to admin_job_posting_path(job), class: "btn btn-ghost btn-xs border border-white/10 rounded font-bold text-base-content/60 hover:text-white" do %>
                    View
                  <% end %>

                  <% if job.status == 'purged' %>
                    <%= button_to restore_admin_job_posting_path(job), method: :post, class: "btn btn-ghost btn-xs border border-success/20 text-success/70 hover:bg-success hover:text-white rounded font-bold" do %>
                      Restore
                    <% end %>
                  <% else %>
                    <%= button_to purge_admin_job_posting_path(job), method: :post, class: "btn btn-ghost btn-xs border border-warning/20 text-warning/70 hover:bg-warning hover:text-white rounded font-bold" do %>
                      Delete
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="flex flex-col md:flex-row items-center justify-between gap-6 opacity-80">
  <%= paginate @job_postings %>

  <%= link_to admin_root_path, class: "flex items-center gap-3 text-sm font-bold text-base-content/60 hover:text-primary transition-all" do %>
    <%= heroicon "chevron-left", options: { class: "w-3 h-3" } %> Back to Admin Dashboard
  <% end %>
</div>

<script>
  function toggleAll(source) {
    checkboxes = document.getElementsByName('job_ids[]');
    for(var i=0, n=checkboxes.length;i<n;i++) {
      checkboxes[i].checked = source.checked;
    }
  }
</script>
