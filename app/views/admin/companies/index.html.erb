<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase italic">Company_Ingestion_Registry</h1>
    <p class="text-base-content/40 font-bold uppercase tracking-widest text-[10px]">Administrative Control over Processing Pipelines</p>
  </div>
</div>

<div class="bg-base-200 border border-white/5 rounded-2xl shadow-2xl overflow-hidden mb-10">
  <div class="overflow-x-auto">
    <table class="table table-sm w-full font-mono text-[10px]">
      <thead class="bg-base-300/50 border-b border-white/10">
        <tr class="text-base-content/30 uppercase tracking-[0.2em] font-black">
          <th class="px-6 py-4 font-black">Entity_Identity</th>
          <th class="px-6 py-4 font-black text-center">Raw_Volume</th>
          <th class="px-6 py-4 font-black text-center">Active_Signals</th>
          <th class="px-6 py-4 font-black text-center">Ingestion_Status</th>
          <th class="px-6 py-4 font-black text-right">Pipeline_Control</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        <% @companies.each do |company| %>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="px-6 py-5 text-sm font-bold text-white uppercase tracking-tight">
              <%= link_to company.name, admin_company_path(company), class: "hover:text-primary transition-all" %>
            </td>
            <td class="px-6 py-5 text-center font-black text-slate-500">
              <%= company.job_postings_count %>
            </td>
            <td class="px-6 py-5 text-center font-black text-primary">
              <%= company.job_postings.where.not(status: 'ignored').count %>
            </td>
            <td class="px-6 py-5 text-center">
              <% if company.ingestion_enabled? %>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 font-black text-[9px]">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> ACTIVE_SYNC
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-rose-500/10 text-rose-500 border border-rose-500/20 font-black text-[9px]">
                  OFFLINE
                </span>
              <% end %>
            </td>
            <td class="px-6 py-5 text-right">
              <%= button_to toggle_ingestion_admin_company_path(company), 
                  method: :post, 
                  class: "btn btn-ghost btn-xs border border-white/10 rounded font-black tracking-widest text-base-content/40 hover:text-white" do %>
                <%= company.ingestion_enabled? ? "PAUSE_INGESTION" : "RESUME_INGESTION" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="flex justify-center mt-10">
  <%= paginate @companies %>
</div>

<div class="mt-8 flex items-center justify-between opacity-50 font-bold text-[10px] uppercase tracking-widest px-2">
  <%= link_to admin_root_path, class: "hover:text-white transition-colors flex items-center gap-2" do %>
    <%= heroicon "chevron-left", options: { class: "w-3 h-3" } %> ESCAPE_TO_ADMIN_DASHBOARD
  <% end %>
</div>
