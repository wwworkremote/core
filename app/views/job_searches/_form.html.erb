<div class="max-w-4xl mx-auto py-10 px-6">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to t('.breadcrumb_home'), root_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-xs"></i>
      <%= link_to t('.breadcrumb_searches'), job_searches_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-xs"></i>
      <span class="text-white"><%= @job_search.new_record? ? t('.breadcrumb_new') : t('.breadcrumb_edit') %></span>
    </div>
  </div>

  <div class="mb-12">
    <h1 class="text-4xl font-black text-white tracking-tight leading-none mb-3">
      <%= @job_search.new_record? ? t('.new_title') : t('.edit_title') %>
    </h1>
    <p class="text-slate-500 font-bold text-sm"><%= t('.subtitle') %></p>
  </div>

  <div class="card-neural p-8">
    <%= form_with(model: @job_search, class: "space-y-8") do |f| %>
      <div class="form-control">
        <%= f.label :name, t('.name_label'), class: "label text-xs font-bold text-slate-500" %>
        <%= f.text_field :name, placeholder: "e.g., Q3 2026 Senior Backend Search", class: "input input-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="form-control">
          <%= f.label :resume_id, t('.resume_label'), class: "label text-xs font-bold text-slate-500" %>
          <%= f.select :resume_id, @resumes.map { |r| ["#{r.name} (v#{r.version})", r.id] }, { include_blank: t('.resume_blank') }, class: "select select-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
          <label class="label">
            <span class="label-text-alt text-xs text-slate-500"><%= t('.resume_helper') %></span>
          </label>
        </div>

        <div class="form-control">
          <%= f.label :status, t('.status_label'), class: "label text-xs font-bold text-slate-500" %>
          <%= f.select :status, JobSearch.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "select select-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
        </div>
      </div>

      <div class="pt-6 border-t border-white/5 flex justify-end gap-4">
        <%= link_to t('.cancel'), job_searches_path, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold" %>
        <%= f.submit (@job_search.new_record? ? t('.create') : t('.update')), class: "btn btn-primary rounded-xl px-10 font-bold" %>
      </div>
    <% end %>
  </div>
</div>
