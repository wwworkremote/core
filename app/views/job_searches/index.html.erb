<%= render "admin/shared/nav" if current_user.admin? %>

<div class="max-w-6xl mx-auto py-10 px-6">
  <div class="mb-10 text-[10px] font-black uppercase tracking-[0.2em] opacity-40">
    <div class="flex items-center gap-3">
      <%= link_to "Home", root_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-[8px]"></i>
      <span class="text-white">Campaign_Registry</span>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl font-black text-white mb-3 uppercase tracking-tight leading-none">Job Search Campaigns</h1>
      <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Strategic groupings of opportunities bound to specific resume versions.</p>
    </div>
    <div class="flex gap-4">
      <%= link_to "INITIATE_NEW_CAMPAIGN", new_job_search_path, class: "btn btn-primary rounded-xl px-10 font-black tracking-widest text-[10px]" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @job_searches.each do |campaign| %>
      <div class="card-neural p-8 border-t-2 <%= campaign.active? ? 'border-primary' : 'border-slate-800' %>">
        <div class="flex justify-between items-start mb-4">
          <h3 class="text-xl font-black text-white uppercase tracking-tight"><%= campaign.name %></h3>
          <span class="badge badge-neutral bg-white/5 border-none text-[8px] font-black uppercase tracking-widest"><%= campaign.status %></span>
        </div>

        <div class="space-y-6">
          <div class="p-4 bg-white/5 rounded-xl border border-white/5">
            <div class="text-[8px] font-black text-slate-500 uppercase tracking-[0.2em] mb-2">Bound_Resume</div>
            <% if campaign.resume %>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-white"><%= campaign.resume.name %></span>
                <span class="text-[10px] font-black text-primary/50">V<%= campaign.resume.version %></span>
              </div>
            <% else %>
              <div class="text-xs font-bold text-slate-600">NO_RESUME_BOUND</div>
            <% end %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="text-center p-4 bg-white/5 rounded-xl border border-white/5">
              <div class="text-2xl font-black text-white"><%= campaign.user_job_postings.count %></div>
              <div class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mt-1">Jobs_Linked</div>
            </div>
            <div class="text-center p-4 bg-white/5 rounded-xl border border-white/5">
              <div class="text-2xl font-black text-primary"><%= campaign.user_job_postings.where(status: 'applied').count %></div>
              <div class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mt-1">Applications</div>
            </div>
          </div>

          <div class="pt-4 border-t border-white/5">
            <%= link_to "VIEW_CAMPAIGN_INTELLIGENCE", job_search_path(campaign), class: "btn btn-ghost border-white/10 btn-block btn-sm font-black tracking-widest text-[9px] hover:bg-primary/10 hover:text-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
