<div class="max-w-7xl mx-auto py-10 px-6">
  <div class="mb-10 text-[10px] font-black uppercase tracking-[0.2em] opacity-40">
    <div class="flex items-center gap-3">
      <%= link_to "Home", root_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-[8px]"></i>
      <%= link_to "Campaign_Registry", job_searches_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-[8px]"></i>
      <span class="text-white"><%= @job_search.name %>_Campaign</span>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl font-black text-white uppercase tracking-tight leading-none mb-3"><%= @job_search.name %></h1>
      <div class="flex items-center gap-4">
        <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Strategic campaign targeting semantic matches.</p>
        <span class="badge badge-primary badge-outline text-[8px] font-black uppercase tracking-widest"><%= @job_search.status %></span>
      </div>
    </div>
    <div class="flex gap-4">
      <%= link_to "RECONFIGURE_CAMPAIGN", edit_job_search_path(@job_search), class: "btn btn-ghost border-white/10 rounded-xl px-10 font-black tracking-widest text-[10px]" %>
      <%= button_to "CLOSE_CAMPAIGN", job_search_path(@job_search), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline btn-error rounded-xl px-10 font-black tracking-widest text-[10px]" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 mb-12">
    <div class="lg:col-span-1 space-y-8">
      <div class="card-neural p-8 border-l-4 border-primary">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-white/40 mb-6">Bound_Resume_Node</h3>
        <% if @job_search.resume %>
          <div class="p-4 bg-white/5 rounded-xl border border-white/10">
            <%= link_to resume_path(@job_search.resume), class: "group" do %>
              <div class="text-lg font-black text-white uppercase group-hover:text-primary transition-colors"><%= @job_search.resume.name %></div>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-[10px] font-black text-primary/50">VERSION_<%= @job_search.resume.version %></span>
                <span class="badge badge-success badge-xs text-[7px] font-black uppercase">VECTORIZED</span>
              </div>
            <% end %>
          </div>
          <div class="mt-6 space-y-4">
            <div class="text-[8px] font-black text-slate-600 uppercase tracking-widest">Active_Targeting_Profile</div>
            <p class="text-[10px] text-slate-500 leading-relaxed font-medium">This campaign uses the semantic embedding of this resume version to rank all available job market nodes.</p>
          </div>
        <% else %>
          <div class="alert alert-warning text-[10px] font-black uppercase tracking-widest">NO_RESUME_BOUND</div>
        <% end %>
      </div>

      <div class="card-neural p-8">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-white/40 mb-6 flex justify-between items-center">
          <span>Skill_Alignment</span>
          <i class="bi bi-cpu text-primary/40"></i>
        </h3>
        <div class="space-y-3">
          <% if @skill_matches.any? %>
            <% @skill_matches.each do |skill| %>
              <div class="flex items-center justify-between p-3 bg-white/5 rounded-lg border border-white/5">
                <span class="text-[10px] font-bold text-white uppercase tracking-tight"><%= skill.name %></span>
                <span class="text-[8px] font-black text-primary/60"><%= (100 - (skill.neighbor_distance * 100)).round(1) %>%</span>
              </div>
            <% end %>
          <% else %>
            <div class="text-[10px] text-slate-600 italic">Calculating skill resonance...</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-3 space-y-8">
      <div class="flex items-center justify-between px-2">
        <h3 class="text-[11px] font-black uppercase tracking-[0.4em] text-white/20">Market_Resonance_Matches</h3>
        <span class="text-[9px] font-bold text-slate-600 uppercase tracking-widest"><%= @matches.count %> Nodes_Identified</span>
      </div>

      <div class="grid grid-cols-1 gap-6">
        <% if @matches.any? %>
          <% @matches.each do |job| %>
            <div class="card-neural p-8 border border-white/5 hover:border-primary/20 transition-all group">
              <div class="flex flex-col md:flex-row justify-between gap-6">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h4 class="text-xl font-black text-white uppercase tracking-tight"><%= job.title %></h4>
                    <span class="badge badge-neutral bg-white/5 border-none text-[8px] font-black uppercase tracking-widest"><%= job.freshness %></span>
                  </div>
                  <div class="flex items-center gap-4 mb-6">
                    <span class="text-sm font-bold text-primary tracking-widest uppercase"><%= job.company_name %></span>
                    <span class="text-slate-600 text-[10px] font-bold">&mdash;</span>
                    <span class="text-slate-500 text-[10px] font-bold uppercase tracking-widest"><%= job.location %></span>
                  </div>
                  <div class="prose prose-invert prose-sm line-clamp-3 text-white/40 text-xs">
                    <%= markdown(job.body&.truncate(300)) %>
                  </div>
                </div>
                <div class="flex flex-col items-end justify-between text-right min-w-[150px]">
                  <div class="flex flex-col items-end gap-1">
                    <div class="text-[9px] font-black text-slate-600 uppercase tracking-widest">Match_Score</div>
                    <div class="text-3xl font-black text-white tracking-tighter">
                      <%= (100 - (job.neighbor_distance * 100)).round(1) %><span class="text-primary/50 text-xl">%</span>
                    </div>
                  </div>
                  <div class="flex gap-2">
                    <%= link_to "ANALYZE", job_posting_path(job), class: "btn btn-ghost border-white/10 btn-sm font-black tracking-widest text-[9px] hover:text-primary" %>
                    <% if job.user_job_postings.where(user: current_user).any? %>
                      <div class="badge badge-success badge-outline rounded text-[8px] font-black uppercase px-4 h-8">TRACKED</div>
                    <% else %>
                      <%= button_to "TRACK", user_job_postings_path(job_posting_id: job.id, job_search_id: @job_search.id), method: :post, class: "btn btn-primary btn-sm font-black tracking-widest text-[9px] px-6" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="card-neural p-20 text-center border-dashed border-white/10">
            <i class="bi bi-search text-4xl text-slate-800 mb-6 block"></i>
            <div class="text-xs font-black text-slate-600 uppercase tracking-[0.2em]">No High-Confidence Matches Found</div>
            <p class="text-[10px] text-slate-700 mt-4 max-w-sm mx-auto leading-relaxed">Try adjusting the bound resume content or broadening your search parameters to find compatible market nodes.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
