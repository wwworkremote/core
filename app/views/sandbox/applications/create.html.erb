<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Application Received - Acme Sandbox Co</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
  </head>
  <body>
    <!-- Fake ATS fixture confirmation page. ats_application_id is minted
         here, only at confirmation -- see
         docs/architecture/sandbox-provider.md. -->
    <h1>Application Received</h1>
    <p>Thanks for applying to Acme Sandbox Co.</p>

    <div id="confirmation" data-job-post-id="<%= @job_post_id %>" data-ats-application-id="<%= @ats_application_id %>">
      <p>Job Post ID: <span id="job_post_id"><%= @job_post_id %></span></p>
      <p>Confirmation Number: <span id="ats_application_id"><%= @ats_application_id %></span></p>
    </div>
  </body>
</html>
