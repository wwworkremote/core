<% content_for :title, "#{@relative_path} | Docs | WWWorkRemote" %>

<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>

<div class="mb-10 text-xs font-bold opacity-60">
  <div class="flex items-center gap-3">
    <%= link_to "Home", root_path, class: "hover:text-primary transition-all" %>
    <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
    <%= link_to "Docs", docs_path, class: "hover:text-primary transition-all" %>
    <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
    <span class="text-white"><%= @relative_path %></span>
  </div>
</div>

<div class="bg-base-200 border border-white/5 rounded-2xl p-8 md:p-12 mb-16" data-controller="mermaid">
  <article class="prose prose-invert prose-violet max-w-none">
    <%= @html.html_safe %>
  </article>
</div>

<style>
  .prose pre.mermaid { background: transparent; padding: 1.5rem 0; text-align: center; }
  .prose pre.mermaid svg { margin: 0 auto; max-width: 100%; }
</style>
