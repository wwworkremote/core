<%= form_with(model: llm_chat, url: llm_chats_path) do |form| %>
  <% if llm_chat.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h6 class="alert-heading"><%= pluralize(llm_chat.errors.count, "error") %> prohibited this chat from being saved:</h6>
      <ul class="mb-0">
        <% llm_chat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :model, "Select AI model:", class: "form-label" %>
    <%= form.select :model,
        options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift(["Default", nil]), @selected_model),
        {},
        class: "form-select shadow-sm" %>
  </div>

  <div class="mb-4">
    <%= form.label :prompt, "Initial Prompt", class: "form-label" %>
    <%= form.text_area :prompt, rows: 4, placeholder: "What would you like to discuss?", autofocus: true,
        class: "form-control shadow-sm" %>
  </div>

  <div class="d-grid gap-2 d-sm-block">
    <%= form.submit "Start New AI Chat", class: "btn btn-primary px-4" %>
    <%= link_to "Cancel", llm_chats_path, class: "btn btn-link text-secondary" %>
  </div>
<% end %>
