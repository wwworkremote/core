<% content_for :title, t('.title') %>

<div class="flex justify-between items-center mb-12">
  <div>
    <h1 class="text-4xl font-black tracking-tight"><%= t('.title') %></h1>
    <p class="text-sm font-bold opacity-60 mt-1"><%= t('.subtitle') %></p>
  </div>

  <div class="flex gap-2">
    <%= link_to models_path, class: "btn btn-ghost btn-sm rounded-xl gap-2 font-bold" do %>
      <%= heroicon "cpu-chip", variant: :solid, options: { class: "w-3 h-3" } %>
      <%= t('.models') %>
    <% end %>
    <%= link_to new_llm_chat_path, class: "btn btn-primary btn-sm rounded-xl gap-2 font-bold shadow-lg shadow-primary/20" do %>
      <%= heroicon "plus-circle", variant: :solid, options: { class: "w-3 h-3" } %>
      <%= t('.new_chat') %>
    <% end %>
  </div>
</div>

<div id="llm_chats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if @llm_chats.any? %>
    <% @llm_chats.each do |llm_chat| %>
      <div class="card bg-base-200 border border-white/5 shadow-xl hover:border-primary/30 transition-all group overflow-hidden">
        <div class="card-body p-6">
          <div class="flex justify-between items-start mb-6">
            <div class="bg-primary/10 p-3 rounded-2xl group-hover:bg-primary/20 transition-colors">
              <%= heroicon "chat-bubble-bottom-center-text", variant: :solid, options: { class: "w-6 h-6 text-primary" } %>
            </div>

            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="btn btn-ghost btn-xs btn-circle opacity-50 group-hover:opacity-100 transition-opacity">
                <%= heroicon "ellipsis-vertical", variant: :solid, options: { class: "w-4 h-4" } %>
              </div>
              <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-base-300 rounded-box w-52 border border-white/5 font-bold text-sm">
                <li>
                  <%= button_to llm_chat, method: :delete, class: "text-error gap-2", data: { turbo_confirm: t('.delete_confirm') } do %>
                    <%= heroicon "trash", variant: :solid, options: { class: "w-3 h-3" } %>
                    <%= t('.delete') %>
                  <% end %>
                </li>
              </ul>
            </div>
          </div>

          <h2 class="text-lg font-black tracking-tight mb-1"><%= t('.chat_number', id: llm_chat.id) %></h2>
          <div class="flex items-center gap-2 mb-6">
            <div class="badge badge-outline badge-xs opacity-60 font-bold"><%= t('.model_label') %></div>
            <span class="text-xs font-bold opacity-60"><%= llm_chat.model&.name || t('.default_model') %></span>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="bg-base-300/50 p-3 rounded-xl border border-white/5">
              <div class="text-xl font-black tracking-tight leading-none"><%= llm_chat.llm_messages.count %></div>
              <div class="text-xs font-bold opacity-50 mt-1"><%= t('.messages') %></div>
            </div>
            <div class="bg-base-300/50 p-3 rounded-xl border border-white/5">
              <div class="text-sm font-black tracking-tight leading-none pt-1.5"><%= llm_chat.created_at.strftime("%b %-d") %></div>
              <div class="text-xs font-bold opacity-50 mt-2"><%= t('.started') %></div>
            </div>
          </div>

          <%= link_to llm_chat, class: "btn btn-outline btn-sm rounded-xl w-full font-bold hover:bg-primary hover:text-primary-content hover:border-primary shadow-xl shadow-transparent hover:shadow-primary/20 transition-all" do %>
            <%= t('.open_chat') %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-span-full py-24 flex flex-col items-center justify-center text-center">
      <div class="bg-base-200 p-12 rounded-[3rem] border border-white/5 shadow-2xl relative overflow-hidden group">
        <div class="absolute -top-12 -left-12 w-48 h-48 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-all"></div>
        <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-secondary/5 rounded-full blur-3xl group-hover:bg-secondary/10 transition-all"></div>

        <%= heroicon "bolt-slash", variant: :solid, options: { class: "w-24 h-24 text-base-300 mx-auto mb-8 group-hover:scale-110 transition-transform duration-500" } %>
        <h3 class="text-2xl font-black tracking-tight mb-4"><%= t('.empty_title') %></h3>
        <p class="text-sm font-bold opacity-60 max-w-[220px] mx-auto leading-relaxed mb-8">
          <%= t('.empty_body') %>
        </p>
        <%= link_to new_llm_chat_path, class: "btn btn-primary rounded-xl px-12 font-bold shadow-2xl shadow-primary/20" do %>
          <%= t('.new_chat') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
