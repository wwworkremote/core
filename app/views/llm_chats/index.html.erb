<% content_for :title, "AI Chats" %>

<div class="row mb-4 align-items-center">
  <div class="col">
    <h1 class="display-4">AI Chats</h1>
  </div>
  <div class="col-auto">
    <div class="btn-group">
      <%= link_to "Models Registry", models_path, class: "btn btn-outline-secondary" %>
      <%= link_to "New AI Chat", new_llm_chat_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>

<div id="llm_chats" class="list-group list-group-flush border-top">
  <% if @llm_chats.any? %>
    <% @llm_chats.each do |llm_chat| %>
      <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-center py-3">
        <div class="mb-2 mb-sm-0">
          <%= render llm_chat %>
        </div>
        <div class="btn-group">
          <%= link_to "Show", llm_chat, class: "btn btn-sm btn-outline-primary" %>
          <%= button_to "Destroy", llm_chat, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center my-5 py-5 border rounded bg-light">
      <p class="lead mb-0">No AI chats found.</p>
    </div>
  <% end %>
</div>
