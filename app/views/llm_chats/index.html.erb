<% content_for :title, "Neural Dialogues" %>

<div class="flex justify-between items-center mb-12">
  <div>
    <h1 class="text-4xl font-black uppercase tracking-tighter italic">Neural <span class="text-primary">Dialogues</span></h1>
    <p class="text-[10px] font-bold uppercase tracking-[0.2em] opacity-40 mt-1">Direct interface with aggregated model registry</p>
  </div>

  <div class="flex gap-2">
    <%= link_to models_path, class: "btn btn-ghost btn-sm rounded-xl gap-2 font-bold uppercase tracking-widest text-[10px]" do %>
      <%= heroicon "cpu-chip", variant: :solid, options: { class: "w-3 h-3" } %>
      Registry
    <% end %>
    <%= link_to new_llm_chat_path, class: "btn btn-primary btn-sm rounded-xl gap-2 font-bold uppercase tracking-widest text-[10px] shadow-lg shadow-primary/20" do %>
      <%= heroicon "plus-circle", variant: :solid, options: { class: "w-3 h-3" } %>
      Initiate
    <% end %>
  </div>
</div>

<div id="llm_chats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if @llm_chats.any? %>
    <% @llm_chats.each do |llm_chat| %>
      <div class="card bg-base-200 border border-white/5 shadow-xl hover:border-primary/30 transition-all group overflow-hidden">
        <div class="card-body p-6">
          <div class="flex justify-between items-start mb-6">
            <div class="bg-primary/10 p-3 rounded-2xl group-hover:bg-primary/20 transition-colors">
              <%= heroicon "chat-bubble-bottom-center-text", variant: :solid, options: { class: "w-6 h-6 text-primary" } %>
            </div>

            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="btn btn-ghost btn-xs btn-circle opacity-30 group-hover:opacity-100 transition-opacity">
                <%= heroicon "ellipsis-vertical", variant: :solid, options: { class: "w-4 h-4" } %>
              </div>
              <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-base-300 rounded-box w-52 border border-white/5 font-bold uppercase tracking-widest text-[10px]">
                <li>
                  <%= button_to llm_chat, method: :delete, class: "text-error gap-2", data: { turbo_confirm: "Terminate session?" } do %>
                    <%= heroicon "trash", variant: :solid, options: { class: "w-3 h-3" } %>
                    Terminate
                  <% end %>
                </li>
              </ul>
            </div>
          </div>

          <h2 class="text-lg font-black uppercase tracking-tighter mb-1">Session <span class="text-primary opacity-50 group-hover:opacity-100 transition-opacity">#<%= llm_chat.id %></span></h2>
          <div class="flex items-center gap-2 mb-6">
            <div class="badge badge-outline badge-xs opacity-50 uppercase font-bold tracking-widest text-[8px]">Model</div>
            <span class="text-[10px] font-bold uppercase tracking-widest opacity-50"><%= llm_chat.model&.name || "Default" %></span>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="bg-base-300/50 p-3 rounded-xl border border-white/5">
              <div class="text-xl font-black italic tracking-tighter leading-none"><%= llm_chat.llm_messages.count %></div>
              <div class="text-[8px] font-bold uppercase tracking-widest opacity-30 mt-1">Signals</div>
            </div>
            <div class="bg-base-300/50 p-3 rounded-xl border border-white/5">
              <div class="text-[10px] font-black uppercase tracking-tighter leading-none pt-1.5"><%= llm_chat.created_at.strftime("%b %d") %></div>
              <div class="text-[8px] font-bold uppercase tracking-widest opacity-30 mt-2">Timestamp</div>
            </div>
          </div>

          <%= link_to llm_chat, class: "btn btn-outline btn-sm rounded-xl w-full font-black uppercase tracking-[0.2em] text-[10px] hover:bg-primary hover:text-primary-content hover:border-primary shadow-xl shadow-transparent hover:shadow-primary/20 transition-all" do %>
            Resume Interface
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-span-full py-24 flex flex-col items-center justify-center text-center">
      <div class="bg-base-200 p-12 rounded-[3rem] border border-white/5 shadow-2xl relative overflow-hidden group">
        <div class="absolute -top-12 -left-12 w-48 h-48 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-all"></div>
        <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-secondary/5 rounded-full blur-3xl group-hover:bg-secondary/10 transition-all"></div>

        <%= heroicon "bolt-slash", variant: :solid, options: { class: "w-24 h-24 text-base-300 mx-auto mb-8 group-hover:scale-110 transition-transform duration-500" } %>
        <h3 class="text-2xl font-black uppercase tracking-tighter mb-4 italic">No Active <span class="text-primary">Sessions</span></h3>
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] opacity-40 max-w-[200px] mx-auto leading-relaxed mb-8">
          Initiate a new neural dialogue to begin multi-modal exploration.
        </p>
        <%= link_to new_llm_chat_path, class: "btn btn-primary rounded-xl px-12 font-black uppercase tracking-[0.2em] text-[10px] shadow-2xl shadow-primary/20" do %>
          Initiate Chat
        <% end %>
      </div>
    </div>
  <% end %>
</div>
