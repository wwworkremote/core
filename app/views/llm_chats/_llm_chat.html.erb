<div id="<%= dom_id llm_chat %>" class="d-inline-flex flex-wrap gap-4">
  <div>
    <span class="text-muted small d-block">Model</span>
    <strong><%= llm_chat.model&.label || "Default" %></strong>
  </div>

  <div>
    <span class="text-muted small d-block">Messages</span>
    <span class="badge bg-secondary rounded-pill"><%= llm_chat.llm_messages.count %></span>
  </div>

  <div>
    <span class="text-muted small d-block">Created</span>
    <span><%= llm_chat.created_at.strftime("%b %d, %H:%M") %></span>
  </div>
</div>
