<% content_for :title, "AI Chat ##{@llm_chat.id}" %>

<%= turbo_stream_from "llm_chat_#{@llm_chat.id}" %>

<div class="container-fluid">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <h1 class="display-5">AI Chat #<%= @llm_chat.id %></h1>
      <p class="text-muted">Model: <strong><%= @llm_chat.model&.label || "Default" %></strong></p>
    </div>
    <div class="col-auto">
      <%= link_to "Back to AI chats", llm_chats_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div id="llm_messages" class="mb-4">
    <% @llm_chat.llm_messages.where.not(id: nil).each do |llm_message| %>
      <%= render llm_message %>
    <% end %>
  </div>

  <div class="card bg-light border-0 shadow-sm sticky-bottom mb-4">
    <div class="card-body">
      <%= render "llm_messages/form", llm_chat: @llm_chat, llm_message: @llm_message %>
    </div>
  </div>
</div>
