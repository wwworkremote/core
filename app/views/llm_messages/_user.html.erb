<% user ||= local_assigns[:message] %>
<div id="llm_message_<%= user.id %>" class="card mb-3 border-0 bg-light-subtle shadow-sm ms-5">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="badge bg-primary text-uppercase" style="font-size: 0.65rem;">User</span>
      <span class="text-muted small"><%= user.created_at&.strftime("%H:%M") %></span>
    </div>

    <div id="llm_message_<%= user.id %>_content" class="text-break"><%= user.content %></div>
  </div>
</div>
