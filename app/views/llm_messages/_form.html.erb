<%= form_with(model: llm_message, url: [@llm_chat, llm_message], id: "new_llm_message") do |form| %>
  <% if llm_message.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h6 class="alert-heading"><%= pluralize(llm_message.errors.count, "error") %> prohibited this message from being saved:</h6>
      <ul class="mb-0">
        <% llm_message.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="input-group">
    <%= form.text_area :content, rows: 2, placeholder: "Type your message...", autofocus: true,
        class: "form-control border-0 shadow-none bg-white",
        data: { controller: "textarea-autoresize" } %>
    <%= form.submit "Send", class: "btn btn-primary px-4" %>
  </div>
<% end %>
