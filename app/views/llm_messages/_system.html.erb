<% system ||= local_assigns[:llm_message] || local_assigns[:message] %>
<div id="llm_message_<%= system.id %>" class="flex flex-col items-center justify-center my-8 group">
  <div class="flex items-center gap-3 mb-2">
    <div class="h-[1px] w-8 bg-white/5"></div>
    <div class="badge badge-outline badge-xs opacity-20 uppercase font-black tracking-[0.3em] text-[7px] py-2 px-3 border-white/10">
      System Instruction
    </div>
    <div class="h-[1px] w-8 bg-white/5"></div>
  </div>

  <div class="text-[10px] font-medium text-center text-base-content/40 max-w-lg leading-relaxed italic px-6">
    <%= system.content %>
  </div>

  <div class="chat-footer opacity-10 text-[7px] font-bold uppercase tracking-widest mt-2">
    Synced: <%= system.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
