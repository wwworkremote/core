<div id="llm_message_<%= llm_message.id %>" class="chat chat-start group">
  <div class="chat-header opacity-60 text-xs font-bold mb-1">
    Error
  </div>
  <div class="chat-bubble chat-bubble-error shadow-lg text-sm leading-relaxed p-4">
    <div class="flex items-center gap-2 mb-2">
      <div class="badge badge-outline badge-xs opacity-60 font-bold text-xs text-error-content"><%= title.presence || "Error" %></div>
    </div>
    <pre class="bg-black/20 p-3 rounded-lg text-xs font-mono opacity-80 overflow-x-auto text-error-content"><%= error_message %></pre>
  </div>
  <div class="chat-footer opacity-40 text-xs font-bold mt-1">
    <%= llm_message.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
