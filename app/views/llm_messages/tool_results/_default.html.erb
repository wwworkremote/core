<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "llm_messages/error",
    llm_message: tool,
    title: "Tool Error",
    error_message: error_message %>
<% else %>
  <div id="llm_message_<%= tool.id %>" class="chat chat-start group">
    <div class="chat-header opacity-50 text-[10px] font-bold uppercase tracking-widest mb-1">
      Tool Result
    </div>
    <div class="chat-bubble bg-base-300/30 text-base-content border border-white/5 shadow-lg text-sm leading-relaxed p-4">
      <div class="flex items-center gap-2 mb-2">
        <div class="badge badge-success badge-xs opacity-50 uppercase font-bold tracking-widest text-[8px]">Output</div>
      </div>
      <pre class="bg-black/20 p-3 rounded-lg text-[10px] font-mono opacity-70 overflow-x-auto"><%= tool.content.presence || "(no output)" %></pre>
    </div>
    <div class="chat-footer opacity-20 text-[8px] font-bold uppercase tracking-widest mt-1">
      <%= tool.created_at&.strftime("%I:%M %p") %>
    </div>
  </div>
<% end %>
