<% content_for :title, "#{@job_posting.title} | WWWorkRemote" %>

<div class="mb-10 text-[10px] font-black uppercase tracking-[0.2em] opacity-40">
  <div class="flex items-center gap-3">
    <%= link_to "Job_Market", job_postings_path, class: "hover:text-primary transition-all" %>
    <i class="bi bi-chevron-right text-[8px]"></i>
    <span class="text-white">Neural_Node_<%= @job_posting.id %></span>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
  <article class="lg:col-span-2 space-y-8">
    <header class="bg-base-200 border border-white/5 rounded-2xl p-10 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-5">
        <%= heroicon "briefcase", options: { class: "w-32 h-32" } %>
      </div>
      
      <div class="relative z-10">
        <h1 class="text-4xl font-black text-white mb-3 uppercase tracking-tight leading-none"><%= @job_posting.title %></h1>
        <p class="text-xl font-bold text-secondary mb-8 tracking-widest uppercase">
          <%= link_to @job_posting.company, job_postings_path(company: @job_posting.company), class: "hover:underline" %>
        </p>

        <div class="flex flex-wrap gap-6 text-[10px] font-black uppercase tracking-[0.2em] text-base-content/40">
          <div class="flex items-center gap-2">
            <%= heroicon "map-pin", variant: :solid, options: { class: "w-4 h-4 text-primary" } %>
            <span class="text-white"><%= @job_posting.location || "GLOBAL_REMOTE" %></span>
          </div>
          <div class="flex items-center gap-2">
            <%= heroicon "calendar-days", options: { class: "w-4 h-4 text-accent" } %>
            <span class="text-white">SYNCED_<%= @job_posting.published_at&.strftime("%Y_%m_%d") || "NULL" %></span>
          </div>
        </div>
      </div>
    </header>

    <div class="bg-base-200 border border-white/5 rounded-2xl p-10 shadow-2xl">
      <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-base-content/30 mb-10 pb-4 border-b border-white/5">Position_Intelligence</h2>
      
      <div class="prose-invert max-w-none text-sm font-medium leading-relaxed text-base-content/80">
        <%= markdown(@job_posting.body) %>
      </div>

      <% if @job_posting.target_url.present? %>
        <div class="mt-16 pt-10 border-t border-white/5 flex flex-wrap gap-4">
          <%= link_to outbound_link_path(url: @job_posting.target_url, job_posting_id: @job_posting.id), target: "_blank", class: "btn btn-primary rounded-xl px-10 font-black tracking-widest text-[10px]" do %>
            INITIATE_APPLICATION_LINK
          <% end %>
          
          <%= link_to outbound_link_path(url: @job_posting.target_url, job_posting_id: @job_posting.id), target: "_blank", class: "btn btn-ghost border-white/10 rounded-xl px-10 font-black tracking-widest text-[10px] text-base-content/40 hover:text-white" do %>
            SOURCE_ORIGIN_VERIFY
          <% end %>
        </div>
      <% end %>
    </div>
  </article>

  <aside class="space-y-8">
    <!-- Personal Tracking -->
    <div class="bg-base-200 border border-white/5 rounded-2xl p-8 shadow-2xl">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/5">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30">My_Interaction</h3>
        <% user_job = current_user.user_job_postings.find_by(job_posting: @job_posting) %>
        <div class="flex items-center gap-4">
          <% if user_job&.status == 'favorited' %>
            <div class="text-[9px] font-black text-primary uppercase tracking-widest flex items-center gap-2">
              <%= heroicon "heart", variant: :solid, options: { class: "w-3 h-3" } %> RECORD_FAVORITED
            </div>
          <% else %>
            <%= button_to user_job_postings_path(job_posting_id: @job_posting.id, status: 'favorited'), class: "group flex items-center gap-2 text-[9px] font-black text-slate-500 hover:text-primary transition-colors uppercase tracking-widest" do %>
              <%= heroicon "heart", options: { class: "w-3 h-3 group-hover:scale-125 transition-transform" } %> MARK_AS_FAVORITE
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- AI Match Analysis -->
      <div class="space-y-6 mb-10">
        <div class="flex items-center justify-between">
          <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20">AI_Profile_Alignment</div>
          <% if current_user.career_profile&.resume_text.present? %>
            <%= button_to "RUN_ALIGNMENT_SCAN", analyze_match_user_job_postings_path(job_posting_id: @job_posting.id), class: "text-[8px] font-black text-primary hover:text-white underline uppercase" %>
          <% else %>
            <%= link_to "SETUP_PROFILE_FOR_MATCHING", edit_career_profile_path, class: "text-[8px] font-black text-slate-500 hover:text-white underline" %>
          <% end %>
        </div>
        
        <div class="p-4 rounded-xl bg-white/5 border border-white/5 border-dashed">
          <% if user_job&.match_analysis.present? %>
            <div class="prose-invert text-[10px] leading-relaxed">
              <%= markdown(user_job.match_analysis) %>
            </div>
          <% else %>
            <div class="text-center py-4">
              <div class="text-[9px] font-black uppercase text-slate-600 tracking-tighter mb-1 italic">MATCH_DATA_PENDING_GENERATION</div>
              <p class="text-[8px] text-slate-700">Ensure your resume is updated in your profile to enable personalized analysis.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Personal Notes -->
      <div class="space-y-4">
        <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20">Personal_Internal_Notes</div>
        <%= form_with model: user_job || current_user.user_job_postings.build(job_posting: @job_posting), url: (user_job ? user_job_posting_path(user_job) : user_job_postings_path), class: "space-y-2" do |f| %>
          <%= f.hidden_field :job_posting_id, value: @job_posting.id %>
          <%= f.text_area :notes, placeholder: "APPEND_PRIVATE_CONTEXT...", class: "textarea textarea-bordered bg-base-300 w-full rounded-xl text-[10px] font-mono", rows: 3 %>
          <%= f.submit "SAVE_INTERNAL_NOTES", class: "w-full py-2 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest hover:bg-white/10 transition-all" %>
        <% end %>
      </div>
    </div>

    <!-- Pipeline Control -->
    <div class="bg-base-200 border border-white/5 rounded-2xl p-8 shadow-2xl">
      <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 mb-8 pb-4 border-b border-white/5">Research_Pipeline</h3>
      
      <!-- Status Transitions -->
      <div class="flex flex-wrap gap-2 mb-8">
        <% ['favorite', 'apply', 'interview', 'offer', 'archive'].each do |event| %>
          <% if @job_posting.send("may_#{event}?") %>
            <%= button_to event.humanize, admin_job_posting_pipeline_steps_path(@job_posting), params: { status: event }, class: "px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest border border-primary/20 text-primary hover:bg-primary hover:text-white transition-all" %>
          <% end %>
        <% end %>
      </div>

      <!-- Activity Logger -->
      <%= form_with url: admin_job_posting_pipeline_steps_path(@job_posting), class: "space-y-3 mb-10" do |f| %>
        <%= f.text_area :note, placeholder: "LOG_RESEARCH_CONTEXT...", class: "textarea textarea-bordered bg-base-300 w-full rounded-xl text-[10px] font-mono", rows: 2 %>
        <%= f.text_field :link, placeholder: "EXTERNAL_LINK_URL...", class: "input input-bordered bg-base-300 w-full rounded-xl text-[10px] font-mono" %>
        <%= f.submit "APPEND_TO_TIMELINE", class: "w-full py-2 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest hover:bg-white/10 transition-all" %>
      <% end %>

      <!-- Timeline -->
      <div class="space-y-6">
        <% @job_posting.pipeline_steps.order(created_at: :desc).each do |step| %>
          <div class="relative pl-6 border-l border-white/5">
            <div class="absolute -left-[5px] top-0 w-2 h-2 rounded-full bg-primary/30"></div>
            <div class="text-[8px] font-black uppercase text-base-content/30 mb-1"><%= step.created_at.strftime("%Y_%m_%d | %H:%M") %></div>
            <div class="text-[10px] font-bold text-white uppercase tracking-wider"><%= step.status.humanize %></div>
            <% if step.note.present? %><p class="text-[10px] text-base-content/60 mt-1 leading-tight"><%= step.note %></p><% end %>
            <% if step.link.present? %><%= link_to "SOURCE_VIEW", step.link, class: "text-[8px] text-primary hover:underline mt-2 inline-block font-black" %><% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Contact Manager -->
    <div class="bg-base-200 border border-white/5 rounded-2xl p-8 shadow-2xl">
      <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 mb-8 pb-4 border-b border-white/5">Contact_Registry</h3>
      
      <div class="space-y-4 mb-8">
        <% @job_posting.contacts.each do |contact| %>
          <div class="bg-base-300 p-4 rounded-xl relative group">
            <div class="text-xs font-bold text-white"><%= contact.name %></div>
            <div class="text-[9px] font-black uppercase tracking-widest text-base-content/40 mt-1"><%= contact.role %></div>
            <%= button_to admin_job_posting_contact_path(@job_posting, contact), method: :delete, class: "absolute top-2 right-2 text-rose-500 opacity-0 group-hover:opacity-100 transition-opacity text-[8px] font-black", data: { turbo_confirm: "Delete contact?" } do %>X<% end %>
          </div>
        <% end %>
      </div>

      <%= form_with model: [@job_posting, Contact.new], url: admin_job_posting_contacts_path(@job_posting), class: "space-y-2" do |f| %>
        <%= f.text_field :name, placeholder: "NAME...", class: "input input-bordered w-full rounded-xl text-[10px] font-mono" %>
        <%= f.text_field :role, placeholder: "ROLE (RECRUITER/MANAGER)...", class: "input input-bordered w-full rounded-xl text-[10px] font-mono" %>
        <%= f.submit "ADD_CONTACT_NODE", class: "w-full py-2 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest hover:bg-white/10 transition-all" %>
      <% end %>
    </div>

    <!-- Telemetry & Synthesis -->
    <div class="bg-base-200 border border-white/5 rounded-2xl p-8 shadow-2xl">
      <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 mb-8 pb-4 border-b border-white/5">Operational_Telemetry</h3>
      
      <div class="space-y-8">
        <div>
          <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20 mb-3">Neural_Category</div>
          <% category = @job_posting.data&.[]('ai_category') %>
          <div class="flex items-center justify-between">
            <div class="inline-flex items-center gap-2 text-accent font-black text-[10px] uppercase tracking-wider">
              <%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %> <%= category || "PENDING_SYNTHESIS" %>
            </div>
            <% if category.blank? || params[:reprocess] %>
              <%= button_to "RE-SYNTHESIZE", admin_job_posting_path(@job_posting), params: { action_type: 'synthesize' }, method: :patch, class: "text-[8px] font-black text-primary hover:text-white underline" %>
            <% end %>
          </div>
        </div>

        <div>
          <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20 mb-3">Audit_History</div>
          <div class="space-y-2">
            <% @job_posting.versions.reverse.first(5).each do |version| %>
              <div class="text-[8px] font-mono text-base-content/40">
                <span class="text-white"><%= version.event.upcase %></span>_BY_<%= version.whodunnit || "SYSTEM" %> | <%= version.created_at.strftime("%H:%M:%S") %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>
