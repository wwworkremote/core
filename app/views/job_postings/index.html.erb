<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-10 mb-16">
  <div class="max-w-2xl">
    <h1 class="text-4xl font-black tracking-tight text-white mb-2 uppercase">Neural Job Market</h1>
    <p class="text-base-content/40 font-bold uppercase tracking-widest text-[10px]">Real-time aggregation of the global remote ecosystem</p>
    <div class="flex flex-wrap gap-2 mt-3">
      <% role_family_labels.each do |family, label| %>
        <% if @role_family == family.to_s %>
          <%= link_to "✕ #{label}", job_postings_path(q: @query, company: @company, source_id: @source_id),
              class: "btn btn-xs btn-warning rounded-lg font-black tracking-widest text-[10px]" %>
        <% else %>
          <%= link_to "🎯 #{label}",
              job_postings_path(q: @query, company: @company, source_id: @source_id, role_family: family),
              class: "btn btn-xs btn-outline btn-warning rounded-lg font-black tracking-widest text-[10px]" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="w-full lg:max-w-md">
    <div class="bg-base-200 p-1.5 rounded-xl shadow-2xl flex items-center border border-white/5 group focus-within:border-primary/50 transition-all">
      <%= form_with url: job_postings_path, method: :get, class: "flex w-full" do |f| %>
        <%= f.text_field :q, value: @query,
            placeholder: "Filter intelligence...",
            class: "flex-1 bg-transparent border-none text-white placeholder:text-base-content/20 px-4 py-2 focus:ring-0 text-sm font-bold tracking-tight",
            style: "caret-color: var(--color-primary);" %>
        <%= f.submit "ANALYZE", class: "btn btn-primary btn-sm rounded-lg font-black tracking-widest text-[10px] px-6" %>
      <% end %>
    </div>
  </div>
</div>

<% if @company.present? || @source_id.present? || @query.present? || @role_family.present? %>
  <div class="mb-10 flex flex-wrap items-center gap-3">
    <span class="text-[10px] font-black text-base-content/30 uppercase tracking-widest">Active_Filters:</span>
    <% if @role_family.present? %>
      <div class="badge badge-outline border-warning/30 text-warning gap-2 p-3 font-bold text-[10px] uppercase">
        Role: <%= role_family_labels[@role_family.to_sym] %>
        <%= link_to job_postings_path(q: @query, company: @company, source_id: @source_id), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @company.present? %>
      <div class="badge badge-outline border-primary/30 text-primary gap-2 p-3 font-bold text-[10px] uppercase">
        Company: <%= @company %>
        <%= link_to job_postings_path(q: @query, source_id: @source_id, role_family: @role_family), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @source_id.present? %>
      <div class="badge badge-outline border-secondary/30 text-secondary gap-2 p-3 font-bold text-[10px] uppercase">
        Source_ID: <%= @source_id %>
        <%= link_to job_postings_path(q: @query, company: @company, role_family: @role_family), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @query.present? %>
      <div class="badge badge-outline border-accent/30 text-accent gap-2 p-3 font-bold text-[10px] uppercase">
        Query: <%= @query %>
        <%= link_to job_postings_path(company: @company, source_id: @source_id, role_family: @role_family), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <%= link_to "PURGE_FILTERS", job_postings_path, class: "text-[10px] font-black text-error hover:underline ml-2 uppercase tracking-widest" %>
  </div>
<% end %>

<div class="space-y-4">
  <% if @job_postings.any? %>
    <div class="grid gap-4">
      <% @job_postings.each do |job| %>
        <article class="card bg-base-200 border border-white/5 hover:border-primary/30 hover:shadow-2xl transition-all group overflow-hidden relative">
          <div class="card-body p-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex-1 relative">
              <h4 class="text-lg font-black text-white group-hover:text-primary transition-colors mb-1 uppercase tracking-tight">
                <%= link_to job.title, job_posting_path(job), class: "before:absolute before:inset-0" %>
              </h4>
              <p class="text-secondary font-black text-[11px] tracking-[0.2em] mb-3 relative z-10">
                <%= link_to job.company_name&.upcase, job_postings_path(company: job.company_name), class: "hover:underline transition-all" %>
              </p>

              <% if job.location.present? %>
                <div class="flex items-center text-base-content/40 text-[10px] font-black uppercase tracking-widest gap-2">
                  <%= heroicon "map-pin", variant: :solid, options: { class: "w-3 h-3 text-primary" } %>
                  <%= job.location %>
                </div>
              <% end %>
            </div>

            <div class="flex md:flex-col items-center md:items-end justify-between md:justify-center gap-3 relative z-10">
              <%= link_to job_postings_path(source_id: job.source_id), class: "badge badge-neutral bg-base-300 border-white/10 hover:border-primary/50 text-[9px] font-black uppercase tracking-widest py-3 px-4 transition-all" do %>
                <%= job.source.try(:origin)&.name || 'NETWORK' %>
              <% end %>
              <div class="text-base-content/30 text-[9px] font-black uppercase tracking-tighter">
                <% published_time = job.published_at || job.created_at %>
                <%= time_ago_in_words(published_time).upcase %>_AGO
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-16 py-8 flex justify-center border-t border-white/5">
      <%= paginate @job_postings %>
    </div>
  <% else %>
    <div class="py-20 text-center bg-base-200 rounded-2xl border border-dashed border-white/10 max-w-xl mx-auto">
      <%= heroicon "magnifying-glass", options: { class: "w-12 h-12 text-base-content/10 mx-auto mb-6" } %>
      <h3 class="text-xl font-black text-white mb-2 uppercase">Zero_Signals_Detected</h3>
      <p class="text-base-content/30 font-bold text-xs uppercase tracking-widest mb-8">No job intelligence matches the current search parameters.</p>
      <%= link_to "RESET_NEURAL_CORPUS", job_postings_path, class: "btn btn-outline btn-sm rounded-lg font-black tracking-widest text-[10px]" %>
    </div>
  <% end %>
</div>
