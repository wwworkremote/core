<div class="row mb-5 align-items-center">
  <div class="col-md-7">
    <h1 class="display-4 fw-bold sparkle-ai">Remote Job Market</h1>
    <p class="text-muted lead">Aggregated signals from across the ecosystem.</p>
  </div>
  <div class="col-md-5">
    <div class="card glass border-0 p-2 shadow-lg">
      <%= form_with url: job_postings_path, method: :get, class: "d-flex" do |f| %>
        <%= f.text_field :q, value: @query, placeholder: "Query intelligence...", class: "form-control bg-transparent border-0 text-white shadow-none ps-3", style: "caret-color: var(--gemini-accent);" %>
        <%= f.submit "Analyze", class: "btn btn-primary rounded-pill px-4" %>
      <% end %>
    </div>
  </div>
</div>

<div class="row">
  <div class="col">
    <% if @job_postings.any? %>
      <div class="list-group list-group-flush gap-3">
        <% @job_postings.each do |job| %>
          <%= link_to job_posting_path(job), class: "card glass list-group-item-action border-0 p-4 text-decoration-none transition-all" do %>
            <div class="row align-items-center">
              <div class="col-md-8">
                <h4 class="h5 mb-1 text-white fw-bold"><%= job.title %></h4>
                <p class="mb-2 text-primary opacity-75 fw-medium"><%= job.company %></p>
                <% if job.location.present? %>
                  <div class="d-flex align-items-center text-muted small">
                    <i class="bi bi-geo-alt me-2 text-accent"></i>
                    <%= job.location %>
                  </div>
                <% end %>
              </div>
              <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="mb-2">
                  <span class="badge gemini-pill"><%= job.source.try(:origin)&.name || 'External' %></span>
                </div>
                <div class="text-muted small">
                  <%= time_ago_in_words(job.published_at) if job.published_at %> ago
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="mt-5 d-flex justify-content-center">
        <%= paginate @job_postings %>
      </div>
    <% else %>
      <div class="card glass border-0 py-5 text-center shadow-lg">
        <div class="card-body">
          <i class="bi bi-search display-1 text-muted opacity-25 mb-4 d-block"></i>
          <h3 class="fw-bold">No intelligence found</h3>
          <p class="text-muted">No signals matching your query were detected in the current corpus.</p>
          <%= link_to "Clear filters", job_postings_path, class: "btn btn-outline-primary btn-sm mt-3" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
