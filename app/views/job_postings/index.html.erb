<div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 lg:gap-10 mb-10 lg:mb-16">
  <div class="max-w-2xl">
    <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white mb-2"><%= t('.title') %></h1>
    <p class="text-base-content/60 font-bold text-sm"><%= t('.subtitle') %></p>
  </div>

  <div class="w-full lg:max-w-md">
    <div class="bg-base-200 p-3 rounded-xl shadow-2xl border border-white/5 group focus-within:border-primary/50 transition-all">
      <%= form_with url: job_postings_path, method: :get, class: "space-y-2",
          data: { controller: "filter-form", turbo_frame: "job_postings_results" } do |f| %>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <%= f.text_field :q, value: @query,
              placeholder: t('.search_placeholder'),
              class: "flex-1 bg-transparent border-none text-white placeholder:text-base-content/40 px-2 py-1 focus:ring-0 text-sm font-bold tracking-tight",
              style: "caret-color: var(--color-primary);",
              data: { action: "input->filter-form#submit" } %>
          <%= f.submit t('.search_submit'), class: "btn btn-primary btn-sm rounded-lg font-bold px-6 w-full sm:w-auto" %>
        </div>
        <div class="flex flex-col items-stretch gap-3 px-2 pt-2 border-t border-white/5 sm:flex-row sm:items-center">
          <%= heroicon "map-pin", variant: :solid, options: { class: "w-3 h-3 text-primary shrink-0" } %>
          <%= f.text_field :location, value: @location,
              placeholder: t('.location_placeholder'),
              class: "flex-1 bg-transparent border-none text-white placeholder:text-base-content/40 py-1 focus:ring-0 text-sm font-bold tracking-tight",
              data: { action: "input->filter-form#submit" } %>
          <label class="flex items-center gap-1.5 text-xs font-bold text-base-content/70 cursor-pointer shrink-0">
            <%= f.check_box :remote, { checked: @remote, class: "checkbox checkbox-xs checkbox-primary",
                data: { action: "change->filter-form#submit" } }, "1", "0" %>
            <%= t('.remote_filter_label') %>
          </label>
          <label class="flex items-center gap-1.5 text-xs font-bold text-base-content/70 cursor-pointer shrink-0">
            <%= f.check_box :contract, { checked: @contract, class: "checkbox checkbox-xs checkbox-primary",
                data: { action: "change->filter-form#submit" } }, "1", "0" %>
            <%= t('.contract_filter_label') %>
          </label>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= turbo_frame_tag "job_postings_results", class: "block" do %>
  <div class="flex flex-wrap gap-2 mb-6 lg:mb-10">
    <% if @sort == "match_score" %>
      <%= link_to "✕ #{t('.sort_match_score')}", job_postings_path(active_filter_params.except(:sort)),
          class: "btn btn-xs btn-primary rounded-lg font-bold" %>
    <% else %>
      <%= link_to t('.sort_match_score'), job_postings_path(active_filter_params.merge(sort: "match_score")),
          class: "btn btn-xs btn-outline btn-primary rounded-lg font-bold" %>
    <% end %>
    <% if @sort == "company" %>
      <%= link_to "✕ #{t('.sort_company')}", job_postings_path(active_filter_params.except(:sort)),
          class: "btn btn-xs btn-primary rounded-lg font-bold" %>
    <% else %>
      <%= link_to t('.sort_company'), job_postings_path(active_filter_params.merge(sort: "company")),
          class: "btn btn-xs btn-outline btn-primary rounded-lg font-bold" %>
    <% end %>
    <% role_family_labels.each do |family, label| %>
      <% if @role_family == family.to_s %>
        <%= link_to "✕ #{label}", job_postings_path(active_filter_params.except(:role_family)),
            class: "btn btn-xs btn-warning rounded-lg font-bold" %>
      <% else %>
        <%= link_to label, job_postings_path(active_filter_params.merge(role_family: family)),
            class: "btn btn-xs btn-outline btn-warning rounded-lg font-bold" %>
      <% end %>
    <% end %>
  </div>

<% if active_filter_params.values.any?(&:present?) %>
  <div class="mb-10 flex flex-wrap items-center gap-3">
    <span class="text-xs font-bold text-base-content/50"><%= t('.active_filters_label') %></span>
    <% if @role_family.present? %>
      <div class="badge badge-outline border-warning/30 text-warning gap-2 p-3 font-bold text-xs">
        <%= t('.role_filter_label') %> <%= role_family_labels[@role_family.to_sym] %>
        <%= link_to job_postings_path(active_filter_params.except(:role_family)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @company.present? %>
      <div class="badge badge-outline border-primary/30 text-primary gap-2 p-3 font-bold text-xs">
        <%= t('.company_filter_label') %> <%= @company %>
        <%= link_to job_postings_path(active_filter_params.except(:company)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @source_id.present? %>
      <div class="badge badge-outline border-secondary/30 text-secondary gap-2 p-3 font-bold text-xs">
        <%= t('.source_filter_label') %> <%= @source_name || "##{@source_id}" %>
        <%= link_to job_postings_path(active_filter_params.except(:source_id)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
      <%= button_to t('.mark_source_not_interested', source: @source_name || "##{@source_id}"), mark_not_interested_admin_job_source_path(@source_id),
          class: "text-xs font-bold text-error hover:underline",
          form: { data: { turbo_frame: "_top" } },
          data: { turbo_confirm: "Mark all open #{@source_name || "##{@source_id}"} postings not interested? This can't be undone." } %>
    <% end %>
    <% if @query.present? %>
      <div class="badge badge-outline border-accent/30 text-accent gap-2 p-3 font-bold text-xs">
        <%= t('.query_filter_label') %> <%= @query %>
        <%= link_to job_postings_path(active_filter_params.except(:q)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @location.present? %>
      <div class="badge badge-outline border-success/30 text-success gap-2 p-3 font-bold text-xs">
        <%= t('.location_filter_label') %> <%= @location %>
        <%= link_to job_postings_path(active_filter_params.except(:location)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @remote %>
      <div class="badge badge-outline border-success/30 text-success gap-2 p-3 font-bold text-xs">
        <%= t('.remote_active_label') %>
        <%= link_to job_postings_path(active_filter_params.except(:remote)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <% if @contract %>
      <div class="badge badge-outline border-success/30 text-success gap-2 p-3 font-bold text-xs">
        <%= t('.contract_active_label') %>
        <%= link_to job_postings_path(active_filter_params.except(:contract)), class: "hover:text-white" do %><%= heroicon "x-mark", options: { class: "w-3 h-3" } %><% end %>
      </div>
    <% end %>
    <%= link_to t('.clear_filters'), job_postings_path, class: "text-xs font-bold text-error hover:underline ml-2" %>
  </div>
<% end %>

<div class="space-y-4">
  <% if @job_postings.any? %>
    <div class="grid gap-4 2xl:grid-cols-2">
      <% @job_postings.each do |job| %>
        <article id="<%= dom_id(job) %>" class="card bg-base-200 border border-white/5 hover:border-primary/30 hover:shadow-2xl transition-all group overflow-hidden relative">
          <div class="absolute top-3 right-3 z-10 flex gap-1">
            <% if job.may_expire? %>
              <%= button_to admin_job_posting_pipeline_steps_path(job), params: { status: 'expire', remove_card: true },
                  form: { data: { turbo_stream: true } },
                  title: t('.expired'),
                  class: "btn btn-ghost btn-xs btn-circle text-base-content/40 hover:text-warning hover:bg-warning/10" do %>
                <%= heroicon "clock", options: { class: "w-4 h-4" } %>
              <% end %>
            <% end %>
            <% if job.may_ignore? %>
              <%= button_to admin_job_posting_pipeline_steps_path(job), params: { status: 'ignore', remove_card: true },
                  form: { data: { turbo_stream: true } },
                  title: t('.not_interested'),
                  class: "btn btn-ghost btn-xs btn-circle text-base-content/40 hover:text-error hover:bg-error/10" do %>
                <%= heroicon "x-mark", options: { class: "w-4 h-4" } %>
              <% end %>
            <% end %>
          </div>
          <div class="card-body p-4 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6">
            <div class="flex-1 relative">
              <h4 class="text-lg font-black text-white group-hover:text-primary transition-colors mb-1">
                <%= link_to job.title, job_posting_path(job), data: { turbo_frame: "_top" }, class: "before:absolute before:inset-0" %>
              </h4>
              <p class="text-secondary font-bold text-sm mb-3 relative z-10">
                <% if (company_name = job.company.presence&.to_s) %>
                  <%= link_to company_name, job_postings_path(company: company_name), class: "hover:underline transition-all" %>
                <% else %>
                  <span class="text-base-content/40 italic"><%= t('.unknown_company') %></span>
                <% end %>
              </p>

              <% if job.location.present? %>
                <div class="flex items-center text-base-content/60 text-xs font-bold gap-2">
                  <%= heroicon "map-pin", variant: :solid, options: { class: "w-3 h-3 text-primary" } %>
                  <%= job.location %>
                </div>
              <% end %>

              <% if @sort == "match_score" && job.respond_to?(:current_match_score) && job.current_match_score %>
                <div class="flex flex-wrap items-center gap-2 mt-2">
                  <span class="badge badge-sm bg-primary/20 text-primary border-primary/30 font-bold">
                    <%= t('.match_score', score: job.current_match_score) %>
                  </span>
                  <% job.current_match_tags.to_a.each do |tag| %>
                    <span class="badge badge-sm badge-outline border-white/10 text-base-content/60 font-bold"><%= tag %></span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="flex md:flex-col items-center md:items-end justify-between md:justify-center gap-3 relative z-10">
              <%= link_to job_postings_path(source_id: job.source_id), class: "badge badge-neutral bg-base-300 border-white/10 hover:border-primary/50 text-xs font-bold py-3 px-4 transition-all" do %>
                <%= job.source.try(:origin)&.name || t('.network_fallback') %>
              <% end %>
              <div class="text-base-content/50 text-xs font-bold">
                <% published_time = job.published_at || job.created_at %>
                <%= t('.posted_ago', time: time_ago_in_words(published_time)) %>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-16 py-8 flex justify-center border-t border-white/5">
      <%= paginate @job_postings %>
    </div>
  <% else %>
    <div class="py-20 text-center bg-base-200 rounded-2xl border border-dashed border-white/10 max-w-xl mx-auto">
      <%= heroicon "magnifying-glass", options: { class: "w-12 h-12 text-base-content/20 mx-auto mb-6" } %>
      <h3 class="text-xl font-black text-white mb-2"><%= t('.empty.title') %></h3>
      <p class="text-base-content/50 font-bold text-sm mb-8"><%= t('.empty.body') %></p>
      <%= link_to t('.empty.reset'), job_postings_path, class: "btn btn-outline btn-sm rounded-lg font-bold" %>
    </div>
  <% end %>
</div>
<% end %>
