<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-12">
  <div class="max-w-2xl">
    <h1 class="text-5xl font-black tracking-tight sparkle-ai mb-3 text-white">Remote Job Market</h1>
    <p class="text-slate-400 text-lg">Real-time signals aggregated from across the global ecosystem.</p>
  </div>
  
  <div class="w-full lg:max-w-md">
    <div class="glass p-1.5 rounded-2xl shadow-2xl flex items-center group focus-within:ring-2 focus-within:ring-violet-500/50 transition-all">
      <%= form_with url: job_postings_path, method: :get, class: "flex w-full" do |f| %>
        <%= f.text_field :q, value: @query, 
            placeholder: "Filter intelligence...", 
            class: "flex-1 bg-transparent border-0 text-white placeholder:text-slate-500 px-4 py-2 focus:ring-0 text-sm",
            style: "caret-color: var(--color-gemini-accent);" %>
        <%= f.submit "Analyze", class: "btn-neural !px-5 !py-2 !text-sm !rounded-xl" %>
      <% end %>
    </div>
  </div>
</div>

<% if @company.present? || @source_id.present? || @query.present? %>
  <div class="mb-6 flex items-center gap-3">
    <span class="text-sm font-bold text-slate-500 uppercase tracking-widest">Active Filters:</span>
    <% if @company.present? %>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-bold">
        Company: <%= @company %>
        <%= link_to job_postings_path(q: @query, source_id: @source_id), class: "hover:text-white" do %><i class="bi bi-x-circle"></i><% end %>
      </span>
    <% end %>
    <% if @source_id.present? %>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 text-violet-400 border border-violet-500/20 text-xs font-bold">
        Source ID: <%= @source_id %>
        <%= link_to job_postings_path(q: @query, company: @company), class: "hover:text-white" do %><i class="bi bi-x-circle"></i><% end %>
      </span>
    <% end %>
    <% if @query.present? %>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold">
        Query: <%= @query %>
        <%= link_to job_postings_path(company: @company, source_id: @source_id), class: "hover:text-white" do %><i class="bi bi-x-circle"></i><% end %>
      </span>
    <% end %>
    <%= link_to "Clear All", job_postings_path, class: "text-xs font-bold text-rose-400 hover:text-rose-300 underline underline-offset-4 ml-2" %>
  </div>
<% end %>

<div class="space-y-4">
  <% if @job_postings.any? %>
    <div class="grid gap-4">
      <% @job_postings.each do |job| %>
        <article class="card-neural p-6 group relative">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1">
              <h4 class="text-xl font-bold text-white group-hover:text-violet-400 transition-colors mb-1">
                <%= link_to job.title, job_posting_path(job), class: "before:absolute before:inset-0" %>
              </h4>
              <p class="text-blue-400 font-semibold text-sm mb-3 tracking-wide relative z-10">
                <%= link_to job.company, job_postings_path(company: job.company), class: "hover:text-blue-300 hover:underline transition-colors" %>
              </p>
              
              <% if job.location.present? %>
                <div class="flex items-center text-slate-400 text-xs font-medium gap-2">
                  <i class="bi bi-geo-alt text-violet-500"></i>
                  <%= job.location %>
                </div>
              <% end %>
            </div>

            <div class="flex md:flex-col items-center md:items-end justify-between md:justify-center gap-3 relative z-10">
              <%= link_to job_postings_path(source_id: job.source_id), class: "px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-black uppercase tracking-widest text-slate-300 hover:bg-violet-500/20 hover:text-violet-400 hover:border-violet-500/30 transition-colors" do %>
                <%= job.source.try(:origin)&.name || 'Network' %>
              <% end %>
              <div class="text-slate-500 text-[11px] font-medium">
                <%= time_ago_in_words(job.published_at) if job.published_at %> ago
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-12 py-8 flex justify-center border-t border-white/5 relative z-20">
      <%= paginate @job_postings, window: 2 %>
    </div>
  <% else %>
    <div class="card-neural py-20 text-center max-w-xl mx-auto">
      <div class="bg-slate-800/30 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 border border-white/5">
        <i class="bi bi-search text-3xl text-slate-600"></i>
      </div>
      <h3 class="text-2xl font-bold text-white mb-2">No signals detected</h3>
      <p class="text-slate-500 mb-8 px-8">No job intelligence matching your current filters was found in the neural corpus.</p>
      <%= link_to "Reset All Filters", job_postings_path, class: "text-violet-400 hover:text-violet-300 font-bold text-sm underline underline-offset-8 transition-all" %>
    </div>
  <% end %>
</div>
