<% content_for :title, "#{@company.name} | WWWorkRemote" %>

<div class="mb-10 text-[10px] font-black uppercase tracking-[0.2em] opacity-40">
  <div class="flex items-center gap-3">
    <%= link_to "Job_Market", job_postings_path, class: "hover:text-primary transition-all" %>
    <i class="bi bi-chevron-right text-[8px]"></i>
    <span class="text-white">Organization_Node_<%= @company.id %></span>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
  <article class="lg:col-span-2 space-y-8">
    <header class="bg-base-200 border border-white/5 rounded-2xl p-10 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-5">
        <%= heroicon "building-office", options: { class: "w-32 h-32" } %>
      </div>
      
      <div class="relative z-10">
        <h1 class="text-4xl font-black text-white mb-3 uppercase tracking-tight leading-none"><%= @company.name %></h1>
        <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Company Intelligence Hub</p>
      </div>
    </header>

    <div class="bg-base-200 border border-white/5 rounded-2xl p-10 shadow-2xl">
      <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-base-content/30 mb-10 pb-4 border-b border-white/5">Associated_Postings</h2>
      
      <div class="grid grid-cols-1 gap-4">
        <% @company.job_postings.order(published_at: :desc).each do |job| %>
          <div class="card-neural p-6 hover:border-primary/50 transition-all group flex items-center justify-between">
            <div>
              <h4 class="text-lg font-black text-white group-hover:text-primary transition-colors"><%= link_to job.title, job_posting_path(job) %></h4>
              <div class="text-[9px] font-black uppercase text-slate-500 mt-1">
                <%= job.location || "REMOTE" %> | <%= job.published_at&.to_date || job.created_at.to_date %>
              </div>
            </div>
            <%= link_to "VIEW_NODE", job_posting_path(job), class: "btn btn-xs rounded-lg bg-white/5 text-[9px] font-black uppercase tracking-widest border-none hover:bg-white/10" %>
          </div>
        <% end %>
        <% if @company.job_postings.empty? %>
          <div class="text-center py-10 opacity-30 text-[10px] font-black uppercase italic">NO_ACTIVE_POSTINGS_IN_REGISTRY</div>
        <% end %>
      </div>
    </div>
  </article>

  <aside class="space-y-8">
    <!-- Pipeline Control -->
    <div class="bg-base-200 border border-white/5 rounded-2xl p-8 shadow-2xl">
      <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 mb-8 pb-4 border-b border-white/5">Research_Timeline</h3>
      
      <!-- Activity Logger -->
      <%= form_with url: admin_company_company_pipeline_steps_path(@company), class: "space-y-3 mb-10" do |f| %>
        <%= f.text_area :note, placeholder: "LOG_RESEARCH_CONTEXT...", class: "textarea textarea-bordered bg-base-300 w-full rounded-xl text-[10px] font-mono", rows: 2 %>
        <%= f.submit "APPEND_TO_TIMELINE", class: "w-full py-2 rounded-xl bg-white/5 text-[9px] font-black uppercase tracking-widest hover:bg-white/10 transition-all" %>
      <% end %>

      <!-- Timeline -->
      <div class="space-y-6">
        <% @company.company_pipeline_steps.order(created_at: :desc).each do |step| %>
          <div class="relative pl-6 border-l border-white/5">
            <div class="absolute -left-[5px] top-0 w-2 h-2 rounded-full bg-primary/30"></div>
            <div class="text-[8px] font-black uppercase text-base-content/30 mb-1"><%= step.created_at.strftime("%Y_%m_%d | %H:%M") %></div>
            <div class="text-[10px] font-bold text-white uppercase tracking-wider"><%= step.status.humanize %></div>
            <% if step.note.present? %><p class="text-[10px] text-base-content/60 mt-1 leading-tight"><%= step.note %></p><% end %>
          </div>
        <% end %>
      </div>
    </div>
  </aside>
</div>
