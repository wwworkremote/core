<% content_for :title, "Companies | WWWorkRemote" %>

<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
  <div>
    <h1 class="text-4xl font-black text-white mb-2 tracking-tight"><%= t('.title') %></h1>
    <p class="text-slate-500 font-bold text-sm"><%= t('.subtitle') %></p>
  </div>
  <%= form_with url: companies_path, method: :get, class: "w-full md:max-w-xl space-y-3" do |f| %>
    <div class="flex gap-2">
      <%= f.search_field :q, value: @query, placeholder: "Search companies…", class: "input input-bordered bg-base-200 border-white/10 flex-1" %>
      <%= f.submit "Search", class: "btn btn-primary" %>
    </div>
    <div class="flex flex-wrap gap-3 text-xs font-bold text-base-content/70">
      <label><%= check_box_tag :active, "1", params[:active] == "1", class: "checkbox checkbox-xs checkbox-primary mr-1" %> Active only</label>
      <label><%= check_box_tag :flagged, "1", params[:flagged] == "1", class: "checkbox checkbox-xs checkbox-primary mr-1" %> Flagged</label>
      <label><%= check_box_tag :cooldown, "1", params[:cooldown] == "1", class: "checkbox checkbox-xs checkbox-primary mr-1" %> Declined recently</label>
      <%= link_to "Clear", companies_path, class: "text-error hover:underline" %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
  <% @companies.each do |company| %>
    <div class="group card-neural p-6 h-full hover:border-primary/50 transition-all relative overflow-hidden">
      <% if company.ingestion_enabled? %>
        <%= button_to mark_not_interested_admin_company_path(company),
            form: { class: "absolute top-3 right-3 z-20" },
            title: t('.not_interested'),
            class: "btn btn-ghost btn-xs btn-circle text-base-content/40 hover:text-error hover:bg-error/10",
            data: { turbo_confirm: "Mark #{company.name} not interested? Open postings will be ignored and future postings will be skipped automatically." } do %>
          <%= heroicon "x-mark", options: { class: "w-4 h-4" } %>
        <% end %>
      <% end %>

      <div class="relative z-10">
        <h3 class="text-lg font-black text-white group-hover:text-primary transition-colors truncate">
          <%= link_to company.name, company_path(company), class: "before:absolute before:inset-0" %>
        </h3>
        <p class="text-xs text-slate-500 font-bold mt-1">Company profile and postings</p>

        <div class="flex items-center justify-between mt-6 pt-4 border-t border-white/5">
          <div class="flex flex-col">
            <span class="text-xs font-bold text-slate-500"><%= t('.open_postings') %></span>
            <span class="text-xl font-black text-white"><%= company.job_postings_count %></span>
          </div>
          <div class="flex flex-wrap justify-end gap-1">
            <% if company.toxic_culture_flag %><span class="badge badge-error text-xs font-bold"><%= t('.toxicity_alert') %></span><% end %>
            <% if company.in_cooldown? %><span class="badge badge-outline border-warning/40 text-warning text-xs font-bold"><%= t('.cooldown_alert') %></span><% end %>
          </div>
        </div>
      </div>

      <div class="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
        <%= heroicon "building-office", options: { class: "w-16 h-16" } %>
      </div>
    </div>
  <% end %>
</div>

<div class="flex justify-center mt-12 pb-20">
  <%= paginate @companies %>
</div>
