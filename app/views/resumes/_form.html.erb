<div class="max-w-4xl mx-auto py-10 px-6">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to t('.breadcrumb_home'), root_path, class: "hover:text-primary transition-all" %>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
      <%= link_to t('.breadcrumb_resumes'), resumes_path, class: "hover:text-primary transition-all" %>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
      <span class="text-white"><%= @resume.new_record? ? t('.breadcrumb_new') : t('.breadcrumb_edit') %></span>
    </div>
  </div>

  <div class="mb-12">
    <h1 class="text-4xl font-black text-white tracking-tight leading-none mb-3">
      <%= @resume.new_record? ? t('.new_title') : t('.edit_title') %>
    </h1>
    <p class="text-slate-500 font-bold text-sm"><%= t('.subtitle') %></p>
  </div>

  <div class="card-neural p-8">
    <%= form_with(model: @resume, class: "space-y-8") do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="form-control">
          <%= f.label :name, t('.name_label'), class: "label text-xs font-bold text-slate-500" %>
          <%= f.text_field :name, placeholder: "e.g., Senior Backend Engineer", class: "input input-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
          <label class="label">
            <span class="label-text-alt text-xs text-slate-500"><%= t('.name_helper') %></span>
          </label>
        </div>

        <div class="form-control">
          <%= f.label :status, t('.status_label'), class: "label text-xs font-bold text-slate-500" %>
          <%= f.select :status, Resume.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "select select-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white" %>
        </div>
      </div>

      <div class="form-control">
        <%= f.label :content, t('.content_label'), class: "label text-xs font-bold text-slate-500" %>
        <%= f.text_area :content, value: @resume.content.to_json, rows: 15, class: "textarea textarea-bordered bg-white/5 border-white/10 rounded-xl focus:border-primary text-white font-mono text-xs leading-relaxed", placeholder: '{"summary": "...", "experience": []}' %>
        <label class="label">
          <span class="label-text-alt text-xs text-slate-500"><%= t('.content_helper') %></span>
        </label>
      </div>

      <div class="pt-6 border-t border-white/5 flex justify-end gap-4">
        <%= link_to t('.cancel'), resumes_path, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold" %>
        <%= f.submit (@resume.new_record? ? t('.create') : t('.update')), class: "btn btn-primary rounded-xl px-10 font-bold" %>
      </div>
    <% end %>
  </div>
</div>
