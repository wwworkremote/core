<%= render "admin/shared/nav" if current_user.admin? %>

<div class="max-w-6xl mx-auto py-10 px-6">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to t('.breadcrumb_home'), root_path, class: "hover:text-primary transition-all" %>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
      <span class="text-white"><%= t('.breadcrumb_current') %></span>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl font-black text-white mb-3 tracking-tight leading-none"><%= t('.title') %></h1>
      <p class="text-slate-500 font-bold text-sm"><%= t('.subtitle') %></p>
    </div>
    <div class="flex gap-4">
      <%= button_to t('.import'), resumes_path(import_url: "https://just3ws.github.io/resume.json"), class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold hover:text-accent hover:border-accent/50" %>
      <%= link_to t('.new_resume'), new_resume_path, class: "btn btn-primary rounded-xl px-10 font-bold" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @resumes.group_by(&:name).each do |name, versions| %>
      <div class="card-neural p-8 border-t-2 border-primary/20">
        <h3 class="text-xl font-black text-white tracking-tight mb-2"><%= name %></h3>
        <div class="text-xs font-bold text-slate-500 mb-6"><%= t('.versions_count', count: versions.count) %></div>

        <div class="space-y-4">
          <% versions.each do |resume| %>
            <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/5 hover:border-primary/30 transition-all group">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-bold text-white">v<%= resume.version %></span>
                  <% if resume.active? %>
                    <span class="badge badge-success badge-xs text-xs font-bold"><%= t('.active') %></span>
                  <% end %>
                </div>
                <div class="text-xs font-bold text-slate-500"><%= resume.created_at.strftime("%b %-d, %Y") %></div>
              </div>
              <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <%= link_to resume_path(resume), class: "btn btn-square btn-ghost btn-xs text-primary" do %>
                  <%= heroicon "eye", variant: :outline, options: { class: "w-4 h-4" } %>
                <% end %>
                <%= button_to fork_resume_path(resume), method: :post, class: "btn btn-square btn-ghost btn-xs text-accent", title: t('.fork') do %>
                  <%= heroicon "document-duplicate", variant: :outline, options: { class: "w-4 h-4" } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
