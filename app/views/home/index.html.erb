<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">Operational Overview</h1>
    <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Real-time system telemetry and node status</p>
  </div>
  <div>
    <%= link_to data_fetchers_path, class: "btn-neural flex items-center gap-2" do %>
      <i class="bi bi-cpu"></i> MANAGE_INGESTION_NODES
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mb-12">
  <!-- Ingestion Telemetry -->
  <div class="space-y-6">
    <div class="flex items-center gap-4 opacity-50 px-2">
      <h2 class="text-[10px] font-black uppercase tracking-[0.3em]">Telemetry_Ingestion</h2>
      <div class="h-px flex-1 bg-white/10"></div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <% [
        { label: "1H_VOL", count: Source.where(created_at: 1.hour.ago..).count, color: "text-violet-500" },
        { label: "24H_VOL", count: Source.where(created_at: 1.day.ago..).count, color: "text-violet-400" },
        { label: "7D_VOL", count: Source.where(created_at: 1.week.ago..).count, color: "text-violet-300" }
      ].each do |metric| %>
        <div class="card-neural p-4 border-l-2 border-l-violet-500/50">
          <div class="text-2xl font-black text-white mb-1"><%= metric[:count] %></div>
          <div class="text-[9px] font-black text-slate-500 tracking-tighter"><%= metric[:label] %></div>
        </div>
      <% end %>
    </div>

    <div class="card-neural p-6">
      <div class="flex justify-between items-center mb-6">
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Node_Velocity_Map</span>
        <span class="text-[9px] px-2 py-0.5 rounded bg-violet-500/10 text-violet-500 border border-violet-500/20 font-bold">REAL_TIME</span>
      </div>
      <%= line_chart(charts_data_sources_path(days: 21), 
          discrete: true, 
          height: "180px",
          colors: ["#8b5cf6"],
          library: { 
            scales: { 
              y: { grid: { color: "rgba(255,255,255,0.02)" }, ticks: { color: "#475569", font: { size: 9, weight: 'bold' } } },
              x: { grid: { display: false }, ticks: { color: "#475569", font: { size: 9, weight: 'bold' } } }
            },
            plugins: { legend: { display: false } }
          }) %>
    </div>
  </div>

  <!-- Processing Telemetry -->
  <div class="space-y-6">
    <div class="flex items-center gap-4 opacity-50 px-2">
      <h2 class="text-[10px] font-black uppercase tracking-[0.3em]">Telemetry_Synthesis</h2>
      <div class="h-px flex-1 bg-white/10"></div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <% [
        { label: "NEW_SIGNALS", count: JobPosting.where(published_at: 1.hour.ago..).count, color: "text-blue-500" },
        { label: "DAILY_SYNC", count: JobPosting.where(published_at: 1.day.ago..).count, color: "text-blue-400" },
        { label: "STALE_JOBS", count: JobPosting.where('published_at < ?', 30.days.ago).count, color: "text-slate-500" }
      ].each do |metric| %>
        <div class="card-neural p-4 border-l-2 border-l-blue-500/50">
          <div class="text-2xl font-black text-white mb-1"><%= metric[:count] %></div>
          <div class="text-[9px] font-black text-slate-500 tracking-tighter"><%= metric[:label] %></div>
        </div>
      <% end %>
    </div>

    <div class="card-neural p-6">
      <div class="flex justify-between items-center mb-6">
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Market_Distribution_Curve</span>
        <span class="text-[9px] px-2 py-0.5 rounded bg-blue-500/10 text-blue-500 border border-blue-500/20 font-bold">SYNTHETIC_SCAN</span>
      </div>
      <%= line_chart(charts_data_job_postings_path(days: 21), 
          discrete: true, 
          height: "180px",
          colors: ["#3b82f6"],
          library: { 
            scales: { 
              y: { grid: { color: "rgba(255,255,255,0.02)" }, ticks: { color: "#475569", font: { size: 9, weight: 'bold' } } },
              x: { grid: { display: false }, ticks: { color: "#475569", font: { size: 9, weight: 'bold' } } }
            },
            plugins: { legend: { display: false } }
          }) %>
    </div>
  </div>
</div>
