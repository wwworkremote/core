<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h1 class="text-3xl font-black tracking-tight text-white mb-1 uppercase">Operational Overview</h1>
    <p class="text-base-content/50 font-bold uppercase tracking-widest text-[10px]">Real-time system telemetry and node status</p>
  </div>
  <div class="flex items-center gap-3">
    <div class="badge badge-outline border-white/10 gap-2 px-4 py-3 font-mono text-[10px]">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> SYSTEM_LIVE
    </div>
  </div>
</div>

<div class="space-y-12">
  <!-- Ingestion Telemetry -->
  <section>
    <div class="flex items-center gap-4 mb-6 opacity-30">
      <h2 class="text-[10px] font-black uppercase tracking-[0.3em]">Telemetry_Ingestion</h2>
      <div class="h-px flex-1 bg-white/10"></div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <div class="xl:col-span-2">
        <div class="stats stats-vertical lg:stats-horizontal shadow-2xl bg-base-200/50 border border-white/5 w-full">
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">1H_VOL</div>
            <div class="stat-value text-primary text-4xl font-black tracking-tighter"><%= Source.where(created_at: 1.hour.ago..).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Sync_Buffer</div>
          </div>
          
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">24H_VOL</div>
            <div class="stat-value text-secondary text-4xl font-black tracking-tighter"><%= Source.where(created_at: 1.day.ago..).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Node_Payload</div>
          </div>
          
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">7D_VOL</div>
            <div class="stat-value text-accent text-4xl font-black tracking-tighter"><%= Source.where(created_at: 1.week.ago..).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Network_Growth</div>
          </div>
        </div>
      </div>

      <div class="card bg-base-200/50 border border-white/5 shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-white/5 flex justify-between items-center bg-base-300/30">
          <span class="text-[9px] font-black uppercase tracking-widest opacity-40">Node_Velocity</span>
          <span class="badge badge-primary badge-xs rounded font-black tracking-widest px-2 py-2 text-[8px]">ACTIVE</span>
        </div>
        <div class="p-4">
          <%= line_chart(charts_data_sources_path(days: 21), 
              discrete: true, 
              height: "120px",
              colors: ["#bd93f9"],
              library: { 
                scales: { 
                  y: { display: false },
                  x: { display: false }
                },
                plugins: { legend: { display: false } }
              }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- Synthesis Telemetry -->
  <section>
    <div class="flex items-center gap-4 mb-6 opacity-30">
      <h2 class="text-[10px] font-black uppercase tracking-[0.3em]">Telemetry_Synthesis</h2>
      <div class="h-px flex-1 bg-white/10"></div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <div class="xl:col-span-2">
        <div class="stats stats-vertical lg:stats-horizontal shadow-2xl bg-base-200/50 border border-white/5 w-full">
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">NEW_SIGNALS</div>
            <div class="stat-value text-info text-4xl font-black tracking-tighter"><%= JobPosting.where(published_at: 1.hour.ago..).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Neural_Pulse</div>
          </div>
          
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">DAILY_SYNC</div>
            <div class="stat-value text-success text-4xl font-black tracking-tighter"><%= JobPosting.where(published_at: 1.day.ago..).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Market_Inflow</div>
          </div>
          
          <div class="stat px-8 py-6">
            <div class="stat-title text-[10px] font-black uppercase tracking-widest opacity-40">STALE_NODES</div>
            <div class="stat-value text-slate-500 text-4xl font-black tracking-tighter"><%= JobPosting.where('published_at < ?', 30.days.ago).count %></div>
            <div class="stat-desc font-bold text-[9px] opacity-30 mt-1 italic">Prune_Queue</div>
          </div>
        </div>
      </div>

      <div class="card bg-base-200/50 border border-white/5 shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-white/5 flex justify-between items-center bg-base-300/30">
          <span class="text-[9px] font-black uppercase tracking-widest opacity-40">Distribution_Curve</span>
          <span class="badge badge-info badge-xs rounded font-black tracking-widest px-2 py-2 text-[8px]">STABLE</span>
        </div>
        <div class="p-4">
          <%= line_chart(charts_data_job_postings_path(days: 21), 
              discrete: true, 
              height: "120px",
              colors: ["#8be9fd"],
              library: { 
                scales: { 
                  y: { display: false },
                  x: { display: false }
                },
                plugins: { legend: { display: false } }
              }) %>
        </div>
      </div>
    </div>
  </section>
</div>
