<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
  <div>
    <h1 class="text-4xl font-black tracking-tight text-white mb-2 uppercase italic italic">Neural_Market_Intelligence</h1>
    <p class="text-base-content/40 font-bold uppercase tracking-widest text-[10px]">Autonomous Remote Job Synthesis & Strategic Alignment</p>
  </div>
  <div class="flex gap-4">
    <%= link_to career_profile_path, class: "btn btn-outline btn-sm rounded-lg font-black uppercase tracking-widest text-[10px]" do %>
      <%= heroicon "user-circle", options: { class: "w-4 h-4" } %> IDENTITY_SYNC
    <% end %>
    <%= link_to data_fetchers_path, class: "btn btn-primary btn-sm rounded-lg font-black uppercase tracking-widest text-[10px]" do %>
      <%= heroicon "cpu-chip", options: { class: "w-4 h-4" } %> INGESTION_CONTROL
    <% end %>
  </div>
</div>

<!-- Platform Capabilities Overview -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
  <div class="card bg-base-200 border border-white/5 shadow-2xl relative overflow-hidden group">
    <div class="card-body p-8 relative z-10">
      <div class="text-[9px] font-black text-primary uppercase tracking-[0.3em] mb-4">Core_Capability_01</div>
      <h2 class="text-xl font-black text-white uppercase italic mb-4">Autonomous_Extraction</h2>
      <p class="text-xs text-slate-500 leading-relaxed font-bold mb-6">Mass-scale ingestion from global job boards, Resolve canonical signals, and archive low-quality data nodes automatically.</p>
      <%= link_to job_postings_path, class: "btn btn-ghost btn-xs p-0 text-primary hover:bg-transparent font-black tracking-widest" do %>
        BROWSE_MARKET <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>
    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
      <%= heroicon "globe-alt", options: { class: "w-24 h-24" } %>
    </div>
  </div>

  <div class="card bg-base-200 border border-white/5 shadow-2xl relative overflow-hidden group border-primary/20">
    <div class="card-body p-8 relative z-10">
      <div class="text-[9px] font-black text-secondary uppercase tracking-[0.3em] mb-4">Core_Capability_02</div>
      <h2 class="text-xl font-black text-white uppercase italic mb-4">Neural_Alignment</h2>
      <p class="text-xs text-slate-500 leading-relaxed font-bold mb-6">Deep semantic matching between your professional identity and the global market. 80%+ confidence scoring for strategic priority.</p>
      <%= link_to user_job_postings_path, class: "btn btn-ghost btn-xs p-0 text-secondary hover:bg-transparent font-black tracking-widest" do %>
        VIEW_PIPELINE <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>
    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
      <%= heroicon "sparkles", options: { class: "w-24 h-24" } %>
    </div>
  </div>

  <div class="card bg-base-200 border border-white/5 shadow-2xl relative overflow-hidden group">
    <div class="card-body p-8 relative z-10">
      <div class="text-[9px] font-black text-accent uppercase tracking-[0.3em] mb-4">Core_Capability_03</div>
      <h2 class="text-xl font-black text-white uppercase italic mb-4">Operational_Transparency</h2>
      <p class="text-xs text-slate-500 leading-relaxed font-bold mb-6">Real-time telemetry on crawler velocity, database health, and background pipeline orchestration via Mission Control.</p>
      <%= link_to admin_root_path, class: "btn btn-ghost btn-xs p-0 text-accent hover:bg-transparent font-black tracking-widest" do %>
        ACCESS_CONTROL <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>
    <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
      <%= heroicon "adjustments-horizontal", options: { class: "w-24 h-24" } %>
    </div>
  </div>
</section>

<%= turbo_stream_from "system_telemetry" %>

<div class="grid grid-cols-1 gap-12">
  <!-- Priority In-Box Block -->
  <% if @priority_inbox.any? %>
    <section>
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-accent">Strategic_Priority_Inbox</h2>
        <div class="h-px flex-1 bg-accent/20"></div>
        <span class="badge badge-accent badge-xs font-black"><%= @priority_inbox.count %>_PENDING</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @priority_inbox.each do |user_job| %>
          <% job = user_job.job_posting %>
          <div class="card bg-base-200 border border-accent/10 hover:border-accent/50 transition-all shadow-xl group">
            <div class="card-body p-6">
              <div class="flex justify-between items-start mb-4">
                <div class="text-[9px] font-black uppercase text-slate-500 tracking-widest"><%= job.company_name %></div>
                <div class="badge badge-accent text-[8px] font-black tracking-tighter uppercase">High_Confidence</div>
              </div>
              <h3 class="text-md font-black text-white group-hover:text-accent transition-colors leading-tight mb-4">
                <%= link_to job.title, job_posting_path(job) %>
              </h3>
              <div class="mt-auto flex items-center justify-between">
                <div class="text-[9px] font-bold text-slate-600"><%= job.location || "REMOTE" %></div>
                <div class="flex gap-2">
                  <%= button_to "FAVORITE", user_job_postings_path(job_posting_id: job.id, status: 'favorited'), class: "text-[8px] font-black text-primary hover:underline uppercase" %>
                  <%= link_to "REVIEW", job_posting_path(job), class: "text-[8px] font-black text-slate-400 hover:text-white uppercase" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Personal Alignment Block -->
  <% if @top_matches.present? %>
    <section>
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-primary">Neural_Alignment_matches</h2>
        <div class="h-px flex-1 bg-primary/20"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @top_matches.each do |job| %>
          <div class="card bg-base-200 border border-primary/10 hover:border-primary/50 transition-all shadow-xl group">
            <div class="card-body p-6">
              <div class="flex justify-between items-start mb-4">
                <div class="text-[9px] font-black uppercase text-slate-500 tracking-widest"><%= job.company_name %></div>
                <div class="badge badge-primary badge-outline text-[8px] font-black tracking-tighter">AI_MATCH</div>
              </div>
              <h3 class="text-md font-black text-white group-hover:text-primary transition-colors leading-tight mb-4">
                <%= link_to job.title, job_posting_path(job) %>
              </h3>
              <div class="mt-auto flex items-center justify-between">
                <div class="text-[9px] font-bold text-slate-600"><%= job.location || "REMOTE" %></div>
                <%= link_to "ANALYZE", job_posting_path(job), class: "text-[9px] font-black text-primary hover:underline" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Ingestion Block -->
  <section>
    <div class="flex items-center gap-4 mb-6 opacity-20">
      <h2 class="text-[10px] font-black uppercase tracking-[0.4em]">Node_Ingestion</h2>
      <div class="h-px flex-1 bg-white/20"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <%= render "home/telemetry_ingestion" %>
      </div>

      <div class="card bg-base-200 border border-white/5 shadow-xl">
        <div class="card-body p-6">
          <h3 class="card-title text-[10px] font-black uppercase tracking-widest opacity-40 mb-4">Ingestion_Velocity</h3>
          <%= line_chart(charts_data_sources_path(days: 21),
              discrete: true,
              height: "140px",
              colors: ["#9580FF"],
              library: {
                scales: {
                  y: { display: false },
                  x: { display: false }
                },
                plugins: { legend: { display: false } }
              }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- Synthesis Block -->
  <section>
    <div class="flex items-center gap-4 mb-6 opacity-20">
      <h2 class="text-[10px] font-black uppercase tracking-[0.4em]">Node_Synthesis</h2>
      <div class="h-px flex-1 bg-white/20"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <%= render "home/telemetry_synthesis" %>
      </div>

      <div class="card bg-base-200 border border-white/5 shadow-xl">
        <div class="card-body p-6">
          <h3 class="card-title text-[10px] font-black uppercase tracking-widest opacity-40 mb-4">Market_Publication_Curve</h3>
          <%= line_chart(charts_data_job_postings_path(days: 21),
              discrete: true,
              height: "140px",
              colors: ["#80FFEA"],
              library: {
                scales: {
                  y: { display: false },
                  x: { display: false }
                },
                plugins: { legend: { display: false } }
              }) %>
        </div>
      </div>
    </div>
  </section>
</div>
