<div id="synthesis_stats" class="stats stats-vertical md:stats-horizontal w-full bg-base-200 shadow-xl border border-white/5">
  <div class="stat">
    <div class="stat-title text-xs font-bold opacity-60"><%= t('.last_hour') %></div>
    <div class="stat-value text-kanagawa-accent text-3xl"><%= JobPosting.where(published_at: 1.hour.ago..).count %></div>
    <div class="stat-desc font-bold text-xs text-kanagawa-accent/60"><%= t('.new_postings') %></div>
  </div>

  <div class="stat">
    <div class="stat-title text-xs font-bold opacity-60"><%= t('.last_24h') %></div>
    <div class="stat-value text-kanagawa-green text-3xl"><%= JobPosting.where(published_at: 1.day.ago..).count %></div>
    <div class="stat-desc font-bold text-xs text-kanagawa-green/60"><%= t('.new_postings') %></div>
  </div>

  <div class="stat !border-none">
    <div class="stat-title text-xs font-bold opacity-60"><%= t('.older_30d') %></div>
    <div class="stat-value text-kanagawa-text-dim text-3xl"><%= JobPosting.where('published_at < ?', 30.days.ago).count %></div>
    <div class="stat-desc font-bold text-xs text-kanagawa-text-dim/60"><%= t('.stale_postings') %></div>
  </div>
</div>
