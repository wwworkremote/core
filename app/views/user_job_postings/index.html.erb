<div class="w-full max-w-none mx-0 py-10 px-0">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to "Home", root_path, class: "hover:text-primary transition-all" %>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "w-3 h-3" } %>
      <span class="text-white">Saved Jobs</span>
    </div>
  </div>

  <header class="mb-12 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-4xl font-black text-white mb-3 tracking-tight leading-none">My Jobs</h1>
      <p class="text-slate-500 font-bold text-sm">Jobs you've favorited or applied to.</p>
    </div>
    <div class="flex items-center gap-1 text-xs font-bold">
      <span class="text-slate-500 mr-2">Sort</span>
      <% { "newest" => "Newest", "oldest" => "Oldest" }.each do |key, label| %>
        <%= link_to label, user_job_postings_path(sort: key),
              class: "px-3 py-1.5 rounded-lg transition-all #{@sort == key ? 'bg-primary/20 text-primary border border-primary/20' : 'text-slate-500 hover:text-white border border-transparent'}" %>
      <% end %>
    </div>
  </header>

  <section class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-10" aria-label="Application funnel overview">
    <% [["Tracked", @funnel_stats[:tracked], "text-primary"],
        ["Applied", @funnel_stats[:applied], "text-accent"],
        ["Persona locked", @funnel_stats[:personas], "text-secondary"],
        ["Answers provided", @funnel_stats[:answers], "text-info"],
        ["Employer signals", @funnel_stats[:outcomes], "text-warning"]].each do |label, value, color| %>
      <div class="card-neural p-4 border-white/5">
        <div class="text-[10px] uppercase tracking-widest font-bold text-slate-500"><%= label %></div>
        <div class="text-2xl font-black <%= color %> mt-1"><%= value %></div>
      </div>
    <% end %>
  </section>

  <div class="grid grid-cols-1 gap-12">
    <div class="space-y-6">
      <h3 class="text-xs font-bold text-primary border-b border-primary/10 pb-4">Favorites</h3>
      <% if @favorites.any? %>
        <div class="hidden lg:grid grid-cols-[minmax(0,2.2fr)_minmax(0,1.35fr)_minmax(0,1.35fr)_auto] gap-6 px-6 text-[10px] uppercase tracking-widest font-black text-slate-600" aria-hidden="true">
          <span>Role</span><span>Fit &amp; logistics</span><span>Pipeline signal</span><span>Next</span>
        </div>
        <div class="space-y-4">
          <% @favorites.each do |user_job| %>
            <% job = user_job.job_posting %>
            <div class="card-neural p-6 hover:border-primary/50 transition-all group border border-white/5">
              <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1.35fr)_minmax(0,1.35fr)_auto] gap-6 items-center">
                <div class="min-w-0">
                  <div class="text-xs font-bold text-slate-500 mb-1"><%= job.company_name %></div>
                  <h4 class="text-lg font-black text-white group-hover:text-primary transition-colors truncate"><%= link_to job.title, job_posting_path(job) %></h4>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-xs font-bold">
                    <span class="text-slate-500"><%= job.location.presence || "Location unknown" %></span>
                    <% if job.data['is_remote'] %><span class="text-emerald-500">Remote eligible</span><% end %>
                    <% if job.data['salary_min'] || job.data['salary_max'] %>
                      <span class="text-amber-500"><%= number_to_currency(job.data['salary_min'], precision: 0) %>–<%= number_to_currency(job.data['salary_max'], precision: 0) %></span>
                    <% end %>
                  </div>
                </div>
                <div class="flex flex-wrap lg:flex-col gap-2 text-xs font-bold border-l border-white/5 lg:pl-5">
                  <span class="text-slate-500">Saved <%= user_job.created_at.strftime("%b %-d, %Y") %> · <%= time_ago_in_words(user_job.created_at) %> ago</span>
                  <% if user_job.match_score.present? %><span class="text-primary"><%= user_job.match_score %>% match</span><% else %><span class="text-slate-600">Match not scored</span><% end %>
                  <span class="text-slate-600"><%= job.enriched_at.present? ? "Enriched" : "Needs enrichment" %></span>
                </div>
                <div class="flex flex-wrap lg:flex-col gap-2 text-xs font-bold border-l border-white/5 lg:pl-5">
                  <span class="text-primary">Favorited · not applied</span>
                  <% if user_job.interview_prep_pack.present? %><span class="text-success">Prep pack ready</span><% end %>
                  <% if job.published_at %><span class="text-slate-500">Posted <%= time_ago_in_words(job.published_at) %> ago</span><% end %>
                </div>
                <div class="flex lg:flex-col items-start lg:items-end gap-2">
                  <%= button_to "Mark Applied", user_job_postings_path(job_posting_id: job.id, status: 'applied'), class: "btn btn-xs rounded-lg bg-emerald-900/20 text-emerald-500 border-none font-bold" %>
                  <%= button_to "Remove", user_job_posting_path(user_job), method: :delete, class: "text-rose-500 text-xs font-bold opacity-70 hover:opacity-100", title: "Remove" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-10 card-neural border-dashed opacity-60">
          <div class="text-sm font-bold">No favorites yet.</div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <h3 class="text-xs font-bold text-accent border-b border-accent/10 pb-4">Applications</h3>
      <% if @applied.any? %>
        <div class="hidden lg:grid grid-cols-[minmax(0,2.2fr)_minmax(0,1.35fr)_minmax(0,1.35fr)_auto] gap-6 px-6 text-[10px] uppercase tracking-widest font-black text-slate-600" aria-hidden="true">
          <span>Role</span><span>Fit &amp; logistics</span><span>Employer signal</span><span>Next</span>
        </div>
        <div class="space-y-4">
          <% @applied.each do |user_job| %>
            <% job = user_job.job_posting %>
            <div class="card-neural p-6 border border-accent/20">
              <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1.35fr)_minmax(0,1.35fr)_auto] gap-6 items-center">
                <div class="min-w-0">
                  <div class="text-xs font-bold text-slate-500 mb-1"><%= job.company_name %></div>
                  <h4 class="text-lg font-black text-white truncate"><%= link_to job.title, job_posting_path(job) %></h4>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="px-2 py-1 rounded bg-accent/20 text-accent text-xs font-bold border border-accent/10">Applied</span>
                <%# Employer response, kept visually distinct from the "Applied" badge above --
                    they're different facts (what he did vs. what the employer did) and
                    collapsing them would hide exactly the signal outcome tracking exists for. %>
                <% badge_class, badge_label = outcome_badge(user_job) %>
                <% if badge_label %>
                  <span class="px-2 py-1 rounded <%= badge_class %> text-xs font-bold border">
                    <%= badge_label %>
                  </span>
                <% end %>
                <% if user_job.resume_persona_id.present? %>
                  <span class="px-2 py-1 rounded bg-secondary/10 text-secondary text-xs font-bold border border-secondary/10">
                    <%= user_job.resume_persona_snapshot["label"].presence || user_job.resume_persona_id.humanize %>
                  </span>
                <% end %>
                <% if user_job.application_field_answers.any? %>
                  <span class="text-xs font-bold text-slate-500">
                    <%= user_job.application_field_answers.length %> field<%= "s" unless user_job.application_field_answers.length == 1 %> provided
                  </span>
                <% end %>
                <%# A missing applied_at is called out rather than quietly showing import time as if it were the application date. %>
                <% if user_job.applied_at %>
                  <span class="text-xs font-bold text-slate-400" title="<%= user_job.applied_at.strftime('%B %-d, %Y at %-l:%M %p') %>">
                    <%= user_job.applied_at.strftime("%b %-d, %Y") %>
                    <span class="text-slate-600">· <%= time_ago_in_words(user_job.applied_at) %> ago</span>
                  </span>
                <% else %>
                  <span class="text-xs font-bold text-slate-600" title="No application date was captured; showing when it was tracked.">
                    tracked <%= user_job.created_at.strftime("%b %-d, %Y") %>
                  </span>
                <% end %>
                  </div>
                </div>
                <div class="flex flex-wrap lg:flex-col gap-2 text-xs font-bold">
                  <span class="text-slate-500"><%= job.location.presence || "Location unknown" %></span>
                  <% if job.data['is_remote'] %><span class="text-emerald-500">Remote eligible</span><% end %>
                  <% if user_job.match_score.present? %><span class="text-primary"><%= user_job.match_score %>% match</span><% end %>
                </div>
                <div class="flex flex-wrap lg:flex-col gap-2 text-xs font-bold border-l border-white/5 lg:pl-5">
                  <span class="text-accent">Applied <%= user_job.applied_at ? time_ago_in_words(user_job.applied_at) + " ago" : "date unknown" %></span>
                  <% if user_job.outcome.present? %><span class="text-warning"><%= user_job.outcome.humanize %></span><% else %><span class="text-slate-500">Awaiting employer</span><% end %>
                  <% if user_job.interview_prep_pack.present? %><span class="text-success">Prep pack ready</span><% end %>
                </div>
                <div class="flex lg:flex-col items-start lg:items-end gap-2">
                  <%= link_to "Open posting", job_posting_path(job), class: "text-xs font-bold text-primary hover:underline" %>
                  <%= link_to "View timeline", job_posting_path(job, anchor: "pipeline"), class: "text-xs font-bold text-slate-400 hover:text-white" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-10 card-neural border-dashed opacity-60">
          <div class="text-sm font-bold">No active applications.</div>
        </div>
      <% end %>
    </div>
  </div>
</div>
