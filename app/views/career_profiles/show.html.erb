<div class="max-w-4xl mx-auto py-10 px-6">
  <div class="mb-10 text-xs font-bold opacity-60">
    <div class="flex items-center gap-3">
      <%= link_to t('.breadcrumb_home'), root_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-xs"></i>
      <span class="text-white"><%= t('.breadcrumb_current') %></span>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl font-black text-white mb-3 tracking-tight leading-none"><%= t('.title') %></h1>
      <p class="text-slate-500 font-bold text-sm"><%= t('.subtitle') %></p>
    </div>
    <div class="flex gap-4">
      <% if @career_profile.github_url.present? %>
        <%= button_to sync_github_career_profile_path, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold hover:text-blue-400 hover:border-blue-400/50" do %>
          <i class="bi bi-github mr-2"></i> <%= t('.sync_github') %>
        <% end %>
      <% end %>
      <%= button_to t('.sync_from_file'), career_profile_path(sync: true), method: :patch, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold hover:text-primary hover:border-primary/50" %>
      <%= button_to t('.rebuild_match_index'), career_profile_path(embed: true), method: :patch, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-bold hover:text-accent hover:border-accent/50" %>
      <%= link_to t('.edit_profile'), edit_career_profile_path, class: "btn btn-primary rounded-xl px-10 font-bold" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-2 space-y-8">
      <div class="card-neural p-8">
        <h3 class="text-xs font-bold text-base-content/50 pb-4 border-b border-white/5 mb-6"><%= t('.work_history_heading') %></h3>
        <div class="space-y-12">
          <% @career_profile.work_experiences.order(start_date: :desc).each do |exp| %>
            <div class="relative pl-8 border-l-2 border-white/5">
              <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-base-100 border-2 border-primary shadow-[0_0_10px_rgba(149,128,255,0.5)]"></div>

              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="text-xl font-black text-white"><%= exp.title %></h4>
                  <div class="text-sm font-bold text-primary"><%= exp.company_name %></div>
                </div>
                <div class="text-right">
                  <div class="text-xs font-bold text-slate-400">
                    <%= exp.start_date&.strftime("%b %Y") %> &mdash; <%= exp.end_date&.strftime("%b %Y") || t('.present') %>
                  </div>
                  <div class="badge badge-neutral bg-white/5 border-none text-xs font-bold mt-1">
                    <%= exp.employment_type %>
                  </div>
                </div>
              </div>

              <div class="mt-6 space-y-6">
                <div>
                  <div class="text-xs font-bold text-slate-500 mb-2"><%= t('.context_label') %></div>
                  <p class="text-sm text-base-content/70 leading-relaxed font-medium"><%= exp.context %></p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div>
                    <div class="text-xs font-bold text-slate-500 mb-2"><%= t('.action_label') %></div>
                    <p class="text-sm text-base-content/60 leading-relaxed"><%= exp.action %></p>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-slate-500 mb-2"><%= t('.impact_label') %></div>
                    <p class="text-sm text-base-content/60 leading-relaxed"><%= exp.impact %></p>
                  </div>
                </div>

                <div>
                  <div class="text-xs font-bold text-slate-500 mb-4"><%= t('.highlights_label') %></div>
                  <div class="grid grid-cols-1 gap-3">
                    <% exp.experience_highlights.each do |h| %>
                      <div class="bg-white/[0.02] p-3 rounded-lg border border-white/5 flex gap-4">
                        <span class="text-xs font-bold text-primary mt-1 whitespace-nowrap"><%= h.label %></span>
                        <p class="text-sm text-base-content/70"><%= h.text %></p>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    <div class="space-y-8">
      <div class="card-neural p-8">
        <h3 class="text-xs font-bold text-base-content/50 pb-4 border-b border-white/5 mb-6"><%= t('.summary_heading') %></h3>
        <div class="space-y-4">
          <div>
            <div class="text-xs font-bold text-slate-500 mb-1"><%= t('.tier_label') %></div>
            <div class="text-white font-bold text-lg"><%= @career_profile.experience_level || t('.not_set') %></div>
          </div>
          <div>
            <div class="text-xs font-bold text-slate-500 mb-1"><%= t('.skills_label') %></div>
            <div class="flex flex-wrap gap-2 mt-2">
              <% (@career_profile.skills || "").split(",").each do |skill| %>
                <span class="px-3 py-1 rounded bg-white/5 border border-white/5 text-xs font-bold text-slate-400"><%= skill.strip %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <% if @career_profile.github_context.present? %>
        <div class="card-neural p-8 border-l-4 border-l-blue-500 bg-blue-500/5 shadow-2xl">
          <h3 class="text-xs font-bold mb-6 flex justify-between items-center text-white/60">
            <span><%= t('.github_heading') %></span>
          </h3>

          <div class="space-y-6">
            <div class="prose-invert text-sm leading-relaxed">
              <%= markdown(@career_profile.github_context['synthesis']) %>
            </div>

            <div class="pt-4 border-t border-white/5">
              <div class="text-xs font-bold text-slate-500 mb-2"><%= t('.repos_analyzed_label') %></div>
              <div class="flex flex-wrap gap-2">
                <% Array(@career_profile.github_context['repos']).each do |repo| %>
                  <span class="px-2 py-1 rounded bg-white/5 border border-white/10 text-xs font-mono text-slate-400">
                    <%= repo['name'] %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card-neural p-8">
        <h3 class="text-xs font-bold text-base-content/50 pb-4 border-b border-white/5 mb-6"><%= t('.matching_heading') %></h3>
        <div class="text-center py-6">
          <div class="text-sm font-bold text-slate-400 leading-relaxed">
            <%= @career_profile.resume_text.present? ? t('.matching_ready') : t('.matching_not_ready') %>
          </div>
          <p class="text-xs text-slate-500 mt-4 italic"><%= t('.matching_helper') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
