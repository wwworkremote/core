<div class="max-w-4xl mx-auto py-10 px-6">
  <div class="mb-10 text-[10px] font-black uppercase tracking-[0.2em] opacity-40">
    <div class="flex items-center gap-3">
      <%= link_to "Home", root_path, class: "hover:text-primary transition-all" %>
      <i class="bi bi-chevron-right text-[8px]"></i>
      <span class="text-white">Career_Profile_Node</span>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
    <div>
      <h1 class="text-4xl font-black text-white mb-3 uppercase tracking-tight leading-none">Career Profile</h1>
      <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Leveraged by AI for deep job matching.</p>
    </div>
    <div class="flex gap-4">
      <%= button_to "SYNC_FROM_YAML", career_profile_path(sync: true), method: :patch, class: "btn btn-ghost border-white/10 rounded-xl px-10 font-black tracking-widest text-[10px] hover:text-primary hover:border-primary/50" %>
      <%= link_to "RECONFIGURE_PROFILE", edit_career_profile_path, class: "btn btn-primary rounded-xl px-10 font-black tracking-widest text-[10px]" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-2 space-y-8">
      <div class="card-neural p-8">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 pb-4 border-b border-white/5 mb-6">Career_Timeline</h3>
        <div class="space-y-12">
          <% @career_profile.work_experiences.order(start_date: :desc).each do |exp| %>
            <div class="relative pl-8 border-l-2 border-white/5">
              <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-base-100 border-2 border-primary shadow-[0_0_10px_rgba(149,128,255,0.5)]"></div>
              
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="text-xl font-black text-white uppercase tracking-tight"><%= exp.title %></h4>
                  <div class="text-sm font-bold text-primary tracking-widest uppercase"><%= exp.company_name %></div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em]">
                    <%= exp.start_date&.strftime("%b %Y") %> &mdash; <%= exp.end_date&.strftime("%b %Y") || 'PRESENT' %>
                  </div>
                  <div class="badge badge-neutral bg-white/5 border-none text-[8px] font-black uppercase tracking-widest mt-1">
                    <%= exp.employment_type %>
                  </div>
                </div>
              </div>

              <div class="mt-6 space-y-6">
                <div>
                  <div class="text-[9px] font-black uppercase text-slate-600 tracking-widest mb-2">Narrative_Context</div>
                  <p class="text-sm text-base-content/70 leading-relaxed font-medium"><%= exp.context %></p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div>
                    <div class="text-[9px] font-black uppercase text-slate-600 tracking-widest mb-2">Strategy_Action</div>
                    <p class="text-[11px] text-base-content/60 leading-relaxed"><%= exp.action %></p>
                  </div>
                  <div>
                    <div class="text-[9px] font-black uppercase text-slate-600 tracking-widest mb-2">Business_Impact</div>
                    <p class="text-[11px] text-base-content/60 leading-relaxed"><%= exp.impact %></p>
                  </div>
                </div>

                <div>
                  <div class="text-[9px] font-black uppercase text-slate-600 tracking-widest mb-4">Impact_Highlights</div>
                  <div class="grid grid-cols-1 gap-3">
                    <% exp.experience_highlights.each do |h| %>
                      <div class="bg-white/[0.02] p-3 rounded-lg border border-white/5 flex gap-4">
                        <span class="text-[8px] font-black text-primary uppercase tracking-tighter mt-1 whitespace-nowrap"><%= h.label %></span>
                        <p class="text-[11px] text-base-content/70"><%= h.text %></p>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    <div class="space-y-8">
      <div class="card-neural p-8">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 pb-4 border-b border-white/5 mb-6">Identity_Metrics</h3>
        <div class="space-y-4">
          <div>
            <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20 mb-1 text-slate-500">Tier</div>
            <div class="text-white font-bold text-lg uppercase"><%= @career_profile.experience_level || "UNDEFINED" %></div>
          </div>
          <div>
            <div class="text-[9px] font-black uppercase tracking-widest text-base-content/20 mb-1 text-slate-500">Neural_Skills</div>
            <div class="flex flex-wrap gap-2 mt-2">
              <% (@career_profile.skills || "").split(",").each do |skill| %>
                <span class="px-3 py-1 rounded bg-white/5 border border-white/5 text-[9px] font-black text-slate-400 uppercase tracking-widest"><%= skill.strip %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="card-neural p-8">
        <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-base-content/30 pb-4 border-b border-white/5 mb-6">Match_Intelligence</h3>
        <div class="text-center py-6">
          <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest leading-relaxed">
            AI_READY: <%= @career_profile.resume_text.present? ? "TRUE" : "FALSE" %>
          </div>
          <p class="text-[9px] text-slate-600 mt-4 italic">Your profile will be used to generate personalized match scores on job detail pages.</p>
        </div>
      </div>
    </div>
  </div>
</div>
