<div class="flex flex-col h-full p-4">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold text-gray-900">Job Locations Distribution</h3>
  </div>

  <div class="flex-grow">
    <%
      # Aggregate postings by location for the map
      # We'll use the location string for Chartkick's geo_chart
      location_data = JobPosting.where.not(location: nil).group(:location).count
    %>

    <% if location_data.any? %>
      <%= geo_chart location_data, height: "100%", library: { backgroundColor: "transparent" } %>
    <% else %>
      <div class="flex items-center justify-center h-full text-gray-500 italic">
        No location data available yet.
      </div>
    <% end %>
  </div>
</div>
