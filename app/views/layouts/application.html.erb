<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Gemini Core | Job Intelligence</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gemini-bg text-slate-50 min-h-screen relative overflow-x-hidden pt-24 font-sans antialiased">
    <div class="gemini-mesh"></div>

    <nav class="fixed top-4 left-4 right-4 z-50 glass rounded-2xl px-6 py-4 flex items-center justify-between mx-auto max-w-7xl">
      <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-extrabold tracking-tighter bg-gradient-to-r from-violet-400 to-blue-400 bg-clip-text text-transparent">
          Gemini Core
        </a>
        
        <div class="hidden md:flex items-center gap-1">
          <%= link_to 'Dashboard', root_path, class: "px-4 py-2 text-sm font-medium transition-colors hover:text-violet-400" %>
          <%= link_to 'Job Market', job_postings_path, class: "px-4 py-2 text-sm font-medium transition-colors hover:text-violet-400" %>
          <%= link_to 'Neural Dialogues', llm_chats_path, class: "px-4 py-2 text-sm font-medium transition-colors hover:text-violet-400" %>
          <%= link_to 'Model Registry', models_path, class: "px-4 py-2 text-sm font-medium transition-colors hover:text-violet-400" %>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <!-- System Dropdown via simple Stimulus or Hover -->
        <div class="relative group" data-controller="dropdown">
          <button class="px-4 py-2 text-sm font-medium flex items-center gap-2 transition-colors hover:text-violet-400">
            System <i class="bi bi-chevron-down text-[10px]"></i>
          </button>
          <div class="absolute right-0 top-full mt-2 w-56 glass rounded-xl overflow-hidden shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all transform origin-top-right scale-95 group-hover:scale-100">
            <div class="py-2">
              <%= link_to data_fetchers_path, class: "flex items-center px-4 py-3 text-sm hover:bg-white/5 transition-colors gap-3" do %>
                <i class="bi bi-cloud-download opacity-50"></i> Data Fetchers
              <% end %>
              <%= link_to '/jobs', class: "flex items-center px-4 py-3 text-sm hover:bg-white/5 transition-colors gap-3" do %>
                <i class="bi bi-activity opacity-50"></i> Background Jobs
              <% end %>
              <div class="border-t border-white/5 my-1"></div>
              <%= link_to avo_path, class: "flex items-center px-4 py-3 text-sm hover:bg-white/5 transition-colors gap-3" do %>
                <i class="bi bi-shield-lock opacity-50"></i> Admin (Avo)
              <% end %>
              <%= link_to '/pghero', class: "flex items-center px-4 py-3 text-sm hover:bg-white/5 transition-colors gap-3" do %>
                <i class="bi bi-database opacity-50"></i> PgHero
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 md:px-8 animate-fade-in pb-20">
      <% if notice.present? %>
        <div class="mb-8 p-4 glass rounded-2xl border-emerald-500/20 text-emerald-300 text-sm flex items-center gap-3">
          <i class="bi bi-check-circle-fill text-lg"></i> <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-8 p-4 glass rounded-2xl border-rose-500/20 text-rose-300 text-sm flex items-center gap-3">
          <i class="bi bi-exclamation-triangle-fill text-lg"></i> <%= alert %>
        </div>
      <% end %>

      <%= yield %>

      <footer class="mt-20 pt-10 border-t border-white/5 text-center text-slate-500 text-sm">
        <p class="mb-2">Refined with precision by <span class="text-violet-400 font-semibold italic">Gemini AI Agent</span></p>
        <p class="opacity-40">&copy; <%= Time.current.year %> WWWorkRemote. All rights reserved.</p>
      </footer>
    </main>
  </body>
</html>
