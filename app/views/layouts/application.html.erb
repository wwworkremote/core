<!DOCTYPE html>
<html lang="en" data-theme="dracula">
  <head>
    <title>WWWorkRemote | Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-300 font-sans antialiased selection:bg-primary selection:text-primary-content">
    <div class="gemini-mesh"></div>

    <div class="drawer lg:drawer-open">
      <input id="admin-drawer" type="checkbox" class="drawer-toggle" />
      
      <div class="drawer-content flex flex-col">
        <!-- Navbar (Top Header) -->
        <header class="navbar bg-base-100/50 backdrop-blur-lg border-b border-white/5 px-4 sticky top-0 z-30 min-h-[64px]">
          <div class="flex-none lg:hidden">
            <label for="admin-drawer" class="btn btn-square btn-ghost">
              <%= heroicon "bars-3", options: { class: "w-6 h-6" } %>
            </label>
          </div>
          
          <div class="flex-1 px-2">
            <div class="text-xs breadcrumbs p-0 opacity-50 font-bold uppercase tracking-widest">
              <ul>
                <li>System</li>
                <li><%= controller_name.humanize %></li>
              </ul>
            </div>
          </div>

          <div class="flex-none gap-2">
            <!-- Global Audit Trigger -->
            <%= button_to audit_data_fetchers_path, method: :post, class: "btn btn-ghost btn-sm gap-2 text-[10px] font-black tracking-widest", data: { turbo_confirm: "Run full system audit?" } do %>
              <%= heroicon "shield-check", options: { class: "w-4 h-4 text-primary" } %>
              <span class="hidden md:inline">AUDIT_REPAIR</span>
            <% end %>
          </div>
        </header>

        <!-- Main Content Viewport -->
        <main class="p-6 lg:p-10 animate-fade-in max-w-[1600px]">
          <% if notice.present? %>
            <div class="alert alert-success shadow-xl mb-8 border border-success/10 bg-success/5 text-success text-xs font-bold py-3">
              <%= heroicon "check-circle", variant: :solid, options: { class: "w-4 h-4" } %>
              <span><%= notice %></span>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>

      <!-- Sidebar (Drawer) -->
      <aside class="drawer-side z-40">
        <label for="admin-drawer" class="drawer-overlay"></label>
        <div class="bg-base-200 text-base-content w-64 min-h-full border-r border-white/5 flex flex-col">
          <!-- Branding -->
          <div class="px-6 py-8 flex items-center gap-3">
            <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-primary-content font-black">W</div>
            <span class="text-lg font-black tracking-tighter uppercase">WWWork<span class="text-primary">Remote</span></span>
          </div>

          <!-- Navigation Menu -->
          <nav class="flex-1 px-4 space-y-8">
            <div>
              <h2 class="px-2 text-[10px] font-black text-base-content/30 uppercase tracking-[0.2em] mb-4">Core_Aggregator</h2>
              <ul class="menu menu-sm p-0 gap-1">
                <li><%= link_to root_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if current_page?(root_path)}" do %>
                  <%= heroicon "squares-2x2", options: { class: "w-5 h-5" } %> Dashboard
                <% end %></li>
                <li><%= link_to job_postings_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if controller_name == 'job_postings'}" do %>
                  <%= heroicon "briefcase", options: { class: "w-5 h-5" } %> Job Market
                <% end %></li>
              </ul>
            </div>

            <div>
              <h2 class="px-2 text-[10px] font-black text-base-content/30 uppercase tracking-[0.2em] mb-4">Neural_Engine</h2>
              <ul class="menu menu-sm p-0 gap-1">
                <li><%= link_to llm_chats_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if controller_name == 'llm_chats'}" do %>
                  <%= heroicon "chat-bubble-left-right", options: { class: "w-5 h-5" } %> Neural Dialogues
                <% end %></li>
                <li><%= link_to models_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if controller_name == 'models'}" do %>
                  <%= heroicon "cpu-chip", options: { class: "w-5 h-5" } %> Model Registry
                <% end %></li>
              </ul>
            </div>

            <div>
              <h2 class="px-2 text-[10px] font-black text-base-content/30 uppercase tracking-[0.2em] mb-4">System_Control</h2>
              <ul class="menu menu-sm p-0 gap-1">
                <li><%= link_to data_fetchers_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if controller_name == 'data_fetchers'}" do %>
                  <%= heroicon "arrow-path", options: { class: "w-5 h-5" } %> Data Fetchers
                <% end %></li>
                <li><%= link_to '/jobs', class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl" do %>
                  <%= heroicon "bolt", options: { class: "w-5 h-5" } %> Background Jobs
                <% end %></li>
                <li><%= link_to admin_root_path, class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl #{'active' if params[:controller].start_with?('admin/')}" do %>
                  <%= heroicon "shield-check", options: { class: "w-5 h-5" } %> Admin (CRUD)
                <% end %></li>
                <li><%= link_to '/pghero', class: "flex items-center gap-3 py-2.5 hover:bg-primary/10 hover:text-primary transition-colors font-bold rounded-xl" do %>
                  <%= heroicon "server", options: { class: "w-5 h-5" } %> PgHero Monitor
                <% end %></li>
              </ul>
            </div>
          </nav>

          <!-- Footer -->
          <div class="p-6 border-t border-white/5">
            <div class="flex items-center gap-3 mb-2">
              <div class="badge badge-success badge-xs"></div>
              <span class="text-[9px] font-black uppercase tracking-widest text-base-content/40">v1.4.0-stable</span>
            </div>
            <p class="text-[9px] font-bold text-base-content/30 uppercase tracking-tighter">Synthesized by Gemini Agent</p>
          </div>
        </div>
      </aside>
    </div>
  </body>
</html>
