<!DOCTYPE html>
<html lang="en" data-theme="dracula" class="bg-base-100">
  <head>
    <title>WWWorkRemote | Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1/dist/chartjs-adapter-luxon.umd.min.js"></script>
    <%= javascript_importmap_tags %>
    <% if Rails.env.development? %>
      <script>document.write('<script src="http://' + (location.host || 'localhost').split(':')[0] + ':35729/livereload.js?snipver=1"></' + 'script>')</script>
    <% end %>
  </head>

  <body class="min-h-screen">
    <header class="navbar bg-base-200 border-b border-white/5 px-6 py-4 sticky top-0 z-50">
      <div class="flex-1">
        <a href="/" class="text-xl font-black tracking-tighter uppercase">
          WWWork<span class="text-primary">Remote</span>
        </a>
      </div>
      
      <div class="flex-none">
        <ul class="menu menu-horizontal px-1 gap-2 font-bold uppercase tracking-widest text-[10px]">
          <li><%= link_to 'Dashboard', root_path %></li>
          <li><%= link_to 'Market', job_postings_path %></li>
          <li><%= link_to 'My Jobs', user_job_postings_path %></li>
          <li><%= link_to 'Profile', career_profile_path %></li>
          
          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded">AI Lab</div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-4 border border-white/5">
              <li><%= link_to 'Dialogues', llm_chats_path %></li>
              <li><%= link_to 'Models', models_path %></li>
            </ul>
          </li>
          
          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded text-primary">Mission</div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-4 border border-white/5">
              <li><%= link_to 'Mission Control', admin_tasks_path %></li>
            </ul>
          </li>
          
          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded">Control</div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-4 border border-white/5">
              <li><%= link_to 'Pipeline Intel', admin_observability_path %></li>
              <li><%= link_to 'Background Pipeline', admin_jobs_path %></li>
              <li><%= link_to 'Data Fetchers', data_fetchers_path %></li>
              <li><%= link_to 'Companies', admin_companies_path %></li>
              <li><%= link_to 'Admin Registry', admin_root_path %></li>
              <li><%= link_to 'PgHero', '/pghero' %></li>
            </ul>
          </li>
        </ul>
      </div>
    </header>

    <main class="container mx-auto max-w-[1400px] px-6 py-12">
      <% if notice.present? %>
        <div class="alert alert-success rounded-xl mb-10 shadow-lg font-bold text-xs uppercase tracking-widest">
          <%= heroicon "check-circle", variant: :solid, options: { class: "w-4 h-4" } %>
          <span><%= notice %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer p-10 bg-base-200 text-base-content border-t border-white/5">
      <nav>
        <h6 class="footer-title text-white opacity-40 uppercase tracking-[0.2em] font-black text-[9px]">Operational Intelligence</h6>
        <%= link_to 'Project Genesis (About)', about_path, class: "link link-hover text-xs font-bold text-slate-400" %>
        <%= link_to 'Source Code (GitHub)', 'https://github.com/wwworkremote/core', class: "link link-hover text-xs font-bold text-slate-400", target: "_blank" %>
        <%= link_to 'Primary Node (just3ws.com)', 'https://www.just3ws.com', class: "link link-hover text-xs font-bold text-slate-400", target: "_blank" %>
      </nav>
      <nav>
        <h6 class="footer-title text-white opacity-40 uppercase tracking-[0.2em] font-black text-[9px]">Partner Projects</h6>
        <%= link_to 'Phalanx Duel', 'https://phalanxduel.com', class: "link link-hover text-xs font-bold text-primary italic", target: "_blank" %>
      </nav>
      <aside class="md:justify-self-end">
        <p class="font-black uppercase tracking-tighter text-xl text-right">WWWork<span class="text-primary">Remote</span></p>
        <p class="text-[10px] opacity-20 text-right uppercase tracking-widest font-bold">
          &copy; <%= Time.current.year %> &mdash; The Autonomous Remote Job Synthesis Engine
        </p>
      </aside>
    </footer>
  </body>
</html>
