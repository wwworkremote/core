<!DOCTYPE html>
<html lang="en">
  <head>
    <title>WwworkRemote | Core</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="gemini-mesh"></div>

    <nav class="navbar navbar-expand-lg fixed-top navbar-dark glass">
      <div class="container-fluid">
        <a href="/" class="navbar-brand fs-3">Gemini Core</a>
        
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><%= link_to 'Dashboard', root_path, class: 'nav-link px-3' %></li>
            <li class="nav-item"><%= link_to 'Job Postings', job_postings_path, class: 'nav-link px-3' %></li>
            <li class="nav-item"><%= link_to 'AI Chat', llm_chats_path, class: 'nav-link px-3' %></li>
            <li class="nav-item"><%= link_to 'Models', models_path, class: 'nav-link px-3' %></li>
            
            <li class="nav-item dropdown px-3">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                System
              </a>
              <ul class="dropdown-menu dropdown-menu-end glass border-0 shadow-lg mt-2">
                <li><%= link_to 'Data Fetchers', data_fetchers_path, class: 'dropdown-item text-white' %></li>
                <li><%= link_to 'Background Jobs', '/jobs', class: 'dropdown-item text-white' %></li>
                <li><hr class="dropdown-divider opacity-10"></li>
                <li><%= link_to 'Admin (Avo)', avo_path, class: 'dropdown-item text-white' %></li>
                <li><%= link_to 'PgHero', '/pghero', class: 'dropdown-item text-white' %></li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container fade-in">
      <% if notice.present? %>
        <div class="alert alert-success glass border-0 text-white mb-4"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger glass border-0 text-white mb-4"><%= alert %></div>
      <% end %>

      <%= yield %>

      <footer class="gemini-footer">
        <p>Architected with precision by <span class="signature">Gemini AI Agent</span></p>
        <p class="small opacity-50">&copy; <%= Time.current.year %> WWWorkRemote. All rights reserved.</p>
      </footer>
    </main>
  </body>
</html>
