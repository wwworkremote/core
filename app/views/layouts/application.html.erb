<!DOCTYPE html>
<html lang="en" data-theme="dark" class="bg-base-100">
  <head>
    <title>WWWorkRemote | Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1/dist/chartjs-adapter-luxon.umd.min.js"></script>
    <%= javascript_importmap_tags %>
    <% unless Rails.env.test? %>
      <script>window.ahoyTrackInteractions = true</script>
    <% end %>
    <% if Rails.env.development? %>
      <script>document.write('<script src="http://' + (location.host || 'localhost').split(':')[0] + ':35729/livereload.js?snipver=1"></' + 'script>')</script>
    <% end %>
  </head>

  <body class="min-h-screen">
    <header class="navbar bg-base-200 border-b border-white/5 px-6 py-4 sticky top-0 z-50">
      <div class="flex-1">
        <a href="/" class="text-xl font-black tracking-tighter uppercase">
          WWWork<span class="text-primary">Remote</span>
        </a>
      </div>

      <div class="flex-none">
        <ul class="menu menu-horizontal px-1 gap-2 font-bold text-sm">
          <li><%= link_to t('.nav.dashboard'), root_path %></li>
          <li><%= link_to t('.nav.companies'), companies_path %></li>
          <li><%= link_to t('.nav.job_postings'), job_postings_path %></li>
          <li><%= link_to t('.nav.triage'), job_posting_triage_path %></li>
          <li><%= link_to t('.nav.saved_jobs'), user_job_postings_path %></li>

          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded text-primary"><%= t('.nav.profile_menu') %></div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-52 mt-4 border border-white/5">
              <li><%= link_to t('.nav.career_profile'), career_profile_path %></li>
              <li><%= link_to t('.nav.resume_versions'), resumes_path %></li>
              <li><%= link_to t('.nav.saved_searches'), job_searches_path %></li>
              <li><%= link_to t('.nav.ai_chats'), llm_chats_path %></li>
              <li><%= link_to t('.nav.ai_models'), models_path %></li>
            </ul>
          </li>

          <li class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded"><%= t('.nav.admin_menu') %></div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-300 rounded-box w-64 mt-4 border border-white/5">
              <li class="menu-title text-xs opacity-60"><%= t('.nav.admin_section_label') %></li>
              <li><%= link_to t('.nav.admin_dashboard'), admin_root_path %></li>
              <li><%= link_to t('.nav.system_health'), admin_observability_path %></li>
              <li><%= link_to t('.nav.background_jobs'), admin_jobs_path %></li>
              <li><%= link_to t('.nav.data_sources'), data_fetchers_path %></li>
              <div class="divider my-1 opacity-10"></div>
              <li class="menu-title text-xs opacity-60"><%= t('.nav.tools_section_label') %></li>
              <li><%= link_to t('.nav.pghero'), '/mounts/pghero' %></li>
              <li><%= link_to t('.nav.job_queue'), '/mounts/jobs' %></li>
              <li><%= link_to t('.nav.analytics'), '/mounts/analytics' %></li>
            </ul>
          </li>
        </ul>
      </div>
    </header>

    <main class="container mx-auto max-w-[1400px] px-6 py-12">
      <% if notice.present? %>
        <div class="alert alert-success rounded-xl mb-10 shadow-lg font-bold text-xs uppercase tracking-widest">
          <%= heroicon "check-circle", variant: :solid, options: { class: "w-4 h-4" } %>
          <span><%= notice %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer p-10 bg-base-200 text-base-content border-t border-white/5">
      <nav>
        <h6 class="footer-title text-white opacity-60 text-xs font-bold"><%= t('.footer.links_heading') %></h6>
        <%= link_to t('.footer.about'), about_path, class: "link link-hover text-xs font-bold text-slate-400" %>
        <%= link_to t('.footer.source_code'), 'https://github.com/wwworkremote/core', class: "link link-hover text-xs font-bold text-slate-400", target: "_blank" %>
        <%= link_to 'just3ws.com', 'https://www.just3ws.com', class: "link link-hover text-xs font-bold text-slate-400", target: "_blank" %>
      </nav>
      <nav>
        <h6 class="footer-title text-white opacity-60 text-xs font-bold"><%= t('.footer.also_built_heading') %></h6>
        <%= link_to 'Phalanx Duel', 'https://phalanxduel.com', class: "link link-hover text-xs font-bold text-primary", target: "_blank" %>
      </nav>
      <aside class="md:justify-self-end">
        <p class="font-black uppercase tracking-tighter text-xl text-right">WWWork<span class="text-primary">Remote</span></p>
        <p class="text-xs opacity-50 text-right font-bold">
          &copy; <%= Time.current.year %> &mdash; <%= t('.footer.tagline') %>
        </p>
      </aside>
    </footer>
  </body>
</html>
