<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Gemini Core | System Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gemini-bg text-slate-400 min-h-screen relative overflow-x-hidden pt-16 font-sans antialiased text-sm">
    <div class="gemini-mesh"></div>

    <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-white/5 px-6 py-2 flex items-center justify-between">
      <div class="flex items-center gap-10">
        <a href="/" class="text-lg font-black tracking-tighter text-white hover:text-violet-400 transition-colors">
          GEMINI<span class="text-violet-500">CORE</span>
        </a>
        
        <div class="hidden md:flex items-center gap-2">
          <%= link_to 'Dashboard', root_path, class: "px-3 py-1.5 rounded-md hover:bg-white/5 transition-colors font-semibold text-slate-300" %>
          <%= link_to 'Job Market', job_postings_path, class: "px-3 py-1.5 rounded-md hover:bg-white/5 transition-colors font-semibold text-slate-300" %>
          <%= link_to 'Neural Dialogues', llm_chats_path, class: "px-3 py-1.5 rounded-md hover:bg-white/5 transition-colors font-semibold text-slate-300" %>
          <%= link_to 'Model Registry', models_path, class: "px-3 py-1.5 rounded-md hover:bg-white/5 transition-colors font-semibold text-slate-300" %>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="relative group">
          <button class="px-3 py-1.5 rounded-md bg-white/5 border border-white/10 hover:border-violet-500/50 transition-all font-bold text-xs uppercase tracking-widest text-slate-300 flex items-center gap-2">
            System <i class="bi bi-chevron-down text-[10px]"></i>
          </button>
          <div class="absolute right-0 top-full mt-1 w-52 glass rounded-lg overflow-hidden shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all py-1">
            <%= link_to data_fetchers_path, class: "flex items-center px-4 py-2 hover:bg-violet-500/10 transition-colors gap-3 text-xs font-bold uppercase tracking-wider text-slate-300" do %>
              <i class="bi bi-cloud-download opacity-50"></i> Data Fetchers
            <% end %>
            <%= link_to '/jobs', class: "flex items-center px-4 py-2 hover:bg-violet-500/10 transition-colors gap-3 text-xs font-bold uppercase tracking-wider text-slate-300" do %>
              <i class="bi bi-activity opacity-50"></i> Background Jobs
            <% end %>
            <div class="border-t border-white/5 my-1"></div>
            <%= link_to avo_path, class: "flex items-center px-4 py-2 hover:bg-violet-500/10 transition-colors gap-3 text-xs font-bold uppercase tracking-wider text-slate-300" do %>
              <i class="bi bi-shield-lock opacity-50"></i> Admin (Avo)
            <% end %>
            <%= link_to '/pghero', class: "flex items-center px-4 py-2 hover:bg-violet-500/10 transition-colors gap-3 text-xs font-bold uppercase tracking-wider text-slate-300" do %>
              <i class="bi bi-database opacity-50"></i> PgHero
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-[1600px] mx-auto px-6 animate-fade-in pb-10">
      <% if notice.present? %>
        <div class="mb-6 p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-lg text-emerald-400 text-xs font-bold flex items-center gap-3">
          <i class="bi bi-check-circle-fill"></i> <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 p-3 bg-rose-500/10 border border-rose-500/20 rounded-lg text-rose-400 text-xs font-bold flex items-center gap-3">
          <i class="bi bi-exclamation-triangle-fill"></i> <%= alert %>
        </div>
      <% end %>

      <%= yield %>

      <footer class="mt-20 pt-8 border-t border-white/5 flex justify-between items-center text-[10px] font-bold uppercase tracking-[0.2em] text-slate-600">
        <div>Refined by <span class="text-violet-500/50">Gemini AI Agent</span></div>
        <div class="opacity-40">&copy; <%= Time.current.year %> WWWorkRemote. Intelligence Aggregator.</div>
      </footer>
    </main>
  </body>
</html>
