<!DOCTYPE html>
<html lang="en" data-theme="dracula">
  <head>
    <title>WWWorkRemote | Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen font-sans antialiased text-sm">
    <div class="gemini-mesh"></div>

    <!-- DaisyUI Navbar -->
    <div class="fixed top-0 left-0 right-0 z-50 px-6 pt-4">
      <div class="navbar bg-base-100/80 backdrop-blur-md border border-white/5 rounded-2xl shadow-xl max-w-[1600px] mx-auto">
        <div class="navbar-start">
          <a href="/" class="btn btn-ghost text-xl font-black tracking-tighter normal-case">
            WWWork<span class="text-primary">Remote</span>
          </a>
        </div>
        
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1 gap-1">
            <li><%= link_to 'Dashboard', root_path, class: "font-bold uppercase tracking-wider text-[11px]" %></li>
            <li><%= link_to 'Job Market', job_postings_path, class: "font-bold uppercase tracking-wider text-[11px]" %></li>
            <li><%= link_to 'Neural Dialogues', llm_chats_path, class: "font-bold uppercase tracking-wider text-[11px]" %></li>
            <li><%= link_to 'Model Registry', models_path, class: "font-bold uppercase tracking-wider text-[11px]" %></li>
          </ul>
        </div>

        <div class="navbar-end gap-2">
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-sm rounded-lg flex items-center gap-2 uppercase tracking-widest text-[10px] font-black">
              System <%= heroicon "chevron-down", variant: :outline, options: { class: "w-3 h-3" } %>
            </label>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow-2xl bg-base-200 rounded-xl w-52 border border-white/5">
              <li><%= link_to data_fetchers_path do %><%= heroicon "cloud-arrow-down", options: { class: "w-4 h-4" } %> Data Fetchers<% end %></li>
              <li><%= link_to '/jobs' do %><%= heroicon "bolt", options: { class: "w-4 h-4" } %> Background Jobs<% end %></li>
              <div class="divider my-1 opacity-10"></div>
              <li><%= link_to admin_root_path do %><%= heroicon "shield-check", options: { class: "w-4 h-4" } %> Admin<% end %></li>
              <li><%= link_to '/pghero' do %><%= heroicon "server", options: { class: "w-4 h-4" } %> PgHero<% end %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <main class="max-w-[1600px] mx-auto px-10 animate-fade-in pb-12 pt-28">
      <% if notice.present? %>
        <div class="alert alert-success shadow-lg mb-8 border border-success/20">
          <%= heroicon "check-circle", variant: :solid, options: { class: "w-5 h-5" } %>
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-error shadow-lg mb-8 border border-error/20">
          <%= heroicon "exclamation-triangle", variant: :solid, options: { class: "w-5 h-5" } %>
          <span><%= alert %></span>
        </div>
      <% end %>

      <%= yield %>

      <footer class="mt-20 pt-10 border-t border-white/5 flex justify-between items-center text-[10px] font-black uppercase tracking-[0.3em] text-base-content/40">
        <div>Refined by <span class="text-primary">Gemini AI Agent</span></div>
        <div>&copy; <%= Time.current.year %> WWWorkRemote. Intelligence Aggregator.</div>
      </footer>
    </main>
  </body>
</html>
