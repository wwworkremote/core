#!/bin/bash

# Ensure we are in the project root (where docker-compose.yml is)
cd "$(dirname "$0")/.."

echo "--- Starting Hacker News Job Fetch ---"

# We use a heredoc to keep the Ruby code clean and avoid shell quoting hell
docker-compose exec -T web bin/rails runner - <<'EOF'
  # 1. Fetch from HN API into raw JobBoards::Document
  puts "Phase 1: Fetching raw data from Hacker News API..."
  source = JobBoards::Source.find_or_create_by!(slug: "hackernews", name: "Hacker News")
  JobBoards::Query.find_or_create_by!(source_id: source.id)
  load "exe/hackernews"

  # 2. Sync raw documents to the Dashboard's JobPosting model
  puts "Phase 2: Syncing raw data to Dashboard models..."
  origin = Origin.find_or_create_by!(name: "Hacker News")
  dashboard_source = Source.find_or_create_by!(signature: "hn-default") { |s| s.origin = origin }
  
  new_count = 0
  JobBoards::Document.find_each do |doc|
    data = JSON.parse(doc.document)
    posting = JobPosting.find_or_initialize_by(signature: doc.signature)
    if posting.new_record?
      posting.assign_attributes(
        title: data["title"],
        body: data["text"],
        target_url: data["url"],
        published_at: Time.at(data["time"]),
        company: data["by"],
        source_id: dashboard_source.id,
        data: data
      )
      posting.save!
      new_count += 1
    end
  end
  puts "Done! Synced #{new_count} new postings (Total: #{JobPosting.count})"
EOF

echo "--- Fetch and Sync Complete ---"
